#include <winver.h>

1 ICON "@D012_ICON_PATH@"

// What Windows shows for the program (Task Manager's Apps list, file properties).
1 VERSIONINFO
FILEVERSION @D012_VERSION_COMMA@
PRODUCTVERSION @D012_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LiinkPK"
            VALUE "FileDescription", "Dissidia 012 Final Fantasy HD Remastered"
            VALUE "FileVersion", "@D012_VERSION_TEXT@"
            VALUE "InternalName", "Dissidia 012 Final Fantasy HD Remastered"
            VALUE "OriginalFilename", "d012_native.exe"
            VALUE "ProductName", "Dissidia 012 Final Fantasy HD Remastered"
            VALUE "ProductVersion", "@D012_VERSION_TEXT@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
