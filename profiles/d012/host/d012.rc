#include <winver.h>

1 ICON "d012.ico"

// What Windows shows for the program (Task Manager's Apps list, file properties).
1 VERSIONINFO
FILEVERSION 0,20,0,0
PRODUCTVERSION 0,20,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PSPRecomp"
            VALUE "FileDescription", "Dissidia 012 Final Fantasy HD Remastered"
            VALUE "FileVersion", "0.20.0.0"
            VALUE "InternalName", "Dissidia 012 Final Fantasy HD Remastered"
            VALUE "OriginalFilename", "d012_native.exe"
            VALUE "ProductName", "Dissidia 012 Final Fantasy HD Remastered"
            VALUE "ProductVersion", "0.20.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
