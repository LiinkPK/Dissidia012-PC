From d9b7f88e8eef8fe58d63ee91f2370590b5ec28d3 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Wed, 18 Nov 2026 11:52:22 +0100
Subject: [PATCH] Start: a build compiled for AVX says so on a CPU without it
 instead of ending with no message

The Windows build is compiled with /arch:AVX by default. On a CPU or operating system without AVX the first AVX instruction ends
the program with no message. main() now asks the CPU first and, when it cannot run the build, says so (a message box on Windows).
---
 host/main.cpp             | 22 ++++++++++++++
 host/perf/frame_stats.cpp | 62 ++++++++++++++++++++++++++++-----------
 host/perf/frame_stats.hpp |  5 ++++
 3 files changed, 72 insertions(+), 17 deletions(-)

diff --git a/host/main.cpp b/host/main.cpp
index f90612b..68f0faa 100644
--- a/host/main.cpp
+++ b/host/main.cpp
@@ -1,5 +1,6 @@
 #include "profile.hpp"
 #include "system.hpp"
+#include "perf/frame_stats.hpp"
 
 #include "app_paths.hpp"
 #include "corpus_library.hpp"
@@ -332,6 +333,27 @@ int main(int argc, char **argv) {
 #endif
 #if defined(__linux__) && !defined(PORTABLEKIT_ANDROID_APP)
     ensure_main_stack(argv);
+#endif
+    // A build compiled for AVX ends with no message at all on a CPU without it: say so first.
+#if defined(__AVX2__) || defined(__AVX__)
+    {
+        const bool needs_avx2 =
+#if defined(__AVX2__)
+            true;
+#else
+            false;
+#endif
+        if (!portablekit::perf::cpu_has_avx() || (needs_avx2 && !portablekit::perf::cpu_has_avx2())) {
+            const std::string message = std::string(portablekit::game().project_name) + " needs a CPU with " +
+                                        (needs_avx2 ? "AVX2" : "AVX") + ", and this one does not have it (or the operating system does not "
+                                        "enable it). Use a build made for older CPUs.";
+            std::cerr << message << std::endl;
+#if defined(_WIN32)
+            MessageBoxA(nullptr, message.c_str(), "Unsupported CPU", MB_OK | MB_ICONERROR);
+#endif
+            return 1;
+        }
+    }
 #endif
     try {
         if (argc > 1 && std::string(argv[1]) == "--adhoc-server") return run_adhoc_server(argc, argv);
diff --git a/host/perf/frame_stats.cpp b/host/perf/frame_stats.cpp
index 8dcf6d9..572b592 100644
--- a/host/perf/frame_stats.cpp
+++ b/host/perf/frame_stats.cpp
@@ -600,6 +600,31 @@ std::string cpu_brand() {
     return first == std::string::npos ? std::string("unknown CPU") : brand.substr(first);
 }
 
+// AVX and AVX2 need the operating system to save the wide registers too (XGETBV), not only the CPU to have them.
+bool avx_usable() {
+    unsigned regs[4]{};
+    cpu_id(1u, 0u, regs);
+    if ((regs[2] & (1u << 27)) == 0u || (regs[2] & (1u << 28)) == 0u) return false;
+#if defined(_MSC_VER)
+    return (_xgetbv(0) & 6u) == 6u;
+#elif defined(__GNUC__)
+    unsigned low = 0, high = 0;
+    __asm__ volatile("xgetbv" : "=a"(low), "=d"(high) : "c"(0));
+    return (low & 6u) == 6u;
+#else
+    return false;
+#endif
+}
+
+bool avx2_usable() {
+    unsigned regs[4]{};
+    cpu_id(0u, 0u, regs);
+    if (regs[0] < 7u || !avx_usable()) return false;
+    unsigned seven[4]{};
+    cpu_id(7u, 0u, seven);
+    return (seven[1] & (1u << 5)) != 0u;
+}
+
 std::string cpu_features() {
     unsigned regs[4]{};
     cpu_id(0u, 0u, regs);
@@ -607,29 +632,16 @@ std::string cpu_features() {
     std::string out;
     const auto add = [&](bool on, const char *name) { out += std::string(out.empty() ? "" : " ") + (on ? "" : "no-") + name; };
     cpu_id(1u, 0u, regs);
-    const bool osxsave = (regs[2] & (1u << 27)) != 0u;
     add((regs[2] & (1u << 20)) != 0u, "SSE4.2");
-    // AVX and AVX2 need the operating system to save the wide registers too (XGETBV), not only the CPU to have them.
-    bool avx_usable = false;
-#if defined(_MSC_VER)
-    if (osxsave && (regs[2] & (1u << 28)) != 0u) avx_usable = (_xgetbv(0) & 6u) == 6u;
-#elif defined(__GNUC__)
-    if (osxsave && (regs[2] & (1u << 28)) != 0u) {
-        unsigned low = 0, high = 0;
-        __asm__ volatile("xgetbv" : "=a"(low), "=d"(high) : "c"(0));
-        avx_usable = (low & 6u) == 6u;
-    }
-#endif
-    add(avx_usable, "AVX");
-    add(avx_usable && (regs[2] & (1u << 12)) != 0u, "FMA");
-    bool avx2 = false, bmi2 = false;
+    add(avx_usable(), "AVX");
+    add(avx_usable() && (regs[2] & (1u << 12)) != 0u, "FMA");
+    bool bmi2 = false;
     if (highest >= 7u) {
         unsigned seven[4]{};
         cpu_id(7u, 0u, seven);
-        avx2 = avx_usable && (seven[1] & (1u << 5)) != 0u;
         bmi2 = (seven[1] & (1u << 8)) != 0u;
     }
-    add(avx2, "AVX2");
+    add(avx2_usable(), "AVX2");
     add(bmi2, "BMI2");
     return out;
 }
@@ -656,6 +668,22 @@ std::uint64_t physical_memory_mib() {
 
 } // namespace
 
+bool cpu_has_avx() {
+#if defined(PK_X86)
+    return avx_usable();
+#else
+    return true;
+#endif
+}
+
+bool cpu_has_avx2() {
+#if defined(PK_X86)
+    return avx2_usable();
+#else
+    return true;
+#endif
+}
+
 void log_system_info() {
     static bool printed = false;
     if (printed) return;
diff --git a/host/perf/frame_stats.hpp b/host/perf/frame_stats.hpp
index 66bd012..cfef9d7 100644
--- a/host/perf/frame_stats.hpp
+++ b/host/perf/frame_stats.hpp
@@ -38,6 +38,11 @@ void add_render_time(Clock::duration duration);
 // One log line about the machine: CPU model and the instruction sets that matter to this build (SSE4.2, AVX, AVX2, FMA, BMI2),
 // logical cores and RAM. A report from a slow computer is hard to read without it. Printed once, whatever the performance setting.
 void log_system_info();
+// Whether this CPU, with this operating system, can run AVX and AVX2 code. True where it cannot be told (not x86). A build compiled for
+// AVX (the Windows build is, by default) must check this before it runs anything else: on a CPU without it the first AVX instruction
+// ends the program with no message at all.
+[[nodiscard]] bool cpu_has_avx();
+[[nodiscard]] bool cpu_has_avx2();
 
 // Where the render thread stops, for <prefix>_TRACE_STALLS. The waits count
 // towards "wait"; the copies are CPU work inside "render" that reads memory
-- 
2.54.0.windows.1

