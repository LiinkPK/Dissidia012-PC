+        const int height_texels = static_cast<int>(state.height) * line_scale;
+        const int radius = std::max(1, line_scale * 2 / 3);  // 4 texels at 6 per pixel: readable on a white background
+        halo.assign(coverage.size(), 0u);
+        for (int y = 0; y < height_texels; ++y) {
+            for (int x = 0; x < width_texels; ++x) {
+                const std::uint8_t value = coverage[static_cast<std::size_t>(y) * width_texels + x];
+                if (value == 0u) continue;
+                for (int dy = -radius; dy <= radius; ++dy) {
+                    const int yy = y + dy;
+                    if (yy < 0 || yy >= height_texels) continue;
+                    for (int dx = -radius; dx <= radius; ++dx) {
+                        const int xx = x + dx;
+                        if (xx < 0 || xx >= width_texels || dx * dx + dy * dy > radius * radius + 1) continue;
