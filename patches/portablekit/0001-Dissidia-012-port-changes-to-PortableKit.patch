+    if (id == nullptr) return choices;
+    auto array = static_cast<jobjectArray>(call.env->CallStaticObjectMethod(call.type, id));
+    if (call.failed() || array == nullptr) return choices;
+    const jsize count = call.env->GetArrayLength(array);
+    for (jsize i = 0; i < count; ++i) {
+        const std::optional<std::string> line = call.text(call.env->GetObjectArrayElement(array, i));
