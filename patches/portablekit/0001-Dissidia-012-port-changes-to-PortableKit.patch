diff --git a/host/adhoc/matching.cpp b/host/adhoc/matching.cpp
new file mode 100644
index 0000000..14987c3
--- /dev/null
+++ b/host/adhoc/matching.cpp
@@ -0,0 +1,232 @@
+#include "matching.hpp"
+
+#include <algorithm>
+
+namespace portablekit::adhoc::matching {
+
+namespace {
+
+constexpr std::uint64_t kExtraTimeoutUs = 2'000'000u; // slack on top of the keepalive periods
+
+void put32(std::string &out, std::uint32_t value) {
+    for (unsigned i = 0; i < 4u; ++i) out.push_back(static_cast<char>((value >> (8u * i)) & 0xFFu));
+}
+
+void put_mac(std::string &out, const Mac &mac) {
+    for (std::uint8_t byte : mac) out.push_back(static_cast<char>(byte));
+}
+
+} // namespace
+
+Context::Context(const Config &config, Io &io) : config_(config), io_(io) {
+    timeout_us_ = config.keepalive_us * static_cast<std::uint64_t>(std::max(1, config.init_count)) + kExtraTimeoutUs;
+}
+
+void Context::start(std::string hello) {
+    hello_ = std::move(hello);
+    running_ = true;
+    last_hello_ = 0u;
+    last_ping_ = 0u;
+}
+
+void Context::stop() {
+    if (!running_) return;
+    const std::string bye(1, static_cast<char>(9));
+    for (const Peer &peer : peers_) send_to(peer.mac, bye);
+    clear_peers();
+    running_ = false;
+}
+
+// Peers ----------------------------------------------------------------------
+
+Peer *Context::find(const Mac &mac) {
+    for (Peer &peer : peers_)
+        if (peer.mac == mac) return &peer;
+    return nullptr;
+}
+
+Peer *Context::find_state(PeerState state) {
+    for (Peer &peer : peers_)
+        if (peer.state == state) return &peer;
+    return nullptr;
+}
+
+Peer &Context::add(const Mac &mac, PeerState state) {
+    Peer peer;
+    peer.mac = mac;
+    peer.state = state;
+    peer.last_ping_us = io_.now_us();
+    peers_.push_back(peer);
+    return peers_.back();
+}
+
+int Context::count_children() const {
+    return static_cast<int>(std::count_if(peers_.begin(), peers_.end(), [](const Peer &p) { return p.state == PeerState::Child; }));
+}
+
+int Context::count_connected() const {
+    return static_cast<int>(std::count_if(peers_.begin(), peers_.end(), [](const Peer &p) {
+        return p.state == PeerState::Child || p.state == PeerState::Parent || p.state == PeerState::P2P;
+    }));
+}
+
+void Context::remove(const Mac &mac) {
+    peers_.erase(std::remove_if(peers_.begin(), peers_.end(), [&](const Peer &p) { return p.mac == mac; }), peers_.end());
+}
+
+void Context::clear_peers() { peers_.clear(); }
+
+std::vector<Mac> Context::members() const {
+    std::vector<Mac> out{config_.mac};
+    for (const Peer &peer : peers_)
+        if (peer.state == PeerState::Child || peer.state == PeerState::Parent || peer.state == PeerState::P2P)
+            out.push_back(peer.mac);
+    return out;
+}
+
+// Sending --------------------------------------------------------------------
+
+void Context::send_to(const Mac &to, const std::string &bytes) {
+    const auto port = peer_port_.find(to);
+    io_.send(to, port != peer_port_.end() ? port->second : config_.port, bytes);
+}
+
+void Context::broadcast(const std::string &bytes) {
+    for (const Mac &mac : io_.group())
+        if (mac != config_.mac) send_to(mac, bytes);
+}
+
+void Context::send_join(const Mac &to, const std::string &opt) {
+    std::string p(1, static_cast<char>(2));
+    put32(p, static_cast<std::uint32_t>(opt.size()));
+    p += opt;
+    send_to(to, p);
+}
+
+void Context::send_accept(const Mac &to, const std::string &opt) {
+    // A host tells the new child who else is connected, so the children know each other.
+    std::vector<Mac> siblings;
+    if (config_.mode == Mode::Host)
+        for (const Peer &peer : peers_)
+            if (peer.state == PeerState::Child && peer.mac != to) siblings.push_back(peer.mac);
+    std::string p(1, static_cast<char>(3));
+    put32(p, static_cast<std::uint32_t>(opt.size()));
+    put32(p, static_cast<std::uint32_t>(siblings.size()));
+    p += opt;
+    for (const Mac &mac : siblings) put_mac(p, mac);
+    send_to(to, p);
+}
+
+void Context::send_cancel(const Mac &to, const std::string &opt) {
+    std::string p(1, static_cast<char>(4));
+    put32(p, static_cast<std::uint32_t>(opt.size()));
+    p += opt;
+    send_to(to, p);
+}
+
+void Context::send_bulk(const Mac &to, const std::string &data) {
+    std::string p(1, static_cast<char>(5));
+    put32(p, static_cast<std::uint32_t>(data.size()));
+    p += data;
+    send_to(to, p);
+}
+
+// Tells the other children that `peer` joined.
+void Context::send_birth(const Peer &peer) {
+    std::string p(1, static_cast<char>(7));
+    put_mac(p, peer.mac);
+    for (const Peer &other : peers_)
+        if (other.state == PeerState::Child && other.mac != peer.mac) send_to(other.mac, p);
+}
+
+// Tells the other children that `peer` left.
+void Context::send_death(const Peer &peer) {
+    std::string p(1, static_cast<char>(8));
+    put_mac(p, peer.mac);
+    for (const Peer &other : peers_)
+        if (other.state == PeerState::Child && other.mac != peer.mac) send_to(other.mac, p);
+}
+
+// The calls of the game ------------------------------------------------------
+
+std::uint32_t Context::select_target(const Mac &target, const std::string &opt) {
+    if (!running_) return error::kNotRunning;
+    Peer *peer = find(target);
+    if (peer == nullptr) return error::kUnknownTarget;
+    if (config_.mode == Mode::Host) {
+        if (peer->state == PeerState::Child && peer->accepting) return error::kRequestInProgress;
+        if (peer->state == PeerState::Child) return error::kAlreadyEstablished;
+        if (count_children() == config_.maxpeers - 1) return error::kExceedMaxnum;
+        if (peer->state == PeerState::IncomingRequest) {
+            peer->state = PeerState::Child;
+            peer->accepting = true;
+            send_birth(*peer);
+            send_accept(peer->mac, opt);
+            return 0u;
+        }
+    } else if (config_.mode == Mode::Client) {
+        if (find_state(PeerState::Parent) != nullptr) return error::kAlreadyEstablished;
+        if (find_state(PeerState::OutgoingRequest) != nullptr) return error::kRequestInProgress;
+        if (peer->state == PeerState::Offer) {
+            peer->state = PeerState::OutgoingRequest;
+            send_join(peer->mac, opt);
+            return 0u;
+        }
+    } else {
+        if (find_state(PeerState::P2P) != nullptr) return error::kAlreadyEstablished;
+        if (find_state(PeerState::OutgoingRequest) != nullptr) return error::kRequestInProgress;
+        if (peer->state == PeerState::Offer) {
+            peer->state = PeerState::OutgoingRequest;
+            send_join(peer->mac, opt);
+            return 0u;
+        }
+        if (peer->state == PeerState::IncomingRequest) {
+            peer->state = PeerState::P2P;
+            send_accept(peer->mac, opt);
+            // The player who accepts is established at once, as the one who asked is when the accept arrives (on_accept): the game waits for
+            // this event before it leaves the lobby group, and without it the accepting side stays on "Preparing for online battle".
+            io_.post(kEventEstablished, peer->mac, {});
+            return 0u;
+        }
+    }
+    return error::kTargetNotReady;
+}
+
+std::uint32_t Context::cancel_target(const Mac &target, const std::string &opt) {
+    if (!running_) return error::kNotRunning;
+    Peer *peer = find(target);
+    if (peer == nullptr) return error::kUnknownTarget;
+    const Mode mode = config_.mode;
+    const PeerState state = peer->state;
+    const bool applies = (mode == Mode::Client && (state == PeerState::Parent || state == PeerState::OutgoingRequest)) ||
+                         (mode == Mode::Host && (state == PeerState::Child || state == PeerState::IncomingRequest)) ||
+                         (mode == Mode::P2P && (state == PeerState::P2P || state == PeerState::IncomingRequest));
+    if (!applies) return 0u;
+    const bool tell_others = mode == Mode::Host && state == PeerState::Child && count_connected() > 1;
+    const Mac mac = peer->mac;
+    if (mode == Mode::P2P && state == PeerState::IncomingRequest) {
+        send_cancel(mac, opt);
+        peer->state = PeerState::Offer;
+        peer->last_ping_us = io_.now_us();
+        return 0u;
+    }
+    send_cancel(mac, opt);
+    if (tell_others) send_death(*peer);
+    remove(mac);
+    return 0u;
+}
+
+std::uint32_t Context::send_data(const Mac &target, const std::string &data) {
+    if (!running_) return error::kNotRunning;
+    if (data.empty()) return error::kInvalidDatalen;
+    Peer *peer = find(target);
+    if (peer == nullptr) return error::kUnknownTarget;
+    if (peer->state != PeerState::Parent && peer->state != PeerState::Child && peer->state != PeerState::P2P)
+        return error::kNotEstablished;
+    send_bulk(peer->mac, data);
+    // The transport is reliable and in order, so the data is as good as acknowledged once it is sent.
+    io_.post(kEventDataAck, peer->mac, {});
+    return 0u;
+}
+
+} // namespace portablekit::adhoc::matching
