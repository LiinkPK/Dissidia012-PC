diff --git a/host/install/shared_data.cpp b/host/install/shared_data.cpp
new file mode 100644
index 0000000..04d84ff
--- /dev/null
+++ b/host/install/shared_data.cpp
@@ -0,0 +1,119 @@
+#include "install/shared_data.hpp"
+
+#include "install/user_data.hpp"
+
+#include <fstream>
+#include <system_error>
+
+namespace portablekit::install {
+namespace {
+
+namespace fs = std::filesystem;
+
+// The app's own files in its private folder: not the player's data, so not moved and not deleted.
+bool app_file(const fs::path &relative) {
+    if (relative.empty()) return false;
+    const std::string first = relative.begin()->string();
+    const std::string name = relative.filename().string();
+    if (first == "bundled") return true;
+    const auto ends = [&](const char *tail) {
+        const std::string t = tail;
+        return name.size() >= t.size() && name.compare(name.size() - t.size(), t.size(), t) == 0;
+    };
+    return ends(".log") || ends(".part") || ends(".partial");
+}
+
+bool has_marker(const fs::path &shared_dir) {
+    std::error_code ec;
+    return fs::exists(shared_dir / kSharedDataMarker, ec);
+}
+
+bool write_marker(const fs::path &shared_dir) {
+    std::ofstream out(shared_dir / kSharedDataMarker, std::ios::trunc);
+    out << "This folder is the game's data folder.\n";
+    return static_cast<bool>(out);
+}
+
+} // namespace
+
+fs::path choose_data_root(const fs::path &private_dir, const fs::path &shared_dir, bool access) {
+    if (shared_dir.empty() || !access) return private_dir;
+    if (has_marker(shared_dir)) return shared_dir;
+    std::error_code ec;
+    // A player who already has data in the private folder is moved only when they ask: moving it here would split their data.
+    if (fs::exists(private_dir / kSettingsFile, ec)) return private_dir;
+    fs::create_directories(shared_dir, ec);
+    if (ec || !write_marker(shared_dir)) return private_dir;
+    return shared_dir;
+}
+
+bool copy_data_tree(const fs::path &from, const fs::path &to, std::string &error) {
+    std::error_code ec;
+    fs::create_directories(to, ec);
+    if (ec) {
+        error = "cannot create " + to.string() + ": " + ec.message();
+        return false;
+    }
+    for (fs::recursive_directory_iterator it(from, fs::directory_options::skip_permission_denied, ec), end; !ec && it != end;
+         it.increment(ec)) {
+        const fs::path relative = fs::relative(it->path(), from, ec);
+        if (ec) break;
+        if (app_file(relative)) {
+            if (it->is_directory(ec)) it.disable_recursion_pending();
+            continue;
+        }
+        const fs::path target = to / relative;
+        if (it->is_directory(ec)) {
+            fs::create_directories(target, ec);
+            if (ec) break;
+            continue;
+        }
+        if (!it->is_regular_file(ec)) continue;
+        if (fs::exists(target, ec) && fs::file_size(target, ec) == it->file_size(ec)) continue;
+        fs::create_directories(target.parent_path(), ec);
+        const fs::path partial = target.string() + ".part";
+        fs::copy_file(it->path(), partial, fs::copy_options::overwrite_existing, ec);
+        if (ec) break;
+        fs::rename(partial, target, ec);
+        if (ec) break;
+    }
+    if (ec) {
+        error = ec.message();
+        return false;
+    }
+    return true;
+}
+
+bool move_data_to_shared(const fs::path &private_dir, const fs::path &shared_dir, std::string &error) {
+    if (shared_dir.empty()) {
+        error = "no shared folder is set";
+        return false;
+    }
+    if (!copy_data_tree(private_dir, shared_dir, error)) return false;
+    if (!write_marker(shared_dir)) {
+        error = "the data was copied but the folder could not be marked";
+        return false;
+    }
+    return true;
+}
+
+bool delete_private_copy(const fs::path &private_dir, const fs::path &shared_dir, std::string &error) {
+    if (!has_marker(shared_dir)) {
+        error = "the shared folder is not the data folder yet";
+        return false;
+    }
+    std::error_code ec;
+    for (fs::directory_iterator it(private_dir, ec), end; !ec && it != end; it.increment(ec)) {
+        const fs::path relative = it->path().filename();
+        if (app_file(relative)) continue;
+        std::error_code removed;
+        fs::remove_all(it->path(), removed);
+        if (removed) {
+            error = "cannot delete " + it->path().string() + ": " + removed.message();
+            return false;
+        }
+    }
+    return true;
+}
+
+} // namespace portablekit::install
diff --git a/host/install/shared_data.hpp b/host/install/shared_data.hpp
new file mode 100644
index 0000000..133f157
--- /dev/null
+++ b/host/install/shared_data.hpp
@@ -0,0 +1,34 @@
+#pragma once
+
+// A game's data folder in a place the player can open. Android's default is the app's private storage, which no file manager shows
+// (saves, textures, mods, cheats are all under it). With all files access the data folder can be a normal folder in the phone's
+// shared storage instead. These functions decide which folder is in use and move the data there; they use no Android calls, so they
+// are tested on any system. The marker file in the shared folder is the one switch: it is written last, after everything is copied,
+// so a move that stops half way changes nothing.
+#include <filesystem>
+#include <string>
+
+namespace portablekit::install {
+
+inline constexpr const char *kSharedDataMarker = ".data_root";
+
+// The folder in use. The shared one when `access` is true and it is already the data folder (its marker is there), or when this is a
+// fresh install (the private folder holds no settings yet): it is created and marked. Otherwise the private one: an existing player
+// keeps their data where it is until the move is asked for.
+[[nodiscard]] std::filesystem::path choose_data_root(const std::filesystem::path &private_dir, const std::filesystem::path &shared_dir,
+                                                     bool access);
+
+// Copies the player's data from `from` to `to`, leaving out the app's own files (bundled fonts, logs, half-made copies). A file that is
+// already there with the same size is kept. False with `error` set at the first failure; nothing is deleted.
+[[nodiscard]] bool copy_data_tree(const std::filesystem::path &from, const std::filesystem::path &to, std::string &error);
+
+// copy_data_tree, then the marker: from then on the shared folder is the data folder.
+[[nodiscard]] bool move_data_to_shared(const std::filesystem::path &private_dir, const std::filesystem::path &shared_dir,
+                                       std::string &error);
+
+// Deletes the private copy of the data once the shared folder is in use (its marker is there); refuses otherwise. The app's own files
+// stay.
+[[nodiscard]] bool delete_private_copy(const std::filesystem::path &private_dir, const std::filesystem::path &shared_dir,
+                                       std::string &error);
+
+} // namespace portablekit::install
