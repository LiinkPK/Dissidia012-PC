+
+    // The game writes a glyph's coverage as a 4-bit palette index (coverage / 16), so the palette is the colour ramp: each
+    // texel takes the colour between the two entries its coverage falls between.
+    std::vector<std::uint8_t> coverage;
+    if (!(subtitle_line && dark_ramp))
+        coverage = fonts::render_line(glyphs, state.width, state.height, line_scale, static_cast<int>(line_size_percent));
+    // The letters' outline: each inked texel spreads its coverage to the texels within a radius of 4 (at 6 texels per
+    // pixel, about 4 device pixels at the default window size), so the outline is a smooth ring that touches the letters.
+    std::vector<std::uint8_t> halo;
+    if (subtitle_line && !dark_ramp &&
+        coverage.size() == static_cast<std::size_t>(state.width) * line_scale * state.height * line_scale) {
