+bool is_newer(const std::string &latest, const std::string &local) {
+    // The numbers of the tag: "v1.0-8-g424ca06-dirty" is release 1.0 and some commits, so only "1.0" counts.
+    const std::vector<int> a = numbers(latest), b = numbers(local);
+    if (a.empty() || b.empty()) return false;
+    return std::lexicographical_compare(b.begin(), b.end(), a.begin(), a.end());
+}
+
+std::string local_version() { return kLocalVersion(); }
+
+void start_check() {
+#if defined(PK_UPDATER)
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state == State::Checking || g_status.state == State::Downloading) return;
+        g_status = Status{};
+        g_status.state = State::Checking;
+    }
+    std::thread(check_thread).detach();
+#elif defined(PK_UPDATER_ANDROID)
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state == State::Checking || g_status.state == State::Downloading) return;
+        g_status = Status{};
+        g_status.state = State::Checking;
+    }
+    std::thread(android_check_thread).detach();
+#endif
+}
+
+Status status() {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    return g_status;
+}
+
+AssetInfo latest_asset(const std::string &name, std::string &error) {
+    std::string body;
+#if defined(PK_UPDATER)
+    if (!http_get(kDataPackApi, [&](const char *data, std::size_t n) { body.append(data, n); }, nullptr, error)) return {};
+#elif defined(PK_UPDATER_ANDROID)
+    const std::optional<std::string> text = android::update_get(kDataPackApi, error);
+    if (!text) return {};
+    body = *text;
+#else
+    error = "the release list is not available here";
+    return {};
+#endif
+    for (std::size_t at = body.find("\"browser_download_url\""); at != std::string::npos;
+         at = body.find("\"browser_download_url\"", at + 1u)) {
+        const std::string url = json_string(body, "browser_download_url", at);
+        if (url.size() >= name.size() && url.compare(url.size() - name.size(), name.size(), name) == 0) {
+            AssetInfo info;
+            info.url = url;
+            // "size" and "updated_at" come before the address in the same file's record.
+            const std::size_t size_at = body.rfind("\"size\":", at);
+            if (size_at != std::string::npos) info.size = std::strtoull(body.c_str() + size_at + 7u, nullptr, 10);
+            const std::size_t stamp_at = body.rfind("\"updated_at\"", at);
+            if (stamp_at != std::string::npos) info.stamp = json_string(body, "updated_at", stamp_at);
+            return info;
+        }
+    }
+    error = "the latest release has no " + name;
+    return {};
+}
+
+std::string latest_asset_url(const std::string &name, std::string &error) { return latest_asset(name, error).url; }
+
+bool download_file(const std::string &url, const std::filesystem::path &target, std::uint64_t expected_size,
+                   const std::function<void(std::uint64_t, std::uint64_t)> &progress, std::string &error) {
+#if defined(PK_UPDATER)
+    std::error_code ec;
+    std::filesystem::create_directories(target.parent_path(), ec);
+    std::filesystem::path partial = target;
+    partial += ".part";
+    std::uint64_t written = 0;
+    bool ok = false;
+    {
+        std::ofstream out(partial, std::ios::binary | std::ios::trunc);
+        if (!out) {
+            error = "cannot write " + partial.string();
+            return false;
+        }
+        std::uint64_t previous_size = 0;
+        {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            previous_size = g_zip_size;
+            g_zip_size = expected_size;  // the curl download reports its progress against this
+        }
+        ok = http_get(url, [&](const char *data, std::size_t n) {
+                 out.write(data, static_cast<std::streamsize>(n));
+                 written += n;
+             },
+             [&](std::uint64_t done, std::uint64_t total) {
+                 if (progress) progress(done, total != 0u ? total : expected_size);
+             },
+             error);
+        {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            g_zip_size = previous_size;
+        }
+        out.close();
+        if (ok && !out) {
+            error = "writing the file failed (is the disk full?)";
+            ok = false;
+        }
+    }
+    if (ok && expected_size != 0u && written != expected_size) {
+        error = "the file is " + std::to_string(written) + " bytes, not the " + std::to_string(expected_size) + " expected";
+        ok = false;
+    }
+    if (!ok) {
+        std::filesystem::remove(partial, ec);
+        if (error.empty()) error = "the download failed";
+        return false;
+    }
+    std::filesystem::remove(target, ec);
+    std::filesystem::rename(partial, target, ec);
+    if (ec) {
+        error = "the downloaded file could not be kept: " + ec.message();
+        return false;
+    }
+    return true;
+#else
+    (void)url;
+    (void)target;
+    (void)expected_size;
+    (void)progress;
+    error = "this platform downloads through its own code";
+    return false;
+#endif
+}
+
+#if defined(_WIN32)
+namespace {
+
+HANDLE g_helper = nullptr;  // the hidden script: unpacks the update while the game runs, installs it once the game has closed
+std::filesystem::path g_progress_path;
+
+// What the script is told to do, written to the temp folder when an update starts.
+const char *kHelperScript = R"PS(param($ProcessId, $Zip, $Target, $Exe, $Progress)
+$log = Join-Path $env:TEMP 'd012_update.log'
+Set-Content -LiteralPath $log -Value ('started ' + (Get-Date) + ' zip=' + $Zip + ' target=' + $Target + ' exe=' + $Exe) -ErrorAction SilentlyContinue
+# Progress reporting must never stop an update: the file is opened sharing read, write and delete with the game, which reads it
+# every 200 ms, and a write that still meets a lock (a scanner, a reader) is tried again instead of failing the unpacking.
+function Report($text) {
+  for ($try = 0; $try -lt 25; $try++) {
+    try {
+      $stream = [System.IO.File]::Open($Progress, [System.IO.FileMode]::Create, [System.IO.FileAccess]::Write, ([System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete))
+      try { $bytes = [System.Text.Encoding]::ASCII.GetBytes([string]$text); $stream.Write($bytes, 0, $bytes.Length) } finally { $stream.Dispose() }
+      return
+    } catch { Start-Sleep -Milliseconds 40 }
+  }
+}
+$stage = Join-Path $Target 'update_staging'
+try {
+  Add-Type -AssemblyName System.IO.Compression.FileSystem
+  $name = Split-Path $Exe -Leaf
+  if (Test-Path -LiteralPath $stage) { Remove-Item -LiteralPath $stage -Recurse -Force }
+  New-Item -ItemType Directory -Force -Path $stage | Out-Null
+  Report '0/1'
+  $archive = [System.IO.Compression.ZipFile]::OpenRead($Zip)
+  try {
+    $prefix = $null
+    foreach ($entry in $archive.Entries) {
+      $path = $entry.FullName -replace '\\', '/'
+      if ($path -eq $name -or $path.EndsWith('/' + $name)) { $prefix = $path.Substring(0, $path.Length - $name.Length); break }
+    }
+    if ($null -eq $prefix) { throw ('the update has no ' + $name) }
+    $todo = New-Object System.Collections.ArrayList
+    foreach ($entry in $archive.Entries) {
+      $path = $entry.FullName -replace '\\', '/'
+      if (-not $path.StartsWith($prefix) -or $path.EndsWith('/')) { continue }
+      $relative = $path.Substring($prefix.Length)
+      if ($relative -match '^game/' -or ($relative -match '^data/' -and $relative -notmatch '^data/(fonts|textures)/')) { continue }
+      $final = Join-Path $Target ($relative -replace '/', '\')
+      if ($relative -match '^data/textures/') {
+        # The texture pack: only pictures that are new are written, straight into place; textures.ini, which lists them,
+        # is always replaced.
+        if ($relative -notmatch '(^|/)textures\.ini$' -and (Test-Path -LiteralPath $final)) { continue }
+        $destination = $final
+      } else {
+        $destination = Join-Path $stage ($relative -replace '/', '\')
+      }
+      [void]$todo.Add([pscustomobject]@{ Entry = $entry; Destination = $destination })
+    }
+    $total = $todo.Count
+    $count = 0
+    foreach ($item in $todo) {
+      New-Item -ItemType Directory -Force -Path (Split-Path $item.Destination) | Out-Null
+      [System.IO.Compression.ZipFileExtensions]::ExtractToFile($item.Entry, $item.Destination, $true)
+      $count++
+      if ($count % 5 -eq 0 -or $count -eq $total) { Report ($count.ToString() + '/' + $total.ToString()) }
+    }
+  } finally { $archive.Dispose() }
+  Report 'unpacked'
+} catch {
+  $_ | Out-File -LiteralPath $log -Append -ErrorAction SilentlyContinue
+  Report ('failed: ' + $_.Exception.Message)
+  Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction SilentlyContinue
+  exit
+}
+# Unpacked while the game ran. Once it has closed, the staged files go over the game's own, and the game starts again.
+try {
+  Wait-Process -Id $ProcessId -ErrorAction SilentlyContinue
+  Start-Sleep -Seconds 1
+  # The overlays are replaced as a whole: a library of an older version left beside the new ones would be loaded with them.
+  if (Test-Path -LiteralPath (Join-Path $stage 'overlays')) { Remove-Item -LiteralPath (Join-Path $Target 'overlays') -Recurse -Force -ErrorAction SilentlyContinue }
+  robocopy $stage $Target /E /MOVE /R:8 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null
+  if ($LASTEXITCODE -ge 8) { throw ('robocopy failed: ' + $LASTEXITCODE) }
+  Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction SilentlyContinue
+  if ($Zip -like (Join-Path $env:TEMP '*')) { Remove-Item -LiteralPath $Zip -Force -ErrorAction SilentlyContinue }
+  Add-Content -LiteralPath $log -Value 'installed' -ErrorAction SilentlyContinue
+} catch {
+  $_ | Out-File -LiteralPath $log -Append
+}
+Start-Process -FilePath $Exe -WorkingDirectory $Target
+)PS";
+
+std::string read_text(const std::filesystem::path &path) {
+    std::ifstream in(path, std::ios::binary);
+    std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    while (!text.empty() && (text.back() == '\r' || text.back() == '\n' || text.back() == ' ')) text.pop_back();
+    return text;
+}
+
+// Starts the script with no window of its own. It reports through a file: "N/total" while unpacking, then "unpacked",
+// or "failed: why".
+bool start_helper(const std::filesystem::path &zip, std::string &error) {
+    std::error_code ec;
+    const std::filesystem::path temp = std::filesystem::temp_directory_path(ec);
+    const std::filesystem::path script = temp / "d012_update.ps1";
+    // One file per run: a progress file still held by an earlier run (or a reader of it) cannot block this one, and
+    // "Try again" after a failure starts clean.
+    g_progress_path = temp / ("d012_update_progress_" + std::to_string(GetCurrentProcessId()) + "_" + std::to_string(GetTickCount64()) + ".txt");
+    for (const auto &old : std::filesystem::directory_iterator(temp, ec))
+        if (old.path().filename().string().rfind("d012_update_progress", 0) == 0) std::filesystem::remove(old.path(), ec);
+    {
+        std::ofstream out(script, std::ios::trunc);
+        out << kHelperScript;
+        if (!out) {
+            error = "the installer script could not be written";
+            return false;
+        }
+    }
+    wchar_t exe_buffer[MAX_PATH * 4]{};
+    GetModuleFileNameW(nullptr, exe_buffer, MAX_PATH * 4);
+    const std::filesystem::path exe = exe_buffer;
+    // By its full path: a PATH without the PowerShell folder must not keep the update from starting.
+    wchar_t system_dir[MAX_PATH]{};
+    GetSystemDirectoryW(system_dir, MAX_PATH);
+    std::wstring powershell = std::wstring(system_dir) + L"\\WindowsPowerShell\\v1.0\\powershell.exe";
+    if (!std::filesystem::exists(powershell, ec)) powershell = L"powershell.exe";
+    const std::wstring command = L"\"" + powershell + L"\" -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" +
+                                 script.wstring() + L"\" -ProcessId " + std::to_wstring(GetCurrentProcessId()) + L" -Zip \"" +
+                                 zip.wstring() + L"\" -Target \"" + exe.parent_path().wstring() + L"\" -Exe \"" + exe.wstring() +
+                                 L"\" -Progress \"" + g_progress_path.wstring() + L"\"";
+    std::vector<wchar_t> mutable_command(command.begin(), command.end());
+    mutable_command.push_back(L'\0');
+    STARTUPINFOW startup{};
+    startup.cb = sizeof(startup);
+    startup.dwFlags = STARTF_USESHOWWINDOW;
+    startup.wShowWindow = SW_HIDE;
+    PROCESS_INFORMATION process{};
+    // No window at all; the script outlives the game, which is what it waits for.
+    if (!CreateProcessW(nullptr, mutable_command.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP,
+                        nullptr, nullptr, &startup, &process)) {
+        error = "PowerShell could not be started (error " + std::to_string(GetLastError()) + ")";
+        return false;
+    }
+    CloseHandle(process.hThread);
+    if (g_helper != nullptr) CloseHandle(g_helper);
+    g_helper = process.hProcess;
+    return true;
+}
+
+// Runs on the download's thread: starts the script, then follows what it reports until the update is unpacked.
+void unpack(const std::filesystem::path &zip) {
+    set_status([](Status &s) {
+        s.state = State::Unpacking;
+        s.progress = 0.0f;
+        s.error.clear();
+    });
+    std::string error;
+    if (!start_helper(zip, error)) {
+        set_status([&](Status &s) {
+            s.state = State::Failed;
+            s.error = error;
+        });
+        return;
+    }
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        std::string text = read_text(g_progress_path);
+        const bool stopped = WaitForSingleObject(g_helper, 0) == WAIT_OBJECT_0;
+        if (stopped) text = read_text(g_progress_path);  // what it wrote last
+        if (text == "unpacked") {
+            set_status([](Status &s) {
+                s.state = State::Ready;
+                s.progress = 1.0f;
+            });
+            return;
+        }
+        if (text.rfind("failed:", 0) == 0) {
+            set_status([&](Status &s) {
+                s.state = State::Failed;
+                s.error = text.substr(7);
+            });
+            return;
+        }
+        if (stopped) {
+            set_status([](Status &s) {
+                s.state = State::Failed;
+                s.error = "the installer stopped (see d012_update.log in the temp folder)";
+            });
+            return;
+        }
+        const std::size_t slash = text.find('/');
+        if (slash != std::string::npos) {
+            const double done = std::atof(text.substr(0, slash).c_str());
+            const double total = std::atof(text.substr(slash + 1u).c_str());
+            if (total > 0.0) set_status([&](Status &s) { s.progress = static_cast<float>(done / total); });
+        }
+    }
+}
+
+} // namespace
+#elif defined(PK_UPDATER)
+namespace {
+
+pid_t g_helper = -1;  // the shell script: unpacks the update while the game runs, installs it once the game has closed
