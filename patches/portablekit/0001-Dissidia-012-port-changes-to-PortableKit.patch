+++ b/host/hle/hle_adhoc_matching.cpp
@@ -0,0 +1,124 @@
+#include "hle_adhoc_matching.hpp"
+
+#include "adhoc/client.hpp"
+#include "kernel/kernel.hpp"
+
+#include <chrono>
+#include <cstdio>
+
+namespace portablekit {
+
+// hle_adhoc.cpp: this machine's virtual MAC.
+adhoc::Mac adhoc_own_mac();
+
+namespace matching_hle {
+
+State &state() {
+    static State value;
+    return value;
+}
+
+Entry *find_entry(int id) {
+    const auto it = state().contexts.find(id);
+    return it == state().contexts.end() ? nullptr : it->second.get();
+}
+
+adhoc::Mac read_mac(const psprecomp::GuestMemory &memory, std::uint32_t address) {
+    adhoc::Mac mac{};
+    for (std::size_t i = 0; i < mac.size(); ++i) mac[i] = memory.load8(address + static_cast<std::uint32_t>(i));
+    return mac;
+}
+
+std::string read_bytes(const psprecomp::GuestMemory &memory, std::uint32_t address, std::uint32_t length) {
+    std::string out(length, '\0');
+    for (std::uint32_t i = 0; i < length; ++i) out[i] = static_cast<char>(memory.load8(address + i));
+    return out;
+}
+
+// EntryIo -------------------------------------------------------------------
+
+void EntryIo::send(const adhoc::Mac &to, std::uint16_t port, const std::string &bytes) {
+    if (owner->pdp != 0) adhoc::Client::get().pdp_send(owner->pdp, to, port, bytes.data(), bytes.size());
+}
+
+std::vector<adhoc::Mac> EntryIo::group() {
+    std::vector<adhoc::Mac> macs;
+    for (const adhoc::Peer &peer : adhoc::Client::get().peers()) macs.push_back(peer.mac);
+    return macs;
+}
+
+void EntryIo::post(int event, const adhoc::Mac &from, const std::string &opt) {
+    owner->events.push_back(PendingEvent{event, from, opt});
+}
+
+std::uint64_t EntryIo::now_us() {
+    using namespace std::chrono;
+    return static_cast<std::uint64_t>(duration_cast<microseconds>(steady_clock::now().time_since_epoch()).count());
+}
+
+// Running ---------------------------------------------------------------------
+
+std::uint32_t start_entry(Entry &entry, std::string hello) {
+    const adhoc::matching::Config &config = entry.context->config();
+    entry.pdp = adhoc::Client::get().pdp_open(config.port, config.rxbuflen);
+    if (entry.pdp == 0) return adhoc::matching::error::kPortInUse;
+    entry.context->start(std::move(hello));
+    if (!state().hooked) {
+        state().hooked = true;
+        kernel().add_vblank_hook(pump);
+    }
+    return 0u;
+}
+
+void stop_entry(Entry &entry) {
+    entry.context->stop();
+    if (entry.pdp != 0) adhoc::Client::get().pdp_close(entry.pdp);
+    entry.pdp = 0;
+    entry.events.clear();
+}
+
+namespace {
+
+// The handler is called as handler(id, event, mac*, optlen, opt*); the mac and the option live in a block of guest
+// memory that is given back when the handler returns.
+void deliver(Entry &entry, int id, const PendingEvent &event) {
+    Kernel &k = kernel();
+    const auto size = static_cast<std::uint32_t>(8u + event.opt.size());
+    const std::int32_t block = k.allocate_block("AdhocMatchingEvent", 1u, (size + 15u) & ~15u, 0u);
+    if (block < 0) return;
+    const MemoryBlock *memory = k.find_block(static_cast<SceUID>(block));
+    if (memory == nullptr) return;
+    auto &guest = k.runtime().memory();
+    for (std::size_t i = 0; i < event.from.size(); ++i) guest.store8(memory->address + static_cast<std::uint32_t>(i), event.from[i]);
+    for (std::size_t i = 0; i < event.opt.size(); ++i)
+        guest.store8(memory->address + 8u + static_cast<std::uint32_t>(i), static_cast<std::uint8_t>(event.opt[i]));
+    InterruptCall call{};
+    call.function = entry.callback;
+    call.arguments = {static_cast<std::uint32_t>(id), static_cast<std::uint32_t>(event.event), memory->address,
+                      static_cast<std::uint32_t>(event.opt.size()), memory->address + 8u, 0u, 0u, 0u};
+    call.argument_count = 5u;
+    const auto uid = static_cast<SceUID>(block);
+    call.on_return = [uid](std::uint32_t) { kernel().free_block(uid); };
+    if (adhoc::Client::tracing())
+        std::fprintf(stderr, "[adhoc] matching %d: event %d, %zu bytes\n", id, event.event, event.opt.size());
+    k.queue_interrupt(std::move(call));
+}
+
+} // namespace
+
+void pump() {
+    for (auto &[id, entry] : state().contexts) {
+        if (!entry->context->running() || entry->pdp == 0) continue;
+        while (auto datagram = adhoc::Client::get().pdp_receive(entry->pdp))
+            entry->context->on_datagram(datagram->source, datagram->port, datagram->data);
+        entry->context->tick();
+        while (!entry->events.empty()) {
+            PendingEvent event = std::move(entry->events.front());
+            entry->events.pop_front();
+            deliver(*entry, id, event);
+        }
+    }
+}
+
+} // namespace matching_hle
+} // namespace portablekit
