+    if (adhoc_online_mode()) return 1.0;
+    // The setting is the step the player picked and the menu shows (2x, 4x, 8x). The factor it runs at is 2.5, 6.3 or 16: from Normal
+    // (1) each step is about 2.5 times the one before, because speed is felt as a ratio, so every step up feels the same. The pacing
+    // keeps these exactly (measured at 14).
+    switch (settings::current().game_speed) {
+    case 2u: return 2.5;
+    case 4u: return 6.3;
+    case 8u: return 16.0;
+    default: return 1.0;
+    }
+}
+
+bool adhoc_unthrottled() { return settings::current().unthrottled && !adhoc_online_mode(); }
