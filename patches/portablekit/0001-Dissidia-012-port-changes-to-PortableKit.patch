+    std::uint32_t ink_left = full_width, ink_top = full_height, ink_right = 0u, ink_bottom = 0u;
+    // With an outline the ink reaches as far as the halo (it holds every inked texel and its surroundings).
+    const std::vector<std::uint8_t> &reach = halo.empty() ? coverage : halo;
+    if (reach.size() == static_cast<std::size_t>(full_width) * full_height) {
+        for (std::uint32_t row = 0; row < full_height; ++row) {
+            const std::uint8_t *line_pixels = reach.data() + static_cast<std::size_t>(row) * full_width;
+            std::uint32_t first = 0u;
+            while (first < full_width && line_pixels[first] == 0u) ++first;
+            if (first == full_width) continue;
+            std::uint32_t last = full_width - 1u;
+            while (line_pixels[last] == 0u) --last;
