+
+const char *kHelperScript = R"SH(#!/bin/sh
+# Unpacks the update while the game runs, then installs it once the game has closed, and starts the game again.
+# $1 game's process id, $2 the .tar.gz, $3 the game's folder, $4 the game's executable, $5 progress file
+PID="$1"; PKG="$2"; TARGET="$3"; EXE="$4"; PROGRESS="$5"
+LOG="${TMPDIR:-/tmp}/d012_update.log"
+STAGE="$TARGET/update_staging"
+# Run from inside a macOS .app (X.app, Contents, MacOS, the executable): the whole .app is replaced, never written into, so the unpacking
+# goes beside it and the player's data (kept outside the app) is not involved.
+APPDIR=""
+case "$EXE" in *".app/Contents/MacOS/"*) APPDIR="$(dirname "$(dirname "$(dirname "$EXE")")")"; STAGE="$(dirname "$APPDIR")/.d012_update_staging" ;; esac
+report() { printf '%s\n' "$1" > "$PROGRESS"; }
+fail() { printf '%s\n' "$1" >> "$LOG"; report "failed: $1"; rm -rf "$STAGE"; exit 1; }
+printf 'started %s pkg=%s target=%s exe=%s\n' "$(date)" "$PKG" "$TARGET" "$EXE" > "$LOG"
+
+rm -rf "$STAGE"
+mkdir -p "$STAGE" || fail "cannot write in $TARGET"
+report "0/1"
+NAME="$(basename "$EXE")"
+TOTAL="$(tar -tzf "$PKG" 2>>"$LOG" | wc -l | tr -d ' ')"
+[ "${TOTAL:-0}" -gt 0 ] || fail "the update could not be read"
+# The package holds its files in one folder (or at the top): the folder is the one with the game's executable.
+PREFIX="$(tar -tzf "$PKG" 2>>"$LOG" | grep -E "(^|/)$NAME\$" | head -n 1 | sed "s|$NAME\$||")"
+tar -tzf "$PKG" 2>/dev/null | grep -qE "(^|/)$NAME\$" || fail "the update has no $NAME"
+COUNT=0
+tar -xzvf "$PKG" -C "$STAGE" 2>&1 | while IFS= read -r line; do
+  COUNT=$((COUNT + 1))
+  [ $((COUNT % 5)) -eq 0 ] && report "$COUNT/$TOTAL"
+done
+[ -f "$STAGE/${PREFIX}$NAME" ] || fail "the update could not be unpacked"
+report "unpacked"
+
+# Unpacked while the game ran. Once it has closed, the new files go over the game's own.
+while kill -0 "$PID" 2>/dev/null; do sleep 1; done
+sleep 1
+if [ -n "$APPDIR" ]; then
+  APPNAME="$(basename "$APPDIR")"
+  NEWAPP="$STAGE/$APPNAME"
+  [ -d "$NEWAPP" ] || fail "the update has no $APPNAME"
+  BACKUP="$(dirname "$APPDIR")/.$APPNAME.old"
+  rm -rf "$BACKUP"
+  mv "$APPDIR" "$BACKUP" || fail "the old app could not be moved aside"
+  if mv "$NEWAPP" "$APPDIR"; then rm -rf "$BACKUP"; else mv "$BACKUP" "$APPDIR"; fail "the new app could not be put in place"; fi
+  # A downloaded app carries the quarantine flag; the update came from the game itself, so it is cleared.
+  xattr -dr com.apple.quarantine "$APPDIR" 2>/dev/null
+  rm -rf "$STAGE"
+  case "$PKG" in "${TMPDIR:-/tmp}/"?*) rm -f "$PKG" ;; esac
+  printf 'installed (app)\n' >> "$LOG"
+  nohup open "$APPDIR" >/dev/null 2>&1 &
+  exit 0
+fi
+SRC="$STAGE/${PREFIX%/}"
+[ -n "$PREFIX" ] || SRC="$STAGE"
+# The overlays are replaced as a whole: a library of an older version left beside the new ones would be loaded with them.
+[ -d "$SRC/overlays" ] && rm -rf "$TARGET/overlays"
+(
+  cd "$SRC" || exit 1
+  # everything except the player's own folders
+  for item in * .[!.]*; do
+    [ -e "$item" ] || continue
+    case "$item" in game|data|update_staging) continue ;; esac
+    cp -Rp "$item" "$TARGET/" || exit 1
+  done
+  # data/fonts: replaced. data/textures: only pictures that are new; textures.ini is always replaced.
+  if [ -d data/fonts ]; then mkdir -p "$TARGET/data/fonts" && cp -Rp data/fonts/. "$TARGET/data/fonts/"; fi
+  if [ -d data/textures ]; then
+    find data/textures -type f | while IFS= read -r file; do
+      if [ ! -e "$TARGET/$file" ] || [ "$(basename "$file")" = "textures.ini" ]; then
+        mkdir -p "$(dirname "$TARGET/$file")" && cp -p "$file" "$TARGET/$file"
+      fi
+    done
+  fi
+) >> "$LOG" 2>&1 || printf 'copy failed\n' >> "$LOG"
+chmod +x "$EXE" "$TARGET/run.sh" 2>/dev/null
+rm -rf "$STAGE"
+case "$PKG" in "${TMPDIR:-/tmp}/"?*) rm -f "$PKG" ;; esac
+printf 'installed\n' >> "$LOG"
+cd "$TARGET" || exit 1
+# run.sh sets the library and Vulkan paths; without it the executable is started as it is
+if [ -x ./run.sh ]; then nohup ./run.sh >/dev/null 2>&1 & else nohup "$EXE" >/dev/null 2>&1 & fi
+)SH";
+
+std::string read_text(const std::filesystem::path &path) {
+    std::ifstream in(path, std::ios::binary);
+    std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    while (!text.empty() && (text.back() == '\r' || text.back() == '\n' || text.back() == ' ')) text.pop_back();
+    return text;
+}
+
+// Starts the script in a session of its own (it outlives the game, which is what it waits for), with no terminal.
+// It reports through a file: "N/total" while unpacking, then "unpacked", or "failed: why".
+bool start_helper(const std::filesystem::path &package, std::string &error) {
+    std::error_code ec;
+    const std::filesystem::path temp = std::filesystem::temp_directory_path(ec);
+    const std::filesystem::path script = temp / "d012_update.sh";
+    g_progress_path = temp / "d012_update_progress.txt";
+    std::filesystem::remove(g_progress_path, ec);
+    {
+        std::ofstream out(script, std::ios::trunc);
+        out << kHelperScript;
+        if (!out) {
+            error = "the installer script could not be written";
+            return false;
+        }
+    }
+    const std::filesystem::path exe = portablekit::executable_path();
+    if (exe.empty()) {
+        error = "the game's own path is not known";
+        return false;
+    }
+    const std::string script_text = script.string(), package_text = package.string(), target = exe.parent_path().string(),
+                      exe_text = exe.string(), progress = g_progress_path.string(), pid_text = std::to_string(getpid());
+    const pid_t pid = fork();
+    if (pid < 0) {
+        error = "cannot start the installer";
+        return false;
+    }
+    if (pid == 0) {
+        setsid();
+        const int null = open("/dev/null", O_RDWR);
+        if (null >= 0) {
+            dup2(null, STDIN_FILENO);
+            dup2(null, STDOUT_FILENO);
+            dup2(null, STDERR_FILENO);
+        }
+        execl("/bin/sh", "sh", script_text.c_str(), pid_text.c_str(), package_text.c_str(), target.c_str(), exe_text.c_str(),
+              progress.c_str(), static_cast<char *>(nullptr));
+        _exit(127);
+    }
+    g_helper = pid;
+    return true;
+}
+
+// Runs on the download's thread: starts the script, then follows what it reports until the update is unpacked.
+void unpack(const std::filesystem::path &package) {
+    set_status([](Status &s) {
+        s.state = State::Unpacking;
+        s.progress = 0.0f;
+        s.error.clear();
+    });
+    std::string error;
+    if (!start_helper(package, error)) {
+        set_status([&](Status &s) {
+            s.state = State::Failed;
+            s.error = error;
+        });
+        return;
+    }
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        int wait_status = 0;
+        const bool stopped = waitpid(g_helper, &wait_status, WNOHANG) == g_helper;
+        const std::string text = read_text(g_progress_path);
+        if (text == "unpacked") {
+            set_status([](Status &s) {
+                s.state = State::Ready;
+                s.progress = 1.0f;
+            });
+            return;
+        }
+        if (text.rfind("failed:", 0) == 0) {
+            set_status([&](Status &s) {
+                s.state = State::Failed;
+                s.error = text.substr(7);
+            });
+            return;
+        }
+        if (stopped) {
+            set_status([](Status &s) {
+                s.state = State::Failed;
+                s.error = "the installer stopped (see d012_update.log in the temp folder)";
+            });
+            return;
+        }
+        const std::size_t slash = text.find('/');
+        if (slash != std::string::npos) {
+            const double done = std::atof(text.substr(0, slash).c_str());
+            const double total = std::atof(text.substr(slash + 1u).c_str());
+            if (total > 0.0) set_status([&](Status &s) { s.progress = static_cast<float>(done / total); });
+        }
+    }
+}
+
+} // namespace
+#endif
+
+void start_download() {
+#if defined(PK_UPDATER_ANDROID)
+    std::string url;
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state != State::Available && g_status.state != State::Failed) return;
+        url = g_zip_url;
+        g_status.state = State::Downloading;
+        g_status.progress = 0.0f;
+        g_status.error.clear();
+    }
+    std::thread(android_download_thread, url).detach();
+#elif defined(PK_UPDATER)
+    std::string url;
+    std::filesystem::path test_zip;
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state != State::Available && g_status.state != State::Failed) return;
+        // D012_UPDATE_TEST_ZIP: a zip already on this disk, unpacked as if it had just been downloaded.
+        if (const char *test = std::getenv("D012_UPDATE_TEST_ZIP"); test != nullptr && *test != '\0') test_zip = test;
+        url = g_zip_url;
+        g_status.state = test_zip.empty() ? State::Downloading : State::Unpacking;
+        g_status.progress = 0.0f;
+        g_status.error.clear();
+    }
+    std::thread([url, test_zip] {
+        if (!test_zip.empty()) {
+            unpack(test_zip);
+            return;
+        }
+        if (url.empty()) {
+            set_status([](Status &s) {
+                s.state = State::Failed;
+                s.error = "the release has no zip to download";
+            });
+            return;
+        }
+        std::error_code ec;
+        const std::filesystem::path zip = std::filesystem::temp_directory_path(ec) /
+#if defined(_WIN32)
+                                           "d012_update.zip";
+#else
+                                           "d012_update.tar.gz";
+#endif
+        std::string error;
+        bool ok = false;
+        {
+            std::ofstream out(zip, std::ios::binary | std::ios::trunc);
+            ok = out && http_get(url, [&](const char *data, std::size_t n) { out.write(data, static_cast<std::streamsize>(n)); },
+                                 [](std::uint64_t done, std::uint64_t total) {
+                                     if (total != 0u)
+                                         set_status([&](Status &s) { s.progress = static_cast<float>(done) / static_cast<float>(total); });
+                                 },
+                                 error);
+        }
+        if (ok) {
+            {
+                const std::lock_guard<std::mutex> lock(g_mutex);
+                g_zip_path = zip;
+            }
+            unpack(zip);
+        } else {
+            std::filesystem::remove(zip, ec);
+            set_status([&](Status &s) {
+                s.state = State::Failed;
+                s.error = error.empty() ? "the download failed" : error;
+            });
+        }
+    }).detach();
+#endif
+}
+
+// The script is already running and waits for the game to close: the caller only has to quit.
+bool launch_installer() {
+#if defined(PK_UPDATER_ANDROID)
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state != State::Ready) return false;
+    }
+    // Hands the downloaded APK to Android's installer, which asks the player to confirm. The app is not closed: Android
+    // replaces it itself when the player confirms. False always, so the caller keeps the dialog (and any reason) on screen.
+    std::string error;
+    const android::InstallResult result = android::update_install(error);
+    set_status([&](Status &s) {
+        if (result == android::InstallResult::Started) s.error = "Android is asking to install the update. Confirm there.";
+        else if (result == android::InstallResult::NeedsPermission)
+            s.error = "Allow this app to install apps in the settings that opened, then come back and tap Install again.";
+        else s.error = error.empty() ? "the installer could not be started" : error;
+    });
+    return false;
+#elif defined(PK_UPDATER)
+    const std::lock_guard<std::mutex> lock(g_mutex);
+#if defined(_WIN32)
+    return g_status.state == State::Ready && g_helper != nullptr;
+#else
+    return g_status.state == State::Ready && g_helper > 0;
+#endif
+#else
+    return false;
+#endif
+}
+
+} // namespace portablekit::ui::updater
diff --git a/host/ui/updater.hpp b/host/ui/updater.hpp
new file mode 100644
index 0000000..b5534c1
--- /dev/null
+++ b/host/ui/updater.hpp
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <string>
+
+// Checks GitHub for a newer release and installs it over the program's own files. The check runs once, on a
+// thread of its own, and only reads the latest release's tag. An install downloads the release's package (a .zip on
+// Windows; a .tar.gz with "linux" or "macos" in its name elsewhere, fetched with curl), has a hidden script unpack it
+// beside the game while the game runs, and once the game has closed the script puts the files over the game's folder,
+// leaving the player's own folders (data, game) alone, and starts the game again. Not on Android.
+namespace portablekit::ui::updater {
+
+enum class State { Idle, Checking, UpToDate, Available, Failed, Downloading, Unpacking, Ready };
+
+struct Status {
+    State state{State::Idle};
+    std::string latest;       // the newest release's tag, e.g. "v1.1"
+    std::string page_url;     // its page on GitHub
+    std::string error;
+    float progress{};         // 0 to 1 while downloading
+};
+
+// Starts the check; ignored while one or a download is running.
+void start_check();
+[[nodiscard]] Status status();
+// Downloads the release's zip on a thread of its own, then has a hidden script unpack it beside the game while it runs
+// (State::Unpacking, with progress); State::Ready when everything is unpacked and waits for the game to close.
+void start_download();
+// The unpacked update is installed by the script once this program has exited, and the game runs again. The caller
+// quits straight after. False when there is nothing ready.
+bool launch_installer();
+
+[[nodiscard]] std::string local_version();
+
+// A file of the latest release: where to download it, how long it is and its "updated_at" stamp (changes when the file is replaced).
+struct AssetInfo {
+    std::string url;
+    std::uint64_t size{};
+    std::string stamp;
+};
+// The file named `name` among the latest release's files; an empty url, with the reason in `error`, when there is none.
+[[nodiscard]] AssetInfo latest_asset(const std::string &name, std::string &error);
+// Its download address only; empty, with the reason in `error`, when there is none.
+[[nodiscard]] std::string latest_asset_url(const std::string &name, std::string &error);
+// Downloads `url` into `target` (through target.part, renamed when it is whole), telling `progress` how much is in. When `expected_size`
+// is above 0 the file must be exactly that long. False with the reason in `error`. Windows, Linux and macOS; the Android app downloads
+// through its own code (platform/android_jni.hpp).
+[[nodiscard]] bool download_file(const std::string &url, const std::filesystem::path &target, std::uint64_t expected_size,
+                                 const std::function<void(std::uint64_t, std::uint64_t)> &progress, std::string &error);
+
+// True when `latest` is a newer release than `local` (git describe text: "v1.0", "v1.0-8-g424ca06-dirty").
+// A build made after a release is not older than it.
+[[nodiscard]] bool is_newer(const std::string &latest, const std::string &local);
+
+} // namespace portablekit::ui::updater
