+namespace {
+
+std::string lower(std::string text) {
+    std::transform(text.begin(), text.end(), text.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return text;
+}
+
+// The value of an HTTP header in an SSDP answer.
+std::string header(const std::string &message, const std::string &name) {
+    const std::string wanted = lower(name) + ":";
+    std::size_t at = 0;
+    while (at < message.size()) {
+        std::size_t end = message.find("\r\n", at);
+        if (end == std::string::npos) end = message.size();
+        const std::string line = message.substr(at, end - at);
+        if (lower(line).compare(0, wanted.size(), wanted) == 0) {
+            std::size_t start = wanted.size();
+            while (start < line.size() && line[start] == ' ') ++start;
+            return line.substr(start);
+        }
+        at = end + 2;
+    }
+    return {};
+}
+
+// The addresses of the devices that answer a search for an Internet Gateway Device.
+std::vector<std::string> search(int timeout_ms) {
+    std::vector<std::string> locations;
+    Socket sock = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (sock == kNoSocket) return locations;
+    sockaddr_in target{};
+    target.sin_family = AF_INET;
+    target.sin_port = htons(1900);
+    inet_pton(AF_INET, "239.255.255.250", &target.sin_addr);
+    for (const char *st : {"urn:schemas-upnp-org:device:InternetGatewayDevice:1", "urn:schemas-upnp-org:device:InternetGatewayDevice:2"}) {
+        const std::string request = std::string("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: \"ssdp:discover\"\r\nMX: 2\r\nST: ") +
+                                    st + "\r\n\r\n";
+        (void)::sendto(sock, request.data(), static_cast<int>(request.size()), 0, reinterpret_cast<const sockaddr *>(&target), sizeof(target));
+    }
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+    while (std::chrono::steady_clock::now() < deadline) {
+        PollEntry entry{};
+        entry.fd = sock;
+        entry.events = POLLIN;
+        if (poll_sockets(&entry, 1, 200) <= 0) continue;
+        char buffer[2048];
+        const int got = static_cast<int>(::recv(sock, buffer, sizeof(buffer) - 1, 0));
+        if (got <= 0) continue;
+        const std::string location = header(std::string(buffer, static_cast<std::size_t>(got)), "LOCATION");
+        if (!location.empty() && std::find(locations.begin(), locations.end(), location) == locations.end())
+            locations.push_back(location);
+    }
+    close_socket(sock);
+    return locations;
+}
+
+// "http://host:port" of a device description's address, the base of the relative control URLs.
+std::string base_of(const HttpUrl &url) { return "http://" + url.host + ":" + url.port; }
+
+// The port mapping service in a device description, or false.
+bool find_service(const std::string &description, const std::string &base, UpnpGateway &out) {
+    std::size_t at = 0;
+    while (true) {
+        const std::size_t open = description.find("<service>", at);
+        if (open == std::string::npos) return false;
+        std::size_t end = description.find("</service>", open);
+        if (end == std::string::npos) return false;
+        const std::string block = description.substr(open, end - open);
+        const std::string type = xml_text(block, "serviceType");
+        if (type.find("WANIPConnection") != std::string::npos || type.find("WANPPPConnection") != std::string::npos) {
+            std::string control = xml_text(block, "controlURL");
+            if (control.empty()) return false;
+            out.service_type = type;
+            out.control_url = control.compare(0, 7, "http://") == 0 ? control : base + (control[0] == '/' ? "" : "/") + control;
+            return true;
+        }
+        at = end;
+    }
+}
+
+} // namespace
+
+bool upnp_find_gateway(UpnpGateway &out, int timeout_ms) {
+    WinsockSession winsock;
+    for (const std::string &location : search(timeout_ms)) {
+        HttpUrl url;
+        if (!parse_http_url(location, url)) continue;
+        std::string local_ip;
+        const std::string request = "GET " + url.path + " HTTP/1.1\r\nHost: " + url.host + ":" + url.port + "\r\nConnection: close\r\n\r\n";
+        const std::string description = http_exchange(url, request, 3000, &local_ip);
+        if (find_service(description, base_of(url), out)) {
+            out.local_ip = local_ip;
+            return !out.local_ip.empty();
+        }
+    }
+    return false;
+}
+
+} // namespace portablekit::adhoc
