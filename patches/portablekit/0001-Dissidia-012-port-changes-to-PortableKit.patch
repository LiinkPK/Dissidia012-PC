@@ -0,0 +1,966 @@
+#include "ui/updater.hpp"
+
+#include "profile.hpp"
+#include "portablekit_version.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <iterator>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <iostream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "app_paths.hpp"
+
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+// Windows, Linux and macOS (not Android, not iOS: an app cannot start curl or replace itself there) have the updater.
+#if defined(_WIN32) || ((defined(__linux__) || (defined(__APPLE__) && !TARGET_OS_IPHONE)) && !defined(__ANDROID__))
+#define PK_UPDATER 1
+#endif
+// Android has its own: the release is read and the APK downloaded in Java, then handed to Android's installer (PK_UPDATER_ANDROID).
+#if defined(__ANDROID__) && defined(PORTABLEKIT_ANDROID_APP)
+#define PK_UPDATER_ANDROID 1
+#include "platform/android_jni.hpp"
+#endif
+#if defined(PK_UPDATER) && !defined(_WIN32)
+#include <fcntl.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#endif
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <winhttp.h>
+#pragma comment(lib, "winhttp.lib")
+#endif
+
+namespace portablekit::ui::updater {
+namespace {
+
+constexpr const char *kLatestApi = "https://api.github.com/repos/LiinkPK/Dissidia012-PC/releases/latest";
+// The mod data (the files of the mods folder, one by one: the app cannot open a zip) is in the emendatus-data release, which is always published: not in the latest release, which is a draft until published.
+constexpr const char *kDataPackApi = "https://api.github.com/repos/LiinkPK/Dissidia012-PC/releases/tags/emendatus-data";
+
+std::string kLocalVersion() {
+    const char *version = portablekit::game().release_version;
+    return version != nullptr && *version != '\0' ? version : portablekit::kBuildVersion;
+}
+
+std::mutex g_mutex;
+Status g_status;
+std::string g_zip_url;
+std::filesystem::path g_zip_path;
+std::uint64_t g_zip_size = 0;  // the package's size as the release lists it (the download's total on Linux and macOS)
+
+void set_status(const std::function<void(Status &)> &change) {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    change(g_status);
+}
+
+std::vector<int> numbers(const std::string &text) {
+    std::vector<int> out;
+    std::size_t i = text.find_first_of("0123456789");
+    while (i != std::string::npos && i < text.size()) {
+        int value = 0;
+        while (i < text.size() && std::isdigit(static_cast<unsigned char>(text[i]))) value = value * 10 + (text[i++] - '0');
+        out.push_back(value);
+        if (i >= text.size() || text[i] != '.') break;
+        ++i;
+    }
+    return out;
+}
+
+// The text of a JSON string value for `key`, the first one after `from`; empty when absent. Enough for GitHub's
+// release record, whose strings these are.
+std::string json_string(const std::string &json, const std::string &key, std::size_t from = 0u) {
+    const std::size_t at = json.find("\"" + key + "\"", from);
+    if (at == std::string::npos) return {};
+    const std::size_t colon = json.find(':', at);
+    const std::size_t open = colon == std::string::npos ? colon : json.find('"', colon);
+    if (open == std::string::npos) return {};
+    std::string value;
+    for (std::size_t i = open + 1; i < json.size() && json[i] != '"'; ++i) {
+        if (json[i] == '\\' && i + 1 < json.size()) ++i;
+        value += json[i];
+    }
+    return value;
+}
+
+#if defined(_WIN32)
+std::wstring wide(const std::string &text) { return std::wstring(text.begin(), text.end()); }
+
+// GETs `url`; the body goes to `sink`, `total` is the length when the server says (else 0). False with the
+// reason in `error`.
+bool http_get(const std::string &url, const std::function<void(const char *, std::size_t)> &sink,
+              const std::function<void(std::uint64_t, std::uint64_t)> &progress, std::string &error) {
+    const std::wstring w = wide(url);
+    URL_COMPONENTSW parts{};
+    parts.dwStructSize = sizeof(parts);
+    wchar_t host[256]{}, path[2048]{};
+    parts.lpszHostName = host;
+    parts.dwHostNameLength = 256;
+    parts.lpszUrlPath = path;
+    parts.dwUrlPathLength = 2048;
+    if (!WinHttpCrackUrl(w.c_str(), 0, 0, &parts)) {
+        error = "bad address";
+        return false;
+    }
+    HINTERNET session = WinHttpOpen(L"Dissidia012-PC-updater", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
+                                    WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+    HINTERNET connection = session ? WinHttpConnect(session, host, parts.nPort, 0) : nullptr;
+    HINTERNET request = connection ? WinHttpOpenRequest(connection, L"GET", path, nullptr, WINHTTP_NO_REFERER,
+                                                        WINHTTP_DEFAULT_ACCEPT_TYPES,
+                                                        parts.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0)
+                                   : nullptr;
+    bool ok = false;
+    if (request && WinHttpSendRequest(request, L"Accept: application/vnd.github+json\r\n", (DWORD)-1L,
+                                      WINHTTP_NO_REQUEST_DATA, 0, 0, 0) &&
+        WinHttpReceiveResponse(request, nullptr)) {
+        DWORD status = 0, size = sizeof(status);
+        WinHttpQueryHeaders(request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                            WINHTTP_HEADER_NAME_BY_INDEX, &status, &size, WINHTTP_NO_HEADER_INDEX);
+        if (status != 200) {
+            error = "HTTP " + std::to_string(status);
+        } else {
+            wchar_t length_text[32]{};
+            size = sizeof(length_text);
+            std::uint64_t total = 0;
+            if (WinHttpQueryHeaders(request, WINHTTP_QUERY_CONTENT_LENGTH, WINHTTP_HEADER_NAME_BY_INDEX, length_text,
+                                    &size, WINHTTP_NO_HEADER_INDEX))
+                total = std::wcstoull(length_text, nullptr, 10);
+            std::vector<char> buffer(64u * 1024u);
+            std::uint64_t done = 0;
+            DWORD got = 0;
+            ok = true;
+            while (WinHttpReadData(request, buffer.data(), (DWORD)buffer.size(), &got) && got != 0) {
+                sink(buffer.data(), got);
+                done += got;
+                if (progress) progress(done, total);
+            }
+        }
+    } else if (error.empty()) {
+        error = "no connection";
+    }
+    if (request) WinHttpCloseHandle(request);
+    if (connection) WinHttpCloseHandle(connection);
+    if (session) WinHttpCloseHandle(session);
+    return ok;
+}
+
+#elif defined(PK_UPDATER)
+// GETs `url` with curl (on macOS and every common Linux; no library to link): the body goes to `sink` as it comes,
+// `progress` is told how much of the expected size is in. False with the reason in `error`.
+bool http_get(const std::string &url, const std::function<void(const char *, std::size_t)> &sink,
+              const std::function<void(std::uint64_t, std::uint64_t)> &progress, std::string &error) {
+    int fds[2];
+    if (pipe(fds) != 0) {
+        error = "no pipe";
+        return false;
+    }
+    const pid_t pid = fork();
+    if (pid < 0) {
+        close(fds[0]);
+        close(fds[1]);
+        error = "cannot start curl";
+        return false;
+    }
+    if (pid == 0) {
+        dup2(fds[1], STDOUT_FILENO);
+        close(fds[0]);
+        close(fds[1]);
+        const int null = open("/dev/null", O_WRONLY);
+        if (null >= 0) dup2(null, STDERR_FILENO);
+        execlp("curl", "curl", "-fsSL", "--retry", "2", "-H", "Accept: application/vnd.github+json", url.c_str(),
+               static_cast<char *>(nullptr));
+        _exit(127);
+    }
+    close(fds[1]);
+    std::vector<char> buffer(64u * 1024u);
+    std::uint64_t done = 0;
+    for (;;) {
+        const ssize_t got = read(fds[0], buffer.data(), buffer.size());
+        if (got <= 0) break;
+        sink(buffer.data(), static_cast<std::size_t>(got));
+        done += static_cast<std::uint64_t>(got);
+        if (progress) progress(done, g_zip_size);
+    }
+    close(fds[0]);
+    int status = 0;
+    waitpid(pid, &status, 0);
+    if (WIFEXITED(status) && WEXITSTATUS(status) == 127) {
+        error = "curl is not installed";
+        return false;
+    }
+    if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+        error = "curl failed (exit " + std::to_string(WIFEXITED(status) ? WEXITSTATUS(status) : -1) + ")";
+        return false;
+    }
+    return true;
+}
+#endif
+
+#if defined(PK_UPDATER_ANDROID)
+// The release record from GitHub, read through Java; the first .apk attached is the package.
+void android_check_thread() {
+    std::string error;
+    const std::optional<std::string> body = android::update_get(kLatestApi, error);
+    const std::string tag = body ? json_string(*body, "tag_name") : std::string();
+    if (tag.empty()) {
+        set_status([&](Status &s) {
+            s.state = State::Failed;
+            s.error = body ? "no release found" : (error.empty() ? "no connection" : error);
+        });
+        return;
+    }
+    const std::string page = json_string(*body, "html_url");
