new file mode 100644
index 0000000..a6433ca
--- /dev/null
+++ b/host/gpu/texture_cache.hpp
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+// A compressed copy of a pack image, kept next to the pack and read instead of
+// the PNG. BC7 is a quarter of the size of RGBA8 in memory and on the GPU, it
+// is sampled as it is, and the mip chain is stored in the file, so loading
+// one is a file read: no PNG decode, no mip blits, a quarter of the upload.
+//
+// The copy is made once, in the background, the first time an image is used;
+// until then the image loads from the PNG as before. A copy is valid only for
+// the PNG it was made from (its size and modification time are stored).
+namespace portablekit::gpu::texture_cache {
+
+// The file is "PKTC", then these, then the levels' blocks, level 0 first.
+struct Header {
+    char magic[4];
+    std::uint32_t version;
+    std::uint32_t format;  // 1: BC7, 16-byte blocks
+    std::uint32_t width;
+    std::uint32_t height;
+    std::uint32_t levels;
+    std::uint64_t source_size;
+    std::int64_t source_time;
+};
+
+struct Image {
+    std::uint32_t width{};
+    std::uint32_t height{};
+    std::uint32_t levels{};
+    std::vector<std::uint8_t> data;           // every level, tightly packed
+    std::vector<std::uint64_t> level_offsets; // byte offset of each level in `data`
+};
+
+// Bytes of one BC7 level.
+[[nodiscard]] std::uint64_t level_bytes(std::uint32_t width, std::uint32_t height) noexcept;
+
+// <folder>/<name with its separators turned into '_'>.bc7
+[[nodiscard]] std::filesystem::path cache_path(const std::filesystem::path &folder, const std::string &name);
+
+// Reads a copy made from `source`; false when there is none, it is stale or it
+// is damaged.
+bool load(const std::filesystem::path &file, const std::filesystem::path &source, Image &out);
+
+// Makes the copy from RGBA8 pixels (red first, rows packed): the mip chain
+// (each level the previous one halved, as the GPU blit did) encoded to BC7,
+// written to a temporary file and renamed. Slow; call it on a background
+// thread.
+bool bake(const std::filesystem::path &file, const std::filesystem::path &source, const std::uint8_t *rgba,
+          std::uint32_t width, std::uint32_t height);
+
+} // namespace portablekit::gpu::texture_cache
