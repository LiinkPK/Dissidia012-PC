+        if (second == std::string::npos) continue;
+        choices.push_back({line->substr(0u, first), line->substr(first + 1u, second - first - 1u),
+                           static_cast<std::uint64_t>(std::strtoull(line->c_str() + second + 1u, nullptr, 10))});
+    }
+    call.env->DeleteLocalRef(array);
+    return choices;
