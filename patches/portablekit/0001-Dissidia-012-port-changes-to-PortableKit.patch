+void Menu::cheats() {
+    const std::lock_guard<std::mutex> lock(cheat_mutex());
+    load_cheats();
+    CheatFile &f = cheat_file();
+    section("Cheats");
+    const bool online = adhoc_online_mode();
+    if (online) info_row("Online", "Cheats are off while you play online. They come back when the session ends.");
+    if (button_row("Open the cheats file",
+                   {false, {}, std::string("Edit ") + portablekit::game().disc_id + ".ini in PSP/CHEATS, in PPSSPP's format."})) {
+        std::error_code ec;
+        std::filesystem::create_directories(f.path.parent_path(), ec);
+        if (!std::filesystem::exists(f.path, ec)) std::ofstream(f.path).put('\n');
+        open_folder(f.path);
+    }
+    if (button_row("Open the cheats folder", {false, {}, "Show the PSP/CHEATS folder."}))
+        open_folder(f.path.parent_path());
+    if (f.heads.empty()) {
+        info_row("Cheats", "None found");
+        return;
+    }
+    static bool show_status = false;  // off by default: the status is a diagnostic, listed after the codes when switched on
+    if (toggle_row("Show status", show_status, {false, {}, "Lists after the codes what each cheat that is on did on its last run."}))
+        show_status = !show_status;
+    section("Codes");
+    for (std::size_t i = 0; i < f.heads.size(); ++i) {
+        std::string &line = f.lines[f.heads[i]];
+        std::string title = line.size() > 3 ? line.substr(3) : std::string();
+        title.erase(0, title.find_first_not_of(" \t"));
+        if (title.empty()) title = "Cheat " + std::to_string(i + 1);
+        ImGui::PushID(static_cast<int>(i));
+        if (toggle_row(title.c_str(), line[2] == '1', {online, {}, online ? "Off while you play online." : ""})) {
+            line[2] = line[2] == '1' ? '0' : '1';
+            save_cheats();
+        }
+        ImGui::PopID();
+    }
+    // What each enabled cheat did on its last run, all together after the codes, and only when asked for.
+    if (show_status) {
+        section("Status");
+        bool any = false;
+        for (std::size_t i = 0; i < f.heads.size(); ++i) {
+            const std::string &line = f.lines[f.heads[i]];
+            if (line[2] != '1') continue;
+            any = true;
+            std::string title = line.size() > 3 ? line.substr(3) : std::string();
+            title.erase(0, title.find_first_not_of(" \t"));
+            if (title.empty()) title = "Cheat " + std::to_string(i + 1);
+            const auto found = cheat_stats().find(i);
+            std::string note;
+            if (online) note = "Off while online";
+            else if (f.codes[i].empty()) note = "No code lines";
+            else if (found == cheat_stats().end()) note = "Not run yet";
+            else if (found->second.unsupported != 0u) note = "Unsupported code type";
+            else if (found->second.skipped != 0u && found->second.writes == 0u) note = "Writes outside game memory";
+            else if (found->second.failed != 0u && found->second.writes == 0u) note = "Conditions not met";
+            else {
+                note = std::to_string(found->second.writes) + " writes per frame";
+                if (found->second.changed != 0u) note += ", " + std::to_string(found->second.changed) + " changed by the game";
+            }
+            info_row(title.c_str(), note);
+        }
+        if (!any) info_row("Status", "No cheat is on");
+    }
+}
