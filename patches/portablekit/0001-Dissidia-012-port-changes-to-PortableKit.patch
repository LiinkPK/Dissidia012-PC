+VkDescriptorSet VulkanRenderer::Impl::text_line_descriptor(const GuestMemory &memory, const DrawCall &call,
+                                                           const Texture &original) {
+    // <prefix>_TEXT_HD_SCALE=N: texels per original texel of a text line (default 3; 0 draws the game's own lines).
+    static const int env_scale = [] {
+        const char *text = portablekit::env("TEXT_HD_SCALE");
+        return text != nullptr ? std::clamp(std::atoi(text), 0, 6) : 3;
+    }();
+    // Text > HD text in the menu turns the redrawn lines off (the game's own lines are drawn).
+    const int scale = settings::current().hd_text ? env_scale : 0;
+    const TextureState &state = call.texture;
+    if (scale == 0 || state.format != TextureFormat::Clut4 || state.width == 0u || state.height == 0u ||
+        state.width > 1024u || state.height > 128u)
+        return VK_NULL_HANDLE;
+    const std::uint32_t address = state.address & 0x0FFFFFFFu;
+
+    // Lines no draw has used for a while give their images back.
+    if (frames % 120u == 0u) {
+        for (auto it = text_lines.begin(); it != text_lines.end();) {
+            if (frames - it->second.last_frame > 240u) {
+                if (async_uploads()) {
+                    slots[slot].retired_textures.push_back(it->second.texture);
+                } else {
+                    queue_wait_idle();
+                    destroy_texture(it->second.texture);
+                }
+                it = text_lines.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    // Every line is an image and a descriptor set of the pool the texture cache shares, and scrolling a long list makes new
+    // lines faster than the 4 seconds above free the old ones. A cap, least recently used out first (never a line drawn in
+    // this very frame), keeps the pool from running out.
+    constexpr std::size_t kMaxTextLines = 512u, kEvictBatch = 48u;
+    if (text_lines.size() >= kMaxTextLines && text_lines.find(address) == text_lines.end()) {
+        std::vector<std::pair<std::uint64_t, std::uint32_t>> oldest;
+        oldest.reserve(text_lines.size());
+        for (const auto &entry : text_lines)
+            if (entry.second.last_frame != frames) oldest.emplace_back(entry.second.last_frame, entry.first);
+        std::sort(oldest.begin(), oldest.end());
+        for (std::size_t i = 0; i < oldest.size() && i < kEvictBatch; ++i) {
+            const auto found = text_lines.find(oldest[i].second);
+            if (async_uploads()) {
+                slots[slot].retired_textures.push_back(found->second.texture);
+            } else {
+                queue_wait_idle();
+                destroy_texture(found->second.texture);
+            }
+            text_lines.erase(found);
+        }
+        // Everything is in use this frame: draw this line with the game's own image.
+        if (text_lines.size() >= kMaxTextLines) return VK_NULL_HANDLE;
+    }
+
+    // A subtitle is told by how it is drawn, like the subtitle rule in submit: centred on the screen near its bottom, not
+    // part of a marked layout, and 18 pixels tall (the game's subtitle text cell; a menu's description at the bottom of
+    // the screen is 14). The heap is no guide: the same menu text lands in a different heap depending on the screen the
+    // menu was entered from, and a battle subtitle is in the menu's heap. An in-battle subtitle is drawn by the AP
+    // Chance / RULES layout (mode 0x14), which leaves it where the game put it, so that layout counts too.
+    // Text > Size shrinks the menus' glyphs; subtitles are sized by Text > Subtitle size alone, so they are always
+    // rendered at the full size here (the glyph shrinking inside the texture and the quad shrinking in the subtitle
+    // rule would otherwise compound).
+    bool subtitle_line = false;
+    if ((!in_hud_layout || hud_mode == 0x14u) && call.through && !call.vertices.empty()) {
+        float left = 1e9f, right = -1e9f, top = 1e9f, bottom = -1e9f;
+        for (const auto &vertex : call.vertices) {
+            left = std::min(left, vertex.position[0]);
+            right = std::max(right, vertex.position[0]);
+            top = std::min(top, vertex.position[1]);
+            bottom = std::max(bottom, vertex.position[1]);
+        }
+        subtitle_line = std::fabs(0.5f * (left + right) - 240.0f) <= 3.0f && bottom >= 190.0f && bottom <= 272.0f &&
