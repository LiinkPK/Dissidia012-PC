+// Downloads the APK in Java while this thread reports its progress; the state is Ready when it is in the cache.
+void android_download_thread(std::string url) {
+    if (url.empty()) {
+        set_status([](Status &s) {
+            s.state = State::Failed;
+            s.error = "the release has no APK to download";
+        });
+        return;
+    }
+    std::atomic<bool> finished{false};
+    std::thread reporter([&] {
+        while (!finished.load()) {
+            std::uint64_t done = 0, total = 0;
+            android::update_progress(done, total);
+            if (total == 0u) total = g_zip_size;
+            if (total != 0u) set_status([&](Status &s) { s.progress = static_cast<float>(done) / static_cast<float>(total); });
+            std::this_thread::sleep_for(std::chrono::milliseconds(250));
+        }
+    });
+    std::string error;
+    const bool ok = android::update_download(url, error);
+    finished = true;
+    reporter.join();
+    set_status([&](Status &s) {
+        if (ok) {
+            s.state = State::Ready;
+            s.progress = 1.0f;
+        } else {
+            s.state = State::Failed;
+            s.error = error.empty() ? "the download failed" : error;
+        }
+    });
+}
