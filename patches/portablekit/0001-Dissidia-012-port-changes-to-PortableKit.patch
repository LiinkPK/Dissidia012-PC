new file mode 100644
index 0000000..56a7a53
--- /dev/null
+++ b/host/hle/hle_adhoc_matching.hpp
@@ -0,0 +1,60 @@
+#pragma once
+
+// sceNetAdhocMatching on top of the ad hoc client's PDP sockets (adhoc/matching.hpp holds the protocol).
+#include "adhoc/matching.hpp"
+#include "hle_common.hpp"
+
+#include <array>
+#include <deque>
+#include <map>
+#include <memory>
+#include <string>
+
+namespace portablekit::matching_hle {
+
+struct Entry;
+
+// What a context's protocol code uses: the client's PDP socket, the group's members and a queue of events.
+struct EntryIo final : adhoc::matching::Io {
+    Entry *owner{};
+    void send(const adhoc::Mac &to, std::uint16_t port, const std::string &bytes) override;
+    std::vector<adhoc::Mac> group() override;
+    void post(int event, const adhoc::Mac &from, const std::string &opt) override;
+    std::uint64_t now_us() override;
+};
+
+struct PendingEvent {
+    int event{};
+    adhoc::Mac from{};
+    std::string opt;
+};
+
+struct Entry {
+    EntryIo io;
+    std::unique_ptr<adhoc::matching::Context> context;
+    std::uint32_t callback{}; // the game's handler
+    int pdp{};                // the client's socket handle, 0 while not started
+    std::deque<PendingEvent> events;
+};
+
+struct State {
+    bool initialized{};
+    bool hooked{};
+    std::map<int, std::unique_ptr<Entry>> contexts;
+};
+
+[[nodiscard]] State &state();
+[[nodiscard]] Entry *find_entry(int id);
+
+// Receives datagrams, runs the timers and hands the events to the game's handlers. Runs once per vblank.
+void pump();
+// Opens the socket and starts the context. Returns 0 or an error code.
+[[nodiscard]] std::uint32_t start_entry(Entry &entry, std::string hello);
+void stop_entry(Entry &entry);
+
+[[nodiscard]] adhoc::Mac read_mac(const psprecomp::GuestMemory &memory, std::uint32_t address);
+[[nodiscard]] std::string read_bytes(const psprecomp::GuestMemory &memory, std::uint32_t address, std::uint32_t length);
+
+void register_api(HleRegistrar &hle);
+
+} // namespace portablekit::matching_hle
diff --git a/host/hle/hle_adhoc_matching_api.cpp b/host/hle/hle_adhoc_matching_api.cpp
new file mode 100644
index 0000000..4be414e
--- /dev/null
+++ b/host/hle/hle_adhoc_matching_api.cpp
@@ -0,0 +1,184 @@
+#include "hle_adhoc_matching.hpp"
+
+#include "adhoc/client.hpp"
+#include "kernel/kernel.hpp"
+
+#include <cstdio>
+
+namespace portablekit {
+
+adhoc::Mac adhoc_own_mac();
+
+namespace matching_hle {
+
+namespace {
+
+namespace err = adhoc::matching::error;
+using adhoc::matching::Mode;
+
+constexpr int kMaxContexts = 15;
+
+// The functions answer with the result in v0; a negative value is an error code.
+void answer(AllegrexContext &ctx, std::uint32_t result) { kernel().finish(ctx, result); }
+
+} // namespace
+
+void register_api(HleRegistrar &hle) {
+    constexpr const char *kModule = "sceNetAdhocMatching";
+
+    // <prefix>_TRACE_ADHOC=1 (trace only): every matching call with its first four arguments and its result.
+    const auto add = [&hle, kModule](const char *name, HleFunction function) {
+        hle.add(kModule, name, [name, function = std::move(function)](Runtime &runtime, AllegrexContext &ctx) {
+            function(runtime, ctx);
+            if (adhoc::Client::tracing())
+                std::fprintf(stderr, "[adhoc] %s(0x%08X, 0x%08X, 0x%08X, 0x%08X) = 0x%08X\n", name, ctx.gpr[4], ctx.gpr[5],
+                             ctx.gpr[6], ctx.gpr[7], ctx.gpr[2]);
+        });
+    };
+
+    add("sceNetAdhocMatchingInit", [](Runtime &, AllegrexContext &ctx) {
+        if (state().initialized) return answer(ctx, err::kAlreadyInitialized);
+        state().initialized = true;
+        answer(ctx, 0u);
+    });
+
+    add("sceNetAdhocMatchingTerm", [](Runtime &, AllegrexContext &ctx) {
+        for (auto &[id, entry] : state().contexts) stop_entry(*entry);
+        state().contexts.clear();
+        state().initialized = false;
+        answer(ctx, 0u);
+    });
+
+    // (mode, maxnum, port, rxbuflen, hello_int, keepalive_int, init_count, rexmt_int, handler)
+    add("sceNetAdhocMatchingCreate", [](Runtime &runtime, AllegrexContext &ctx) {
+        if (!state().initialized) return answer(ctx, err::kNotInitialized);
+        const auto mode = static_cast<int>(arg(ctx, 0));
+        const auto maxnum = static_cast<int>(arg(ctx, 1));
+        const auto port = static_cast<std::uint16_t>(arg(ctx, 2));
+        const auto rxbuflen = static_cast<std::int32_t>(arg(ctx, 3));
+        const std::uint32_t hello_int = arg(ctx, 4);
+        const std::uint32_t keepalive_int = arg(ctx, 5);
+        const auto init_count = static_cast<std::int32_t>(arg(ctx, 6));
+        const std::uint32_t rexmt_int = arg(ctx, 7);
+        // The ninth argument is on the stack, at sp+0: the eight registers a0-a3 and t0-t3 carry the others (t4 holds a leftover value).
+        const std::uint32_t handler = runtime.memory().load32(ctx.gpr[29]);
+        if (maxnum <= 1 || maxnum > 16) return answer(ctx, err::kInvalidMaxnum);
+        if (rxbuflen < 6 * maxnum + 4) return answer(ctx, err::kRxbufTooShort);
+        if (rxbuflen > 1024 * 1024) return answer(ctx, err::kNoSpace);
+        if (mode < 1 || mode > 3) return answer(ctx, err::kInvalidMode);
+        const bool announces = mode == 1 || mode == 3;
+        if ((announces && (hello_int == 0u || keepalive_int == 0u)) || init_count < 0 || rexmt_int == 0u)
+            return answer(ctx, err::kInvalidArg);
+        for (const auto &[id, other] : state().contexts)
+            if (other->context->config().port == port) return answer(ctx, err::kPortInUse);
+        if (static_cast<int>(state().contexts.size()) >= kMaxContexts) return answer(ctx, err::kIdNotAvail);
+        int id = 1;
+        while (state().contexts.count(id) != 0u) ++id;
+
+        adhoc::matching::Config config;
+        config.id = id;
+        config.mode = static_cast<Mode>(mode);
+        config.maxpeers = maxnum;
+        config.port = port;
+        config.rxbuflen = static_cast<std::uint32_t>(rxbuflen);
+        config.hello_us = hello_int;
+        config.keepalive_us = keepalive_int != 0u ? keepalive_int : 5'000'000u;
+        config.init_count = init_count;
+        config.rexmt_us = rexmt_int;
+        config.mac = adhoc_own_mac();
+        auto entry = std::make_unique<Entry>();
+        entry->io.owner = entry.get();
+        entry->callback = handler;
+        entry->context = std::make_unique<adhoc::matching::Context>(config, entry->io);
+        state().contexts[id] = std::move(entry);
+        answer(ctx, static_cast<std::uint32_t>(id));
+    });
+
+    // (id, evthPri, evthStack, inthPri, inthStack, optLen, optData): the priorities and stacks are for threads the
+    // game's PSP would have had; the events come from the vblank hook here.
+    add("sceNetAdhocMatchingStart", [](Runtime &rt, AllegrexContext &ctx) {
+        Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
+        if (entry == nullptr) return answer(ctx, err::kInvalidId);
+        if (entry->context->running()) return answer(ctx, err::kIsRunning);
+        const std::uint32_t opt_length = arg(ctx, 5);
+        const std::uint32_t opt = arg(ctx, 6);
+        std::string hello;
+        if (opt_length > 0u && opt != 0u) hello = read_bytes(rt.memory(), opt, opt_length);
+        answer(ctx, start_entry(*entry, std::move(hello)));
+    });
+
+    add("sceNetAdhocMatchingStop", [](Runtime &, AllegrexContext &ctx) {
+        Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
+        if (entry == nullptr) return answer(ctx, err::kInvalidId);
+        if (!entry->context->running()) return answer(ctx, err::kNotRunning);
+        stop_entry(*entry);
+        answer(ctx, 0u);
+    });
+
+    add("sceNetAdhocMatchingDelete", [](Runtime &, AllegrexContext &ctx) {
+        const auto id = static_cast<int>(arg(ctx, 0));
+        Entry *entry = find_entry(id);
+        if (entry == nullptr) return answer(ctx, err::kInvalidId);
+        if (entry->context->running()) return answer(ctx, err::kIsRunning);
+        state().contexts.erase(id);
+        answer(ctx, 0u);
+    });
+
+    // (id, optLen, optData)
+    add("sceNetAdhocMatchingSetHelloOpt", [](Runtime &rt, AllegrexContext &ctx) {
+        Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
+        if (entry == nullptr) return answer(ctx, err::kInvalidId);
+        const std::uint32_t length = arg(ctx, 1);
+        const std::uint32_t data = arg(ctx, 2);
+        if (length > 0u && data == 0u) return answer(ctx, err::kInvalidOptlen);
+        entry->context->set_hello(length > 0u ? read_bytes(rt.memory(), data, length) : std::string{});
+        answer(ctx, 0u);
+    });
+
+    // (id, mac*, optLen, optData)
+    add("sceNetAdhocMatchingSelectTarget", [](Runtime &rt, AllegrexContext &ctx) {
+        if (!state().initialized) return answer(ctx, err::kNotInitialized);
+        if (arg(ctx, 1) == 0u) return answer(ctx, err::kInvalidArg);
+        Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
+        if (entry == nullptr) return answer(ctx, err::kInvalidId);
+        const std::uint32_t length = arg(ctx, 2);
+        if (length != 0u && arg(ctx, 3) == 0u) return answer(ctx, err::kInvalidOptlen);
+        const std::string opt = length > 0u ? read_bytes(rt.memory(), arg(ctx, 3), length) : std::string{};
+        answer(ctx, entry->context->select_target(read_mac(rt.memory(), arg(ctx, 1)), opt));
+    });
+
+    const auto cancel = [](Runtime &rt, AllegrexContext &ctx, bool with_opt) {
+        if (!state().initialized) return answer(ctx, err::kNotInitialized);
+        if (arg(ctx, 1) == 0u) return answer(ctx, err::kInvalidArg);
+        Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
+        if (entry == nullptr) return answer(ctx, err::kInvalidId);
+        const std::uint32_t length = with_opt ? arg(ctx, 2) : 0u;
+        if (length != 0u && arg(ctx, 3) == 0u) return answer(ctx, err::kInvalidArg);
+        const std::string opt = length > 0u ? read_bytes(rt.memory(), arg(ctx, 3), length) : std::string{};
+        answer(ctx, entry->context->cancel_target(read_mac(rt.memory(), arg(ctx, 1)), opt));
+    };
+    add("sceNetAdhocMatchingCancelTarget",
+            [cancel](Runtime &rt, AllegrexContext &ctx) { cancel(rt, ctx, false); });
+    add("sceNetAdhocMatchingCancelTargetWithOpt",
+            [cancel](Runtime &rt, AllegrexContext &ctx) { cancel(rt, ctx, true); });
+
+    // (id, mac*, dataLen, data)
+    add("sceNetAdhocMatchingSendData", [](Runtime &rt, AllegrexContext &ctx) {
+        if (!state().initialized) return answer(ctx, err::kNotInitialized);
+        if (arg(ctx, 1) == 0u) return answer(ctx, err::kInvalidArg);
+        Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
+        if (entry == nullptr) return answer(ctx, err::kInvalidId);
+        const std::uint32_t length = arg(ctx, 2);
+        if (static_cast<std::int32_t>(length) <= 0 || arg(ctx, 3) == 0u) return answer(ctx, err::kInvalidDatalen);
+        answer(ctx, entry->context->send_data(read_mac(rt.memory(), arg(ctx, 1)), read_bytes(rt.memory(), arg(ctx, 3), length)));
+    });
+
+    // Data goes out at once and in order, so there is nothing left to abort.
