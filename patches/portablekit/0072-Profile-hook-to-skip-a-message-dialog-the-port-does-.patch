From 6cd813821e9988ba057ddb8aeb4d70a11292ee43 Mon Sep 17 00:00:00 2001
From: LiinkPK <linkgarciafiverr@gmail.com>
Date: Sat, 31 Oct 2026 19:17:57 +0100
Subject: [PATCH 72/74] Profile hook to skip a message dialog the port does not
 want shown

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 host/hle/hle_utility.cpp | 4 ++++
 host/profile.hpp         | 3 +++
 2 files changed, 7 insertions(+)

diff --git a/host/hle/hle_utility.cpp b/host/hle/hle_utility.cpp
index 59780e2..9515514 100644
--- a/host/hle/hle_utility.cpp
+++ b/host/hle/hle_utility.cpp
@@ -511,6 +511,10 @@ void msg_close_ui() {
 // or nobody yet.
 void msg_ask(const std::string &text, bool question, bool default_no, bool allow_back) {
     MsgDialogState &state = msg_state();
+    if (!question && game().skip_message_dialog != nullptr && game().skip_message_dialog(text)) {
+        msg_set_answer(msg::kPressedYes, "profile");
+        return;
+    }
     if (msgdialog_instant()) {
         msg_set_answer(question ? msg::kPressedNo : msg::kPressedYes, "MSGDIALOG_INSTANT");
         return;
diff --git a/host/profile.hpp b/host/profile.hpp
index a67ba31..4febd7e 100644
--- a/host/profile.hpp
+++ b/host/profile.hpp
@@ -250,6 +250,9 @@ struct GameProfile {
     // Called whenever the guest flushes the instruction cache, which is how it
     // announces code it has just copied into memory. Null means no reaction.
     void (*on_code_flushed)(psprecomp::Runtime &) = nullptr;
+    // Asked with the text of each message dialog the game opens. True: the dialog is answered "OK" at once and
+    // never drawn, for a notice a port does not want to show. Null: every dialog is shown.
+    bool (*skip_message_dialog)(std::string_view text) = nullptr;
     // Offered an instruction the recompiled code stopped at, before the overlay machinery looks at it. True:
     // the game handled it (ran it itself and moved the program counter on). Null: nothing to offer.
     bool (*unsupported_instruction)(psprecomp::Runtime &, psprecomp::AllegrexContext &, std::uint32_t pc,
-- 
