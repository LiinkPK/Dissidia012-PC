From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Thu, 19 Nov 2026 00:00:00 +0100
Subject: [PATCH] Ad hoc matching calls are traced

Trace only: with <prefix>_TRACE_ADHOC=1 every sceNetAdhocMatching call logs its name, its first four arguments and its result, the way the other ad hoc calls do. The events the game receives were logged but not what it answered, so a join that stalled after the request could not be followed. Nothing changes without the switch.
---

diff --git a/host/hle/hle_adhoc_matching_api.cpp b/host/hle/hle_adhoc_matching_api.cpp
index 20acf09..4be414e 100644
--- a/host/hle/hle_adhoc_matching_api.cpp
+++ b/host/hle/hle_adhoc_matching_api.cpp
@@ -3,6 +3,8 @@
 #include "adhoc/client.hpp"
 #include "kernel/kernel.hpp"
 
+#include <cstdio>
+
 namespace portablekit {
 
 adhoc::Mac adhoc_own_mac();
@@ -24,13 +26,23 @@ void answer(AllegrexContext &ctx, std::uint32_t result) { kernel().finish(ctx, r
 void register_api(HleRegistrar &hle) {
     constexpr const char *kModule = "sceNetAdhocMatching";
 
-    hle.add(kModule, "sceNetAdhocMatchingInit", [](Runtime &, AllegrexContext &ctx) {
+    // <prefix>_TRACE_ADHOC=1 (trace only): every matching call with its first four arguments and its result.
+    const auto add = [&hle, kModule](const char *name, HleFunction function) {
+        hle.add(kModule, name, [name, function = std::move(function)](Runtime &runtime, AllegrexContext &ctx) {
+            function(runtime, ctx);
+            if (adhoc::Client::tracing())
+                std::fprintf(stderr, "[adhoc] %s(0x%08X, 0x%08X, 0x%08X, 0x%08X) = 0x%08X\n", name, ctx.gpr[4], ctx.gpr[5],
+                             ctx.gpr[6], ctx.gpr[7], ctx.gpr[2]);
+        });
+    };
+
+    add("sceNetAdhocMatchingInit", [](Runtime &, AllegrexContext &ctx) {
         if (state().initialized) return answer(ctx, err::kAlreadyInitialized);
         state().initialized = true;
         answer(ctx, 0u);
     });
 
-    hle.add(kModule, "sceNetAdhocMatchingTerm", [](Runtime &, AllegrexContext &ctx) {
+    add("sceNetAdhocMatchingTerm", [](Runtime &, AllegrexContext &ctx) {
         for (auto &[id, entry] : state().contexts) stop_entry(*entry);
         state().contexts.clear();
         state().initialized = false;
@@ -38,7 +50,7 @@ void register_api(HleRegistrar &hle) {
     });
 
     // (mode, maxnum, port, rxbuflen, hello_int, keepalive_int, init_count, rexmt_int, handler)
-    hle.add(kModule, "sceNetAdhocMatchingCreate", [](Runtime &runtime, AllegrexContext &ctx) {
+    add("sceNetAdhocMatchingCreate", [](Runtime &runtime, AllegrexContext &ctx) {
         if (!state().initialized) return answer(ctx, err::kNotInitialized);
         const auto mode = static_cast<int>(arg(ctx, 0));
         const auto maxnum = static_cast<int>(arg(ctx, 1));
@@ -84,7 +96,7 @@ void register_api(HleRegistrar &hle) {
 
     // (id, evthPri, evthStack, inthPri, inthStack, optLen, optData): the priorities and stacks are for threads the
     // game's PSP would have had; the events come from the vblank hook here.
-    hle.add(kModule, "sceNetAdhocMatchingStart", [](Runtime &rt, AllegrexContext &ctx) {
+    add("sceNetAdhocMatchingStart", [](Runtime &rt, AllegrexContext &ctx) {
         Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
         if (entry == nullptr) return answer(ctx, err::kInvalidId);
         if (entry->context->running()) return answer(ctx, err::kIsRunning);
@@ -95,7 +107,7 @@ void register_api(HleRegistrar &hle) {
         answer(ctx, start_entry(*entry, std::move(hello)));
     });
 
-    hle.add(kModule, "sceNetAdhocMatchingStop", [](Runtime &, AllegrexContext &ctx) {
+    add("sceNetAdhocMatchingStop", [](Runtime &, AllegrexContext &ctx) {
         Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
         if (entry == nullptr) return answer(ctx, err::kInvalidId);
         if (!entry->context->running()) return answer(ctx, err::kNotRunning);
@@ -103,7 +115,7 @@ void register_api(HleRegistrar &hle) {
         answer(ctx, 0u);
     });
 
-    hle.add(kModule, "sceNetAdhocMatchingDelete", [](Runtime &, AllegrexContext &ctx) {
+    add("sceNetAdhocMatchingDelete", [](Runtime &, AllegrexContext &ctx) {
         const auto id = static_cast<int>(arg(ctx, 0));
         Entry *entry = find_entry(id);
         if (entry == nullptr) return answer(ctx, err::kInvalidId);
@@ -113,7 +125,7 @@ void register_api(HleRegistrar &hle) {
     });
 
     // (id, optLen, optData)
-    hle.add(kModule, "sceNetAdhocMatchingSetHelloOpt", [](Runtime &rt, AllegrexContext &ctx) {
+    add("sceNetAdhocMatchingSetHelloOpt", [](Runtime &rt, AllegrexContext &ctx) {
         Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
         if (entry == nullptr) return answer(ctx, err::kInvalidId);
         const std::uint32_t length = arg(ctx, 1);
@@ -124,7 +136,7 @@ void register_api(HleRegistrar &hle) {
     });
 
     // (id, mac*, optLen, optData)
-    hle.add(kModule, "sceNetAdhocMatchingSelectTarget", [](Runtime &rt, AllegrexContext &ctx) {
+    add("sceNetAdhocMatchingSelectTarget", [](Runtime &rt, AllegrexContext &ctx) {
         if (!state().initialized) return answer(ctx, err::kNotInitialized);
         if (arg(ctx, 1) == 0u) return answer(ctx, err::kInvalidArg);
         Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
@@ -145,13 +157,13 @@ void register_api(HleRegistrar &hle) {
         const std::string opt = length > 0u ? read_bytes(rt.memory(), arg(ctx, 3), length) : std::string{};
         answer(ctx, entry->context->cancel_target(read_mac(rt.memory(), arg(ctx, 1)), opt));
     };
-    hle.add(kModule, "sceNetAdhocMatchingCancelTarget",
+    add("sceNetAdhocMatchingCancelTarget",
             [cancel](Runtime &rt, AllegrexContext &ctx) { cancel(rt, ctx, false); });
-    hle.add(kModule, "sceNetAdhocMatchingCancelTargetWithOpt",
+    add("sceNetAdhocMatchingCancelTargetWithOpt",
             [cancel](Runtime &rt, AllegrexContext &ctx) { cancel(rt, ctx, true); });
 
     // (id, mac*, dataLen, data)
-    hle.add(kModule, "sceNetAdhocMatchingSendData", [](Runtime &rt, AllegrexContext &ctx) {
+    add("sceNetAdhocMatchingSendData", [](Runtime &rt, AllegrexContext &ctx) {
         if (!state().initialized) return answer(ctx, err::kNotInitialized);
         if (arg(ctx, 1) == 0u) return answer(ctx, err::kInvalidArg);
         Entry *entry = find_entry(static_cast<int>(arg(ctx, 0)));
@@ -162,7 +174,7 @@ void register_api(HleRegistrar &hle) {
     });
 
     // Data goes out at once and in order, so there is nothing left to abort.
-    hle.add(kModule, "sceNetAdhocMatchingAbortSendData", [](Runtime &, AllegrexContext &ctx) {
+    add("sceNetAdhocMatchingAbortSendData", [](Runtime &, AllegrexContext &ctx) {
         if (!state().initialized) return answer(ctx, err::kNotInitialized);
         answer(ctx, find_entry(static_cast<int>(arg(ctx, 0))) == nullptr ? err::kInvalidId : 0u);
     });
-- 
