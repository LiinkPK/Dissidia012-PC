From b97e965ac2665c37de629cc9de02a5fe373e885d Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Sun, 22 Nov 2026 15:11:13 +0100
Subject: [PATCH] Lower when behind and Fast loading are fixed On, and numpad 0
 is Normal speed

Both rows are hidden and enforce_fixed_settings turns them on whatever settings.ini or an environment variable says, so every player runs
with the same values. Numpad 0 returns Game speed to Normal.
---
 host/gpu/vulkan_renderer.cpp | 6 +++---
 host/settings/settings.cpp   | 3 +++
 host/ui/menu.cpp             | 8 +++++---
 3 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index 6af87bd..661f57a 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -7545,14 +7545,14 @@ bool VulkanRenderer::pump_events() {
 #endif
         if (event.type == SDL_EVENT_KEY_DOWN && event.key.key == SDLK_F3 && !event.key.repeat && impl_->overlay_ready)
             impl_->overlay_visible = !impl_->overlay_visible;
-        // Numpad 1, 2 and 3: Game speed 2x, 4x and 8x; the same key again goes back to Normal. Not online (the speed is locked there)
+        // Numpad 1, 2 and 3: Game speed 2x, 4x and 8x; the same key again, or numpad 0, goes back to Normal. Not online (the speed is locked there)
         // and not while a text field is being typed in.
         if (event.type == SDL_EVENT_KEY_DOWN && !event.key.repeat && !SDL_TextInputActive(impl_->window) && !adhoc_online_mode()) {
-            const std::uint32_t wanted = event.key.key == SDLK_KP_1 ? 2u : event.key.key == SDLK_KP_2 ? 4u : event.key.key == SDLK_KP_3 ? 8u : 0u;
+            const std::uint32_t wanted = event.key.key == SDLK_KP_0 ? 1u : event.key.key == SDLK_KP_1 ? 2u : event.key.key == SDLK_KP_2 ? 4u : event.key.key == SDLK_KP_3 ? 8u : 0u;
             if (wanted != 0u) {
                 settings::Settings &s = settings::current();
                 s.unthrottled = false;
-                s.game_speed = s.game_speed == wanted ? 1u : wanted;
+                s.game_speed = s.game_speed == wanted ? 1u : wanted;  // numpad 0 (wanted 1) is always Normal
                 std::printf("[speed] game speed %ux
 ", s.game_speed);
                 std::fflush(stdout);
diff --git a/host/settings/settings.cpp b/host/settings/settings.cpp
index 88f1582..7709e09 100644
--- a/host/settings/settings.cpp
+++ b/host/settings/settings.cpp
@@ -521,6 +521,9 @@ void enforce_fixed_settings(Settings &values) {
     values.sharp_screen = false;
     values.sharp_textures = false;
     values.menu_pause_multiplayer = false;
+    // Lower when behind and Fast loading are always on, for everyone, so online players never disagree on them.
+    values.frame_rate_auto = true;
+    values.fast_loading = true;
 }
 
 void load(State &s) {
diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index 031557d..928a6cd 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -799,7 +799,9 @@ void Menu::video() {
             settings::save();
         }
     }
-    {
+    // Lower when behind and Fast loading are fixed (On: see settings.cpp enforce_fixed_settings). Their rows are kept, hidden.
+    constexpr bool kShowFixedRows = false;
+    if (kShowFixedRows) {
         RowOptions o = options_for("video.frame_rate_auto",
                                    "On lowers the frame rate by itself when presenting that often would slow the "
                                    "game. Off keeps the chosen rate, and the game may then run below full speed.");
@@ -814,7 +816,7 @@ void Menu::video() {
         const bool online = adhoc_online_mode();
         RowOptions o = options_for("video.unthrottled", "Normal holds the game to real time. 2x, 4x and 8x run it that "
                                                         "many times faster (sound off); Unlimited as fast as frames can be "
-                                                        "drawn. Numpad 1, 2 and 3 switch to 2x, 4x and 8x without the menu.");
+                                                        "drawn. Numpad 1, 2 and 3 switch to 2x, 4x and 8x without the menu, and 0 back to Normal.");
         if (online) {
             o.disabled = true;
             o.note = "Locked to Normal while you play online";
@@ -828,7 +830,7 @@ void Menu::video() {
             settings::save();
         }
     }
-    {
+    if (kShowFixedRows) {
         RowOptions o = options_for("video.fast_loading",
                                    "Lets the game run ahead of real time while it loads and is silent, so loads "
                                    "take as long as the computer needs. Never during play, sound, movies or "
-- 
