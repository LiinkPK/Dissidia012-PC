From 222f47b86a153d410322be845a40279f905fcc2a Mon Sep 17 00:00:00 2001
From: LiinkPK <linkgarciafiverr@gmail.com>
Date: Mon, 9 Nov 2026 18:30:59 +0100
Subject: [PATCH] A window size that does not fit the desktop opens, and comes
 back from full screen, maximized (title bar and taskbar in view) instead of
 shrunk

---
 host/gpu/vulkan_renderer.cpp | 30 ++++++++++++++++++------------
 1 file changed, 18 insertions(+), 12 deletions(-)

diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index a887780..6584e5b 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -745,21 +745,22 @@ bool write_png(const std::string &path, const std::uint8_t *pixels, std::uint32_
     return ok;
 }
 
-// The size of a window of `scale` times the PSP picture, shrunk (in the picture's proportions) to fit the display's usable
-// area, which is the desktop without the taskbar, with room for the window's frame. A 4x window is 1920x1088: it does not
-// fit a 1080p desktop, so its title bar went off the top of the screen and it covered the taskbar.
-void windowed_size(SDL_DisplayID display, std::uint32_t scale, int &width, int &height) {
+// The size of a window of `scale` times the PSP picture, and whether it fits the display's usable area (the desktop without
+// the taskbar) with room for the window's frame. A 4x window is 1920x1088 and does not fit a 1080p desktop: its title bar went
+// off the top of the screen and it covered the taskbar. Such a window is maximized instead (the title bar and the taskbar
+// stay in view); the size returned, shrunk in the picture's proportions, is what it restores to.
+bool windowed_size(SDL_DisplayID display, std::uint32_t scale, int &width, int &height) {
     width = static_cast<int>(kPspWidth * scale);
     height = static_cast<int>(kPspHeight * scale);
     SDL_Rect usable{};
-    if (display == 0u || !SDL_GetDisplayUsableBounds(display, &usable) || usable.w <= 0 || usable.h <= 0) return;
+    if (display == 0u || !SDL_GetDisplayUsableBounds(display, &usable) || usable.w <= 0 || usable.h <= 0) return true;
     constexpr int kFrameWidth = 16, kFrameHeight = 48;  // borders and title bar, not known before the window exists
     const float fit = std::min(1.0f, std::min(static_cast<float>(usable.w - kFrameWidth) / static_cast<float>(width),
                                               static_cast<float>(usable.h - kFrameHeight) / static_cast<float>(height)));
-    if (fit < 1.0f) {
-        width = std::max(static_cast<int>(static_cast<float>(width) * fit), 1);
-        height = std::max(static_cast<int>(static_cast<float>(height) * fit), 1);
-    }
+    if (fit >= 1.0f) return true;
+    width = std::max(static_cast<int>(static_cast<float>(width) * fit), 1);
+    height = std::max(static_cast<int>(static_cast<float>(height) * fit), 1);
+    return false;
 }
 
 // Back from full screen to a normal window: with its frame (and so the taskbar visible), resizable, at the player's window
@@ -772,9 +773,11 @@ void leave_fullscreen(SDL_Window *window) {
     SDL_SetWindowResizable(window, true);
     const std::uint32_t scale = std::clamp<std::uint32_t>(settings::current().window_scale, 1u, settings::kMaxWindowScale);
     int width = 0, height = 0;
-    windowed_size(SDL_GetDisplayForWindow(window), scale, width, height);
+    const bool fits = windowed_size(SDL_GetDisplayForWindow(window), scale, width, height);
+    SDL_RestoreWindow(window);
     SDL_SetWindowSize(window, width, height);
     SDL_SetWindowPosition(window, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED);
+    if (!fits) SDL_MaximizeWindow(window);
     SDL_SyncWindow(window);
 }
 
@@ -3010,7 +3013,8 @@ bool VulkanRenderer::initialize(const RendererConfig &config, std::string &error
     window_flags |= SDL_WINDOW_FULLSCREEN;
 #endif
     int window_width = 0, window_height = 0;
-    windowed_size(SDL_GetPrimaryDisplay(), window_scale, window_width, window_height);
+    if (!windowed_size(SDL_GetPrimaryDisplay(), window_scale, window_width, window_height))
+        window_flags |= SDL_WINDOW_MAXIMIZED;
     impl.window = SDL_CreateWindow(config.title.c_str(), window_width, window_height, window_flags);
     if (impl.window == nullptr) {
         error = std::string("SDL_CreateWindow failed: ") + SDL_GetError();
@@ -7606,8 +7610,10 @@ void VulkanRenderer::set_window_scale(std::uint32_t scale) {
     scale = std::clamp<std::uint32_t>(scale, 1u, settings::kMaxWindowScale);
     if ((SDL_GetWindowFlags(impl_->window) & SDL_WINDOW_FULLSCREEN) != 0u) return;
     int width = 0, height = 0;
-    windowed_size(SDL_GetDisplayForWindow(impl_->window), scale, width, height);
+    const bool fits = windowed_size(SDL_GetDisplayForWindow(impl_->window), scale, width, height);
+    SDL_RestoreWindow(impl_->window);
     SDL_SetWindowSize(impl_->window, width, height);
+    if (!fits) SDL_MaximizeWindow(impl_->window);
     impl_->swapchain_dirty = true;
 }
 
-- 
