@@ -202,6 +207,79 @@ bool http_get(const std::string &url, const std::function<void(const char *, std
 }
 #endif
 
+#if defined(PK_UPDATER_ANDROID)
+// The release record from GitHub, read through Java; the first .apk attached is the package.
+void android_check_thread() {
+    std::string error;
+    const std::optional<std::string> body = android::update_get(kLatestApi, error);
+    const std::string tag = body ? json_string(*body, "tag_name") : std::string();
+    if (tag.empty()) {
+        set_status([&](Status &s) {
+            s.state = State::Failed;
+            s.error = body ? "no release found" : (error.empty() ? "no connection" : error);
+        });
+        return;
+    }
+    const std::string page = json_string(*body, "html_url");
+    std::string apk;
+    std::uint64_t size = 0;
+    for (std::size_t at = body->find("\"browser_download_url\""); at != std::string::npos;
+         at = body->find("\"browser_download_url\"", at + 1u)) {
+        const std::string url = json_string(*body, "browser_download_url", at);
+        if (url.size() > 4u && url.compare(url.size() - 4u, 4u, ".apk") == 0) {
+            apk = url;
+            const std::size_t size_at = body->rfind("\"size\":", at);
+            size = size_at == std::string::npos ? 0u : std::strtoull(body->c_str() + size_at + 7u, nullptr, 10);
+            break;
+        }
+    }
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        g_zip_url = apk;
+        g_zip_size = size;
+    }
+    set_status([&](Status &s) {
+        s.latest = tag;
+        s.page_url = page.empty() ? "https://github.com/LiinkPK/Dissidia012-PC/releases/latest" : page;
+        s.state = is_newer(tag, kLocalVersion()) ? State::Available : State::UpToDate;
+    });
+}
+
+// Downloads the APK in Java while this thread reports its progress; the state is Ready when it is in the cache.
+void android_download_thread(std::string url) {
+    if (url.empty()) {
+        set_status([](Status &s) {
+            s.state = State::Failed;
+            s.error = "the release has no APK to download";
+        });
+        return;
+    }
+    std::atomic<bool> finished{false};
+    std::thread reporter([&] {
+        while (!finished.load()) {
+            std::uint64_t done = 0, total = 0;
+            android::update_progress(done, total);
+            if (total == 0u) total = g_zip_size;
+            if (total != 0u) set_status([&](Status &s) { s.progress = static_cast<float>(done) / static_cast<float>(total); });
+            std::this_thread::sleep_for(std::chrono::milliseconds(250));
+        }
+    });
+    std::string error;
+    const bool ok = android::update_download(url, error);
+    finished = true;
+    reporter.join();
+    set_status([&](Status &s) {
+        if (ok) {
+            s.state = State::Ready;
+            s.progress = 1.0f;
+        } else {
+            s.state = State::Failed;
+            s.error = error.empty() ? "the download failed" : error;
+        }
+    });
+}
+#endif
+
 #if defined(PK_UPDATER)
 void check_thread() {
     // D012_UPDATE_TEST_ZIP=<a release zip on this disk>: offers that zip as a newer release and "downloads" it at once, so
@@ -280,6 +358,14 @@ void start_check() {
         g_status.state = State::Checking;
     }
     std::thread(check_thread).detach();
+#elif defined(PK_UPDATER_ANDROID)
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state == State::Checking || g_status.state == State::Downloading) return;
+        g_status = Status{};
+        g_status.state = State::Checking;
+    }
+    std::thread(android_check_thread).detach();
 #endif
 }
 
