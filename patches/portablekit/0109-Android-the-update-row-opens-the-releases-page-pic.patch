@@ -45,4 +46,12 @@ struct Entry {
 // truncating); -1 on failure.
 [[nodiscard]] int open_document(const std::string &uri, const char *mode);
 
+// The in-app update, done in Java (the app has no curl): a URL's text, the APK downloaded into the app's cache (blocking; its
+// progress can be read from another thread), and the APK handed to Android's installer.
+[[nodiscard]] std::optional<std::string> update_get(const std::string &url, std::string &error);
+[[nodiscard]] bool update_download(const std::string &url, std::string &error);
+void update_progress(std::uint64_t &done, std::uint64_t &total);
+enum class InstallResult { Started, NeedsPermission, Failed };
+[[nodiscard]] InstallResult update_install(std::string &error);
+
 } // namespace portablekit::android
diff --git a/host/platform/android_jni.cpp b/host/platform/android_jni.cpp
index 5073494..1e4e056 100644
--- a/host/platform/android_jni.cpp
+++ b/host/platform/android_jni.cpp
@@ -80,6 +80,99 @@ void relaunch() {
     call.failed();
 }
 
+namespace {
+std::string update_error(const Call &call) {
+    jmethodID id = call.method("updateError", "()Ljava/lang/String;");
+    if (id == nullptr) return "the update code is missing from this app";
+    jobject result = call.env->CallStaticObjectMethod(call.type, id);
+    if (call.failed()) return "the update failed";
+    return call.text(result).value_or(std::string());
+}
+} // namespace
+
+std::optional<std::string> update_get(const std::string &url, std::string &error) {
+    Call call;
+    if (!call.ok()) {
+        error = "no Java connection";
+        return std::nullopt;
+    }
+    jmethodID id = call.method("updateGet", "(Ljava/lang/String;)Ljava/lang/String;");
+    if (id == nullptr) {
+        error = "the update code is missing from this app";
+        return std::nullopt;
+    }
+    jstring argument = call.string(url);
+    jobject result = call.env->CallStaticObjectMethod(call.type, id, argument);
+    call.env->DeleteLocalRef(argument);
+    if (call.failed()) {
+        error = "the update check failed";
+        return std::nullopt;
+    }
+    std::optional<std::string> text = call.text(result);
+    if (!text) error = update_error(call);
+    return text;
+}
+
+bool update_download(const std::string &url, std::string &error) {
+    Call call;
+    if (!call.ok()) {
+        error = "no Java connection";
+        return false;
+    }
+    jmethodID id = call.method("updateDownload", "(Ljava/lang/String;)Z");
+    if (id == nullptr) {
+        error = "the update code is missing from this app";
+        return false;
+    }
+    jstring argument = call.string(url);
+    const jboolean done = call.env->CallStaticBooleanMethod(call.type, id, argument);
+    call.env->DeleteLocalRef(argument);
+    if (call.failed()) {
+        error = "the download failed";
+        return false;
+    }
+    if (done != JNI_TRUE) error = update_error(call);
+    return done == JNI_TRUE;
+}
+
+void update_progress(std::uint64_t &done, std::uint64_t &total) {
+    done = 0u;
+    total = 0u;
+    Call call;
+    if (!call.ok()) return;
+    jmethodID id = call.method("updateProgress", "()[J");
+    if (id == nullptr) return;
+    auto array = static_cast<jlongArray>(call.env->CallStaticObjectMethod(call.type, id));
+    if (call.failed() || array == nullptr) return;
+    jlong values[2]{};
+    if (call.env->GetArrayLength(array) == 2) call.env->GetLongArrayRegion(array, 0, 2, values);
+    call.env->DeleteLocalRef(array);
+    done = static_cast<std::uint64_t>(values[0]);
+    total = static_cast<std::uint64_t>(values[1]);
+}
+
+InstallResult update_install(std::string &error) {
+    Call call;
+    if (!call.ok()) {
+        error = "no Java connection";
+        return InstallResult::Failed;
+    }
+    jmethodID id = call.method("updateInstall", "()I");
+    if (id == nullptr) {
+        error = "the update code is missing from this app";
+        return InstallResult::Failed;
+    }
+    const jint result = call.env->CallStaticIntMethod(call.type, id);
+    if (call.failed()) {
+        error = "the installer could not be started";
+        return InstallResult::Failed;
+    }
+    if (result == 0) return InstallResult::Started;
+    if (result == 1) return InstallResult::NeedsPermission;
+    error = update_error(call);
+    return InstallResult::Failed;
+}
+
 std::optional<std::string> pick_folder() {
     Call call;
     if (!call.ok()) return std::nullopt;
diff --git a/host/ui/updater.cpp b/host/ui/updater.cpp
