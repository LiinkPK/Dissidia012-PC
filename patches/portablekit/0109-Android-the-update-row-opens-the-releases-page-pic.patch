 #if defined(_WIN32) || ((defined(__linux__) || defined(__APPLE__)) && !defined(__ANDROID__))
 #define PK_UPDATER 1
 #endif
+// Android has its own: the release is read and the APK downloaded in Java, then handed to Android's installer (PK_UPDATER_ANDROID).
+#if defined(__ANDROID__) && defined(PORTABLEKIT_ANDROID_APP)
