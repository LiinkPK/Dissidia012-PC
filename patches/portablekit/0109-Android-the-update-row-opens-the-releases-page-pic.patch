From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Wed, 18 Nov 2026 12:00:00 +0100
Subject: [PATCH] Android: the update row opens the releases page, picked folders keep their access

Android has no updater, so the update row did nothing. It now opens the releases page. GameActivity makes the grant of a
picked folder or file persistent, which was lost when the app restarted.
---
diff --git a/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java b/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
index cec636d..0db8972 100644
--- a/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
+++ b/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
@@ -2,6 +2,7 @@ package io.github.teamgdb.portablekit;
 
 import android.content.ContentResolver;
 import android.content.Intent;
+import android.content.IntentFilter;
 import android.content.pm.ActivityInfo;
 import android.database.Cursor;
 import android.graphics.Insets;
@@ -123,6 +124,16 @@ public class GameActivity extends SDLActivity {
     protected void onActivityResult(int requestCode, int resultCode, Intent data) {
         if (requestCode == kPickTree) {
             Uri uri = resultCode == RESULT_OK && data != null ? data.getData() : null;
+            // The grant of a picked folder or file lasts only until this process ends unless it is made persistent: without
+            // this, a chosen storage location (and the disc image, the DLC folder) stops being readable after a restart.
+            if (uri != null) {
+                try {
+                    int flags = data.getFlags() & (Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+                    if (flags != 0) getContentResolver().takePersistableUriPermission(uri, flags);
+                } catch (Exception e) {
+                    // A provider that offers no persistable grant: the pick still works for this run.
+                }
+            }
             finishPick(uri != null ? uri.toString() : null);
             return;
         }
@@ -193,4 +204,159 @@ public class GameActivity extends SDLActivity {
             return -1;
         }
     }
+
+    // ---- Updates: the release is read and its APK downloaded here (the app has no curl), and handed to Android's installer. ----
+    private static volatile String sUpdateError = "";
+    private static volatile long sUpdateDone, sUpdateTotal;
+    private static boolean sUpdateReceiverSet;
+
+    /** Why the last update call failed, or "". */
+    public static String updateError() {
+        return sUpdateError;
+    }
+
+    /** Bytes downloaded and expected (0 when the server does not say) by updateDownload. */
+    public static long[] updateProgress() {
+        return new long[] {sUpdateDone, sUpdateTotal};
+    }
+
+    private static java.net.HttpURLConnection open(String url) throws java.io.IOException {
+        java.net.HttpURLConnection connection = (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
+        connection.setConnectTimeout(15000);
+        connection.setReadTimeout(30000);
+        connection.setInstanceFollowRedirects(true);
+        connection.setRequestProperty("User-Agent", "Dissidia012-PC-updater");
+        connection.setRequestProperty("Accept", "application/vnd.github+json");
+        int code = connection.getResponseCode();
+        if (code != 200) {
+            connection.disconnect();
+            throw new java.io.IOException("HTTP " + code);
+        }
+        return connection;
+    }
+
+    /** The text at a URL (GitHub's release record), or null with updateError() set. */
+    public static String updateGet(String url) {
+        sUpdateError = "";
+        try {
+            java.net.HttpURLConnection connection = open(url);
+            try (java.io.InputStream in = connection.getInputStream();
+                 java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream()) {
+                byte[] buffer = new byte[16384];
+                int got;
+                while ((got = in.read(buffer)) > 0) out.write(buffer, 0, got);
+                return out.toString("UTF-8");
+            } finally {
+                connection.disconnect();
+            }
+        } catch (Exception e) {
+            sUpdateError = String.valueOf(e.getMessage() != null ? e.getMessage() : e.toString());
+            return null;
+        }
+    }
+
+    private static java.io.File updateFile() {
+        return new java.io.File(new java.io.File(mSingleton.getCacheDir(), "update"), "update.apk");
+    }
+
+    /** Downloads the APK at a URL into the app's cache, blocking; false with updateError() set. */
+    public static boolean updateDownload(String url) {
+        sUpdateError = "";
+        sUpdateDone = 0;
+        sUpdateTotal = 0;
+        java.io.File target = updateFile();
+        java.io.File partial = new java.io.File(target.getPath() + ".part");
+        try {
+            target.getParentFile().mkdirs();
+            target.delete();
+            java.net.HttpURLConnection connection = open(url);
+            try (java.io.InputStream in = connection.getInputStream();
+                 java.io.FileOutputStream out = new java.io.FileOutputStream(partial)) {
+                sUpdateTotal = connection.getContentLengthLong() > 0 ? connection.getContentLengthLong() : 0;
+                byte[] buffer = new byte[65536];
+                int got;
+                while ((got = in.read(buffer)) > 0) {
+                    out.write(buffer, 0, got);
+                    sUpdateDone += got;
+                }
+            } finally {
+                connection.disconnect();
+            }
+            if (sUpdateTotal > 0 && sUpdateDone != sUpdateTotal) throw new java.io.IOException("the download ended early");
+            if (!partial.renameTo(target)) throw new java.io.IOException("the downloaded file could not be kept");
+            return true;
+        } catch (Exception e) {
+            partial.delete();
+            sUpdateError = String.valueOf(e.getMessage() != null ? e.getMessage() : e.toString());
+            return false;
+        }
+    }
+
+    /**
+     * Hands the downloaded APK to Android's installer. 0: started (Android asks the player to confirm); 1: this app may not install
+     * apps yet, and the settings page where it can be allowed was opened; 2: failed, updateError() says why.
+     */
+    public static int updateInstall() {
+        sUpdateError = "";
+        try {
+            android.content.Context context = mSingleton;
+            if (Build.VERSION.SDK_INT >= 26 && !context.getPackageManager().canRequestPackageInstalls()) {
+                Intent settings = new Intent(android.provider.Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES,
+                    Uri.parse("package:" + context.getPackageName()));
+                settings.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                context.startActivity(settings);
+                return 1;
+            }
+            java.io.File apk = updateFile();
+            if (!apk.isFile() || apk.length() == 0) {
+                sUpdateError = "the update was not downloaded";
+                return 2;
+            }
+            final String action = context.getPackageName() + ".UPDATE_STATUS";
+            synchronized (GameActivity.class) {
+                if (!sUpdateReceiverSet) {
+                    android.content.BroadcastReceiver receiver = new android.content.BroadcastReceiver() {
+                        @Override
+                        public void onReceive(android.content.Context c, Intent intent) {
+                            int status = intent.getIntExtra(android.content.pm.PackageInstaller.EXTRA_STATUS, -1);
+                            if (status == android.content.pm.PackageInstaller.STATUS_PENDING_USER_ACTION) {
+                                Intent confirm = intent.getParcelableExtra(Intent.EXTRA_INTENT);
+                                if (confirm != null) {
+                                    confirm.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                                    c.startActivity(confirm);
+                                }
+                            } else if (status != android.content.pm.PackageInstaller.STATUS_SUCCESS) {
+                                sUpdateError = String.valueOf(intent.getStringExtra(android.content.pm.PackageInstaller.EXTRA_STATUS_MESSAGE));
+                            }
+                        }
+                    };
+                    IntentFilter filter = new IntentFilter(action);
+                    if (Build.VERSION.SDK_INT >= 33) context.registerReceiver(receiver, filter, android.content.Context.RECEIVER_NOT_EXPORTED);
+                    else context.registerReceiver(receiver, filter);
+                    sUpdateReceiverSet = true;
+                }
+            }
+            android.content.pm.PackageInstaller installer = context.getPackageManager().getPackageInstaller();
+            android.content.pm.PackageInstaller.SessionParams params =
+                new android.content.pm.PackageInstaller.SessionParams(android.content.pm.PackageInstaller.SessionParams.MODE_FULL_INSTALL);
+            int id = installer.createSession(params);
+            try (android.content.pm.PackageInstaller.Session session = installer.openSession(id)) {
+                try (java.io.OutputStream out = session.openWrite("update.apk", 0, apk.length());
+                     java.io.FileInputStream in = new java.io.FileInputStream(apk)) {
+                    byte[] buffer = new byte[65536];
+                    int got;
+                    while ((got = in.read(buffer)) > 0) out.write(buffer, 0, got);
+                    session.fsync(out);
+                }
+                int flags = android.app.PendingIntent.FLAG_UPDATE_CURRENT | (Build.VERSION.SDK_INT >= 31 ? android.app.PendingIntent.FLAG_MUTABLE : 0);
+                android.app.PendingIntent pending = android.app.PendingIntent.getBroadcast(context, id,
+                    new Intent(action).setPackage(context.getPackageName()), flags);
+                session.commit(pending.getIntentSender());
+            }
+            return 0;
+        } catch (Exception e) {
+            sUpdateError = String.valueOf(e.getMessage() != null ? e.getMessage() : e.toString());
+            return 2;
+        }
+    }
 }
