From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Wed, 18 Nov 2026 16:00:00 +0100
Subject: [PATCH] Mod data is looked up in the data-pack release

latest_asset_url reads the data-pack release, which is always published, instead of the latest release, which is a draft until published.
---

diff --git a/host/ui/updater.cpp b/host/ui/updater.cpp
index 349d99c..d7231ee 100644
--- a/host/ui/updater.cpp
+++ b/host/ui/updater.cpp
@@ -48,6 +48,8 @@ namespace portablekit::ui::updater {
 namespace {
 
 constexpr const char *kLatestApi = "https://api.github.com/repos/LiinkPK/Dissidia012-PC/releases/latest";
+// The mod data (emendatus_assets.bin) is a file of the data-pack release, which is always published: not of the latest release, which is a draft until the player-facing notes are written.
+constexpr const char *kDataPackApi = "https://api.github.com/repos/LiinkPK/Dissidia012-PC/releases/tags/data-pack";
 
 std::string kLocalVersion() {
     const char *version = portablekit::game().release_version;
@@ -377,9 +379,9 @@ Status status() {
 std::string latest_asset_url(const std::string &name, std::string &error) {
     std::string body;
 #if defined(PK_UPDATER)
-    if (!http_get(kLatestApi, [&](const char *data, std::size_t n) { body.append(data, n); }, nullptr, error)) return {};
+    if (!http_get(kDataPackApi, [&](const char *data, std::size_t n) { body.append(data, n); }, nullptr, error)) return {};
 #elif defined(PK_UPDATER_ANDROID)
-    const std::optional<std::string> text = android::update_get(kLatestApi, error);
+    const std::optional<std::string> text = android::update_get(kDataPackApi, error);
     if (!text) return {};
     body = *text;
 #else
-- 
