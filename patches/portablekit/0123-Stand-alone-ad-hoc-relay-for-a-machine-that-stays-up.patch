From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Thu, 19 Nov 2026 00:00:00 +0100
Subject: [PATCH] Stand-alone ad hoc relay for a machine that stays up

A game-free build of the ad hoc server (portablekit_adhoc_relay) for a small always-on machine: players connect out to it, so nobody forwards a port.
---

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 82e34b2..f6e97bb 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -241,6 +241,22 @@ if(PSPRECOMP_BUILD_TESTS)
     endif()
     set_target_properties(portablekit_adhoc_tests PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
     add_test(NAME portablekit_adhoc_tests COMMAND portablekit_adhoc_tests)
+
+    # The ad hoc server on its own, for a machine that stays up (no game, no window, no data).
+    add_executable(portablekit_adhoc_relay
+        "${PORTABLEKIT_ROOT}/tools/adhoc_relay_main.cpp"
+        "${PORTABLEKIT_ROOT}/tests/test_profile.cpp"
+        "${PORTABLEKIT_ROOT}/host/profile.cpp"
+        "${PORTABLEKIT_ROOT}/host/adhoc/client.cpp"
+        "${PORTABLEKIT_ROOT}/host/adhoc/discovery.cpp"
+        "${PORTABLEKIT_ROOT}/host/adhoc/server.cpp")
+    target_include_directories(portablekit_adhoc_relay PRIVATE
+        "${PORTABLEKIT_ROOT}/host" "${PORTABLEKIT_ROOT}/include")
+    target_link_libraries(portablekit_adhoc_relay PRIVATE Threads::Threads)
+    if(WIN32)
+        target_link_libraries(portablekit_adhoc_relay PRIVATE ws2_32 iphlpapi)
+    endif()
+    set_target_properties(portablekit_adhoc_relay PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
 endif()
 
 # Fixed-size memory pools (sceKernel*Fpl): their bookkeeping, with no kernel.
diff --git a/tools/adhoc_relay_main.cpp b/tools/adhoc_relay_main.cpp
new file mode 100644
index 0000000..d2e1994
--- /dev/null
+++ b/tools/adhoc_relay_main.cpp
@@ -0,0 +1,48 @@
+// A stand-alone ad hoc relay for a server that stays up: the same server the game hosts from Network > Host a
+// session (matchmaking on TCP <port>, relay on the next), with no game, no window and no data. Players point their
+// game at this machine's address and nothing has to be forwarded on their side.
+//
+//     portablekit_adhoc_relay [port]        (default 27312; the relay uses port + 1)
+//
+// It writes its events to the console. Ctrl+C or SIGTERM stops it.
+#include "adhoc/client.hpp"
+#include "adhoc/server.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <cstdlib>
+#include <iostream>
+#include <thread>
+
+namespace {
+std::atomic<bool> stop_requested{false};
+extern "C" void on_stop_signal(int) { stop_requested = true; }
+} // namespace
+
+int main(int argc, char **argv) {
+    using namespace portablekit::adhoc;
+    ServerConfig config;
+    config.print_events = true;
+    if (argc > 1) {
+        const unsigned long port = std::strtoul(argv[1], nullptr, 10);
+        if (port < 1024u || port > 65534u) {
+            std::cerr << "usage: portablekit_adhoc_relay [port 1024-65534]\n";
+            return 2;
+        }
+        config.adhocctl_port = static_cast<std::uint16_t>(port);
+    }
+    Server server;
+    if (!server.start(config)) {
+        std::cerr << "Cannot start the relay: " << server.status().error << "\n";
+        return 1;
+    }
+    std::cout << "Ad hoc relay on TCP " << config.adhocctl_port << " (matchmaking) and "
+              << relay_port_for(config.adhocctl_port) << " (relay). Ctrl+C stops it." << std::endl;
+    std::signal(SIGINT, on_stop_signal);
+    std::signal(SIGTERM, on_stop_signal);
+    while (!stop_requested) std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    server.stop();
+    Client::get().shutdown();
+    return 0;
+}
