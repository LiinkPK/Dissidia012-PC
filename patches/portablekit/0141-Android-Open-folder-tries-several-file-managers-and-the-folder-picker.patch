From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Sat, 21 Nov 2026 13:00:00 +0000
Subject: [PATCH] Android: Open folder tries several file managers and the folder picker

The Open ... folder buttons always showed "The file manager cannot show this folder" on a
phone whose file manager does not answer the one request they made. The activity now asks in
three forms, to the system's handler and then to the common file managers by name, and last
opens the system folder picker at the folder. The failures are logged ("openFolder").
---
 .../github/teamgdb/portablekit/GameActivity.java   | 35 ++++++++++++++++++----
 1 file changed, 30 insertions(+), 5 deletions(-)

diff --git a/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java b/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
index f227fef..167813a 100644
--- a/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
+++ b/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
@@ -189,11 +189,36 @@ public class GameActivity extends SDLActivity {
             if (relative != null && !relative.startsWith("/Android/data") && !relative.startsWith("/Android/obb")) {
                 while (relative.startsWith("/")) relative = relative.substring(1);
                 Uri folder = DocumentsContract.buildDocumentUri("com.android.externalstorage.documents", "primary:" + relative);
-                Intent view = new Intent(Intent.ACTION_VIEW);
-                view.setDataAndType(folder, DocumentsContract.Document.MIME_TYPE_DIR);
-                view.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_GRANT_READ_URI_PERMISSION);
-                activity.startActivity(view);
-                return true;
+                Uri tree = DocumentsContract.buildTreeDocumentUri("com.android.externalstorage.documents", "primary:" + relative);
+                // Not every file manager answers the same request: ask in several ways, naming the common managers first, and
+                // end with the system's own folder picker opened at the folder.
+                final String[] managers = {null, "com.google.android.documentsui", "com.android.documentsui",
+                    "com.mi.android.globalFileexplorer", "com.sec.android.app.myfiles", "com.android.fileexplorer"};
+                for (String manager : managers) {
+                    for (int form = 0; form < 3; ++form) {
+                        Intent view = new Intent(Intent.ACTION_VIEW);
+                        if (form == 0) view.setDataAndType(folder, DocumentsContract.Document.MIME_TYPE_DIR);
+                        else if (form == 1) view.setDataAndType(tree, DocumentsContract.Document.MIME_TYPE_DIR);
+                        else view.setDataAndType(Uri.fromFile(asked), "resource/folder");
+                        view.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_GRANT_READ_URI_PERMISSION);
+                        if (manager != null) view.setPackage(manager);
+                        try {
+                            activity.startActivity(view);
+                            return true;
+                        } catch (Exception e) {
+                            android.util.Log.w("openFolder", "no answer from " + manager + " form " + form + ": " + e);
+                        }
+                    }
+                }
+                try {
+                    Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
+                    pick.putExtra(DocumentsContract.EXTRA_INITIAL_URI, tree);
+                    pick.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                    activity.startActivity(pick);
+                    return true;
+                } catch (Exception e) {
+                    android.util.Log.w("openFolder", "the folder picker did not open: " + e);
+                }
             }
         } catch (Exception e) {
             // fall through to the message
