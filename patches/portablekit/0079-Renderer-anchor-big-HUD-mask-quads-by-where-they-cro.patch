From 7102f571c36cb4c0eaaa6c257d578dc5140b3761 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Sun, 8 Nov 2026 14:38:13 +0100
Subject: [PATCH] Renderer: anchor big HUD mask quads by where they cross the
 bar row, so a scaled lifebar's cut stays with the bar

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 host/gpu/vulkan_renderer.cpp | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index cfc41e2..7ec2f75 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -8495,7 +8495,29 @@ void VulkanRenderer::submit(const DrawCall &call, const GuestMemory &memory) {
                 // A quad that covers the whole screen is a fade or dim (battle start, summons), not a HUD piece:
                 // shrunk it would show as a square in the middle of the screen.
                 if (x0 <= 1.0f && x1 >= 479.0f && y0 <= 1.0f && y1 >= 271.0f) continue;
-                const float centre_x = (x0 + x1) * 0.5f;
+                float centre_x = (x0 + x1) * 0.5f;
+                if (by_quad && (x1 - x0 > 150.0f || y1 - y0 > 150.0f)) {
+                    // A big slanted quad is the alpha mask that cuts a lifebar's fill at the life remaining. Its bounding box
+                    // is hundreds of pixels wide and its centre has nothing to do with the bar it cuts, so it would anchor
+                    // to another side than the bar and the cut would land in the wrong place (the bar then looks full again).
+                    // Anchor it by where its edges cross the bar's row (y = 252), which is where the cut is seen.
+                    float sum = 0.0f;
+                    int hits = 0;
+                    static constexpr float kBarRow = 252.0f;
+                    for (std::size_t t = first; t < first + group; t += 3) {
+                        for (int e = 0; e < 3; ++e) {
+                            const GpuVertex &a = impl.scratch[t + static_cast<std::size_t>(e)];
+                            const GpuVertex &b = impl.scratch[t + static_cast<std::size_t>((e + 1) % 3)];
+                            if ((a.y - kBarRow) * (b.y - kBarRow) > 0.0f || a.y == b.y) continue;
+                            const float x = a.x + (b.x - a.x) * (kBarRow - a.y) / (b.y - a.y);
+                            if (x > 50.0f && x < 430.0f) {
+                                sum += x;
+                                ++hits;
+                            }
+                        }
+                    }
+                    if (hits > 0) centre_x = sum / static_cast<float>(hits);
+                }
                 if (impl.hud_mode == kMarkerHudBeginPanelRight) {
                     // Party roster panel: x 347..480, y 28..274 in the box trace; its middle is y = 151.
                     for (std::size_t i = first; i < first + group; ++i) {
-- 
