From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Thu, 19 Nov 2026 00:00:00 +0100
Subject: [PATCH] The texture pack is the textures folder itself

The installed pack was looked for in textures/<the disc id>, so a pack shipped as ULES01505 was not found by a player whose disc is ULUS10566: the setting said on, nothing loaded, and the player had to import it again. A release now ships the pack as the textures folder itself (textures.ini in it), the same for every disc. The textures folder itself and every folder of it that holds a textures.ini are candidates, and the one whose textures.ini is newest wins, so an older install or a newer import is kept. Save data is not touched.
---

diff --git a/host/gpu/texture_pack_import.cpp b/host/gpu/texture_pack_import.cpp
index 1a83796..9e7c4fa 100644
--- a/host/gpu/texture_pack_import.cpp
+++ b/host/gpu/texture_pack_import.cpp
@@ -227,7 +227,32 @@ TexturePackLocation texture_pack_location(const fs::path &textures_root, const s
     }
     if (!in_place.empty())
         return {fs::path(std::u8string(in_place.begin(), in_place.end())), TexturePackLocation::Source::InPlace};
-    return {textures_root / game_id, TexturePackLocation::Source::Installed};
+    // The pack a release ships is the textures folder itself (textures.ini in it), the same for every disc. An older install, or a pack
+    // the player imported, is a folder of it named for a disc id. All of them are candidates, and the one whose textures.ini is newest
+    // wins (after an update the shipped pack is the newest; an import made since is newer than that); the textures folder itself wins a tie.
+    const fs::path own = textures_root / game_id;
+    std::error_code ec;
+    const auto stamp = [](const fs::path &folder, fs::file_time_type &when) {
+        std::error_code e;
+        if (!fs::is_regular_file(folder / "textures.ini", e)) return false;
+        when = fs::last_write_time(folder / "textures.ini", e);
+        return !e;
+    };
+    fs::path best;
+    fs::file_time_type best_time{};
+    if (stamp(textures_root, best_time)) best = textures_root;
+    for (fs::directory_iterator it(textures_root, fs::directory_options::skip_permission_denied, ec);
+         !ec && it != fs::directory_iterator(); it.increment(ec)) {
+        std::error_code inner;
+        fs::file_time_type when{};
+        if (!it->is_directory(inner) || !stamp(it->path(), when)) continue;
+        if (best.empty() || when > best_time || (when == best_time && best != textures_root && it->path() == own)) {
+            best = it->path();
+            best_time = when;
+        }
+    }
+    if (!best.empty()) return {best, TexturePackLocation::Source::Installed};
+    return {own, TexturePackLocation::Source::Installed};
 }
 
 TexturePackCheck check_texture_pack(const fs::path &chosen, const std::string &game_id) {
