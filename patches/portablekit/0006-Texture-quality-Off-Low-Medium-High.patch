+// Halves an RGBA8 image in each direction: every pixel is the mean of the (up to) four it covers.
+static void halve_rgba(std::vector<std::uint8_t> &pixels, std::uint32_t &width, std::uint32_t &height) {
+    const std::uint32_t new_width = std::max(width / 2u, 1u), new_height = std::max(height / 2u, 1u);
+    std::vector<std::uint8_t> out(static_cast<std::size_t>(new_width) * new_height * 4u);
+    for (std::uint32_t y = 0; y < new_height; ++y)
+        for (std::uint32_t x = 0; x < new_width; ++x) {
+            const std::uint32_t x0 = std::min(x * 2u, width - 1u), x1 = std::min(x * 2u + 1u, width - 1u);
+            const std::uint32_t y0 = std::min(y * 2u, height - 1u), y1 = std::min(y * 2u + 1u, height - 1u);
+            for (std::uint32_t c = 0; c < 4u; ++c) {
+                const std::uint32_t sum = pixels[(static_cast<std::size_t>(y0) * width + x0) * 4u + c] +
+                                          pixels[(static_cast<std::size_t>(y0) * width + x1) * 4u + c] +
+                                          pixels[(static_cast<std::size_t>(y1) * width + x0) * 4u + c] +
+                                          pixels[(static_cast<std::size_t>(y1) * width + x1) * 4u + c];
+                out[(static_cast<std::size_t>(y) * new_width + x) * 4u + c] = static_cast<std::uint8_t>((sum + 2u) / 4u);
+            }
+        }
+    pixels = std::move(out);
+    width = new_width;
+    height = new_height;
+}
+
 void TexturePack::decode(Replacement &replacement, PendingBake &bake) {
+    // How many times to halve an image of this size so it is as close to the asked size (a multiple of the game's own texture) as halving
+    // gets without going under it; 0 when no size is asked, the game's size is not known, or it is already that small.
+    const auto drop_for = [&](std::uint32_t width, std::uint32_t height, std::uint32_t most) {
+        const std::uint32_t multiple = size_limit_.load(std::memory_order_relaxed);
+        if (multiple == 0u || replacement.texture_width == 0u || replacement.texture_height == 0u) return 0u;
+        const std::uint32_t want_width = multiple * replacement.texture_width, want_height = multiple * replacement.texture_height;
+        std::uint32_t drop = 0u;
+        while (drop < most && (width >> (drop + 1u)) >= want_width && (height >> (drop + 1u)) >= want_height) ++drop;
+        return drop;
+    };
     texpack_perf::Scope timer(texpack_perf::Stage::Decode, replacement.name);
     // The shipped bundle: ready BC7 with mips, one read and one inflate. A file of the same name in the folder wins, and an
     // image that covers only part of its texture (a [hashranges] entry) needs the padding the PNG path below does.
@@ -750,11 +781,13 @@ void TexturePack::decode(Replacement &replacement, PendingBake &bake) {
         texture_cache::Image image;
         if (bundle_.read(replacement.name, image) && bundle_decoded_.load(std::memory_order_relaxed)) {
             // No BC7 on this GPU: the first level becomes RGBA8, and the renderer builds the mips as it does for a PNG.
-            std::vector<std::uint8_t> pixels(static_cast<std::size_t>(image.width) * image.height * 4u);
-            if (image.width != 0u && image.height != 0u && !image.data.empty()) {
-                bc7::decode_level(image.data.data(), image.width, image.height, pixels.data());
-                replacement.width = image.width;
-                replacement.height = image.height;
+            const std::uint32_t drop = drop_for(image.width, image.height, image.levels > 0u ? image.levels - 1u : 0u);
+            const std::uint32_t level_width = std::max(image.width >> drop, 1u), level_height = std::max(image.height >> drop, 1u);
+            std::vector<std::uint8_t> pixels(static_cast<std::size_t>(level_width) * level_height * 4u);
+            if (image.width != 0u && image.height != 0u && !image.data.empty() && drop < image.level_offsets.size()) {
+                bc7::decode_level(image.data.data() + image.level_offsets[drop], level_width, level_height, pixels.data());
+                replacement.width = level_width;
+                replacement.height = level_height;
                 {
                     std::lock_guard lock(mutex_);
                     decoded_bytes_ += pixels.size();
@@ -767,6 +800,17 @@ void TexturePack::decode(Replacement &replacement, PendingBake &bake) {
                 return;
             }
         } else if (!image.data.empty()) {
+            // Texture quality: start at the smallest stored level that is still as big as asked (the larger ones are cut off the front).
+            const std::uint32_t drop = drop_for(image.width, image.height, image.levels > 0u ? image.levels - 1u : 0u);
+            if (drop > 0u && drop < image.level_offsets.size()) {
+                const std::uint64_t cut = image.level_offsets[drop];
+                image.data.erase(image.data.begin(), image.data.begin() + static_cast<std::ptrdiff_t>(cut));
+                image.level_offsets.erase(image.level_offsets.begin(), image.level_offsets.begin() + static_cast<std::ptrdiff_t>(drop));
+                for (std::uint64_t &offset : image.level_offsets) offset -= cut;
+                image.width = std::max(image.width >> drop, 1u);
+                image.height = std::max(image.height >> drop, 1u);
+                image.levels -= drop;
+            }
             replacement.width = image.width;
             replacement.height = image.height;
             replacement.levels = image.levels;
@@ -844,6 +888,8 @@ void TexturePack::decode(Replacement &replacement, PendingBake &bake) {
                     image + static_cast<std::size_t>(row) * static_cast<std::size_t>(width) * 4u,
                     static_cast<std::size_t>(std::min<std::uint32_t>(static_cast<std::uint32_t>(width), full_width)) * 4u);
     stbi_image_free(image);
+    // Texture quality: halved while it stays at least as big as asked (a multiple of the game's own texture).
+    for (std::uint32_t times = drop_for(full_width, full_height, 4u); times > 0u; --times) halve_rgba(pixels, full_width, full_height);
 
     replacement.width = full_width;
     replacement.height = full_height;
