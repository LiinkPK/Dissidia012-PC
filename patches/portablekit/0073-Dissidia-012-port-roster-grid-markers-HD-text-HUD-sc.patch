+namespace {
+struct LineRecord {
+    std::vector<LineGlyph> glyphs;
+    std::uint64_t version{};
+};
+std::mutex &lines_mutex() {
+    static std::mutex value;
+    return value;
+}
+std::unordered_map<std::uint32_t, LineRecord> &lines() {
+    static std::unordered_map<std::uint32_t, LineRecord> value;
+    return value;
+}
+} // namespace
+
+void note_line_glyph(std::uint32_t buffer, std::uint32_t code, int x64, int y64) {
+    std::lock_guard lock(lines_mutex());
+    LineRecord &line = lines()[buffer];
+    // A glyph that starts left of the last one begins a new line in the same buffer, unless it is the same glyph drawn
+    // again a little to the left (the game's second, bolder pass).
+    if (!line.glyphs.empty()) {
+        const LineGlyph &last = line.glyphs.back();
+        // The same glyph drawn again a little to the left and not lower: the second, bolder pass.
+        const bool same_again = last.code == code && last.x64 - x64 >= 0 && last.x64 - x64 < 64 && std::abs(last.y64 - y64) < 64;
+        if (same_again) return;
+        // Going back left starts the line again, unless it is a lower row of the same buffer: glyphs vary in height, so
+        // a row is a new one only when it starts well (a quarter of the buffer's glyph height) below the last glyph.
+        if (x64 <= last.x64 && y64 < last.y64 + 8 * 64) line.glyphs.clear();
+    }
+    line.glyphs.push_back({code, x64, y64});
+    ++line.version;
+}
+
+bool line_known(std::uint32_t buffer) {
+    std::lock_guard lock(lines_mutex());
+    return lines().find(buffer) != lines().end();
+}
+
+bool line_glyphs(std::uint32_t buffer, std::vector<LineGlyph> &out, std::uint64_t &version) {
+    std::lock_guard lock(lines_mutex());
+    const auto found = lines().find(buffer);
+    if (found == lines().end() || found->second.glyphs.empty()) return false;
+    out = found->second.glyphs;
+    version = found->second.version;
+    return true;
+}
+
+std::vector<std::uint8_t> render_line(const std::vector<LineGlyph> &glyphs, int width, int height, int scale) {
+    State &s = loaded_state();
+    const int out_w = width * scale, out_h = height * scale;
+    std::vector<std::uint8_t> out(static_cast<std::size_t>(out_w) * static_cast<std::size_t>(out_h), 0u);
+    std::vector<std::uint8_t> bits;
+    for (const LineGlyph &g : glyphs) {
+        const Layout &layout = layout_for(s, g.code);
+        if (layout.face == nullptr || layout.metrics.width <= 0) continue;
+        const float full_x = layout.scale_x * static_cast<float>(scale), full_y = layout.scale_y * static_cast<float>(scale);
+        // The Text > Size setting (<prefix>_TEXT_SIZE): percent of the size the game's cell gives the glyph. The glyph
+        // shrinks about its centre across and its baseline up, so lines keep the game's spacing and baseline.
+        const float size_factor = static_cast<float>(std::clamp<std::uint32_t>(settings::current().text_size, 50u, 100u)) / 100.0f;
+        const float sx = full_x * size_factor, sy = full_y * size_factor;
+        int fx0 = 0, fy0 = 0, fx1 = 0, fy1 = 0;
+        stbtt_GetGlyphBitmapBox(&layout.face->info, layout.glyph, full_x, full_y, &fx0, &fy0, &fx1, &fy1);
+        int x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+        stbtt_GetGlyphBitmapBox(&layout.face->info, layout.glyph, sx, sy, &x0, &y0, &x1, &y1);
+        GlyphBitmap bitmap;
+        bitmap.width = std::max(x1 - x0, 0);
+        bitmap.height = std::max(y1 - y0, 0);
+        if (bitmap.width == 0 || bitmap.height == 0) continue;
+        bitmap.pixels.assign(static_cast<std::size_t>(bitmap.width) * static_cast<std::size_t>(bitmap.height), 0u);
+        stbtt_MakeGlyphBitmap(&layout.face->info, bitmap.pixels.data(), bitmap.width, bitmap.height, bitmap.width, sx, sy,
+                              layout.glyph);
+        if (layout.bold > 0) embolden(bitmap, layout.bold * scale);
+        // The game placed the low-resolution bitmap, whose box starts at natural_x0/natural_y0, at (x64, y64)/64.
+        // Centred where the full-size glyph's box was; the baseline is where the game's bitmap puts it.
+        const int left = (g.x64 * scale) / 64 + fx0 - layout.natural_x0 * scale + ((fx1 - fx0) - (x1 - x0)) / 2;
+        const int baseline = (g.y64 * scale) / 64 - layout.natural_y0 * scale;
+        const int top = baseline + y0;
+        for (int row = 0; row < bitmap.height; ++row) {
+            const int y = top + row;
+            if (y < 0 || y >= out_h) continue;
+            for (int column = 0; column < bitmap.width; ++column) {
+                const int x = left + column;
+                if (x < 0 || x >= out_w) continue;
+                std::uint8_t &dst = out[static_cast<std::size_t>(y) * out_w + x];
+                dst = std::max(dst, bitmap.pixels[static_cast<std::size_t>(row) * bitmap.width + column]);
+            }
+        }
+    }
+    return out;
+}
