+// Reads the file again when it is new or has changed on disk.
+void load_cheats() {
+    CheatFile &f = cheat_file();
+    std::error_code ec;
+    const std::filesystem::path path = cheats_path();
+    const auto stamp = std::filesystem::last_write_time(path, ec);
+    if (f.loaded && f.path == path && (ec || stamp == f.stamp)) return;
+    f = CheatFile{};
+    f.path = path;
+    f.loaded = true;
+    if (ec) return;
+    f.stamp = stamp;
+    std::ifstream in(path, std::ios::binary);
+    std::string line;
+    while (std::getline(in, line)) {
+        if (!line.empty() && line.back() == '\r') {
+            line.pop_back();
+            f.crlf = true;
+        }
+        if (cheat_head(line)) f.heads.push_back(f.lines.size());
+        f.lines.push_back(line);
+    }
+    parse_codes(f);
+}
+
+void save_cheats() {
+    CheatFile &f = cheat_file();
+    std::ofstream out(f.path, std::ios::binary | std::ios::trunc);
+    for (const std::string &line : f.lines) out << line << (f.crlf ? "\r\n" : "\n");
+    out.close();
+    std::error_code ec;
+    f.stamp = std::filesystem::last_write_time(f.path, ec);
+}
 
