+// --- Text lines, redrawn sharp ------------------------------------------------
+// The game draws each line of text into a small texture of its own, glyph by glyph. The host notes which glyphs went where
+// and can rasterise the same line again, from the font, at `scale` times the texture's size.
+struct LineGlyph {
+    std::uint32_t code{};
+    int x64{};  // where the game put the glyph bitmap's top-left pixel in the line texture, in 1/64 texel
+    int y64{};
+};
+// Called for every glyph blitted into the buffer at guest address `buffer`.
+void note_line_glyph(std::uint32_t buffer, std::uint32_t code, int x64, int y64);
+// The glyphs of the line last drawn into `buffer` and a number that changes when they do; false: none known.
+bool line_glyphs(std::uint32_t buffer, std::vector<LineGlyph> &out, std::uint64_t &version);
+// Whether glyphs have been written into the buffer at `buffer`.
+[[nodiscard]] bool line_known(std::uint32_t buffer);
+// The line as 8-bit coverage, width*scale by height*scale.
+[[nodiscard]] std::vector<std::uint8_t> render_line(const std::vector<LineGlyph> &glyphs, int width, int height, int scale);
+
 // Rereads the font settings and clears every cached glyph, so the next glyph
 // the game asks for comes from the new font, then runs the hook.
 void reload();
