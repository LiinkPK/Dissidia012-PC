diff --git a/host/ui/updater.cpp b/host/ui/updater.cpp
new file mode 100644
index 0000000..d29549f
--- /dev/null
+++ b/host/ui/updater.cpp
@@ -0,0 +1,301 @@
+#include "ui/updater.hpp"
+
+#include "profile.hpp"
+#include "portablekit_version.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <winhttp.h>
+#pragma comment(lib, "winhttp.lib")
+#endif
+
+namespace portablekit::ui::updater {
+namespace {
+
+constexpr const char *kLatestApi = "https://api.github.com/repos/LiinkPK/Dissidia012-PC/releases/latest";
+
+std::string kLocalVersion() {
+    const char *version = portablekit::game().release_version;
+    return version != nullptr && *version != '\0' ? version : portablekit::kBuildVersion;
+}
+
+std::mutex g_mutex;
+Status g_status;
+std::string g_zip_url;
+std::filesystem::path g_zip_path;
+
+void set_status(const std::function<void(Status &)> &change) {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    change(g_status);
+}
+
+std::vector<int> numbers(const std::string &text) {
+    std::vector<int> out;
+    std::size_t i = text.find_first_of("0123456789");
+    while (i != std::string::npos && i < text.size()) {
+        int value = 0;
+        while (i < text.size() && std::isdigit(static_cast<unsigned char>(text[i]))) value = value * 10 + (text[i++] - '0');
+        out.push_back(value);
+        if (i >= text.size() || text[i] != '.') break;
+        ++i;
+    }
+    return out;
+}
+
+// The text of a JSON string value for `key`, the first one after `from`; empty when absent. Enough for GitHub's
+// release record, whose strings these are.
+std::string json_string(const std::string &json, const std::string &key, std::size_t from = 0u) {
+    const std::size_t at = json.find("\"" + key + "\"", from);
+    if (at == std::string::npos) return {};
+    const std::size_t colon = json.find(':', at);
+    const std::size_t open = colon == std::string::npos ? colon : json.find('"', colon);
+    if (open == std::string::npos) return {};
+    std::string value;
+    for (std::size_t i = open + 1; i < json.size() && json[i] != '"'; ++i) {
+        if (json[i] == '\\' && i + 1 < json.size()) ++i;
+        value += json[i];
+    }
+    return value;
+}
+
+#if defined(_WIN32)
+std::wstring wide(const std::string &text) { return std::wstring(text.begin(), text.end()); }
+
+// GETs `url`; the body goes to `sink`, `total` is the length when the server says (else 0). False with the
+// reason in `error`.
+bool http_get(const std::string &url, const std::function<void(const char *, std::size_t)> &sink,
+              const std::function<void(std::uint64_t, std::uint64_t)> &progress, std::string &error) {
+    const std::wstring w = wide(url);
+    URL_COMPONENTSW parts{};
+    parts.dwStructSize = sizeof(parts);
+    wchar_t host[256]{}, path[2048]{};
+    parts.lpszHostName = host;
+    parts.dwHostNameLength = 256;
+    parts.lpszUrlPath = path;
+    parts.dwUrlPathLength = 2048;
+    if (!WinHttpCrackUrl(w.c_str(), 0, 0, &parts)) {
+        error = "bad address";
+        return false;
+    }
+    HINTERNET session = WinHttpOpen(L"Dissidia012-PC-updater", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
+                                    WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+    HINTERNET connection = session ? WinHttpConnect(session, host, parts.nPort, 0) : nullptr;
+    HINTERNET request = connection ? WinHttpOpenRequest(connection, L"GET", path, nullptr, WINHTTP_NO_REFERER,
+                                                        WINHTTP_DEFAULT_ACCEPT_TYPES,
+                                                        parts.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0)
+                                   : nullptr;
+    bool ok = false;
+    if (request && WinHttpSendRequest(request, L"Accept: application/vnd.github+json\r\n", (DWORD)-1L,
+                                      WINHTTP_NO_REQUEST_DATA, 0, 0, 0) &&
+        WinHttpReceiveResponse(request, nullptr)) {
+        DWORD status = 0, size = sizeof(status);
+        WinHttpQueryHeaders(request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                            WINHTTP_HEADER_NAME_BY_INDEX, &status, &size, WINHTTP_NO_HEADER_INDEX);
+        if (status != 200) {
+            error = "HTTP " + std::to_string(status);
+        } else {
+            wchar_t length_text[32]{};
+            size = sizeof(length_text);
+            std::uint64_t total = 0;
+            if (WinHttpQueryHeaders(request, WINHTTP_QUERY_CONTENT_LENGTH, WINHTTP_HEADER_NAME_BY_INDEX, length_text,
+                                    &size, WINHTTP_NO_HEADER_INDEX))
+                total = std::wcstoull(length_text, nullptr, 10);
+            std::vector<char> buffer(64u * 1024u);
+            std::uint64_t done = 0;
+            DWORD got = 0;
+            ok = true;
+            while (WinHttpReadData(request, buffer.data(), (DWORD)buffer.size(), &got) && got != 0) {
+                sink(buffer.data(), got);
+                done += got;
+                if (progress) progress(done, total);
+            }
+        }
+    } else if (error.empty()) {
+        error = "no connection";
+    }
+    if (request) WinHttpCloseHandle(request);
+    if (connection) WinHttpCloseHandle(connection);
+    if (session) WinHttpCloseHandle(session);
+    return ok;
+}
+
+void check_thread() {
+    std::string body, error;
+    const bool ok = http_get(kLatestApi, [&](const char *data, std::size_t n) { body.append(data, n); }, nullptr, error);
+    const std::string tag = ok ? json_string(body, "tag_name") : std::string();
+    if (tag.empty()) {
+        set_status([&](Status &s) {
+            s.state = State::Failed;
+            s.error = ok ? "no release found" : error;
+        });
+        return;
+    }
+    std::string page = json_string(body, "html_url");
+    // The first attached zip is the release's package.
+    std::string zip;
+    for (std::size_t at = body.find("browser_download_url"); at != std::string::npos;
+         at = body.find("browser_download_url", at + 1u)) {
+        const std::string url = json_string(body, "browser_download_url", at);
+        if (url.size() > 4u && url.compare(url.size() - 4u, 4u, ".zip") == 0) {
+            zip = url;
+            break;
+        }
+    }
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        g_zip_url = zip;
+    }
+    set_status([&](Status &s) {
+        s.latest = tag;
+        s.page_url = page.empty() ? "https://github.com/LiinkPK/Dissidia012-PC/releases/latest" : page;
+        s.state = is_newer(tag, kLocalVersion()) ? State::Available : State::UpToDate;
+    });
+}
+#endif
+
+} // namespace
+
+bool is_newer(const std::string &latest, const std::string &local) {
+    // The numbers of the tag: "v1.0-8-g424ca06-dirty" is release 1.0 and some commits, so only "1.0" counts.
+    const std::vector<int> a = numbers(latest), b = numbers(local);
+    if (a.empty() || b.empty()) return false;
+    return std::lexicographical_compare(b.begin(), b.end(), a.begin(), a.end());
+}
+
+std::string local_version() { return kLocalVersion(); }
+
+void start_check() {
+#if defined(_WIN32)
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state == State::Checking || g_status.state == State::Downloading) return;
+        g_status = Status{};
+        g_status.state = State::Checking;
+    }
+    std::thread(check_thread).detach();
+#endif
+}
+
+Status status() {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    return g_status;
+}
+
+void start_download() {
+#if defined(_WIN32)
+    std::string url;
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state != State::Available && g_status.state != State::Failed) return;
+        url = g_zip_url;
+        g_status.state = State::Downloading;
+        g_status.progress = 0.0f;
+        g_status.error.clear();
+    }
+    std::thread([url] {
+        if (url.empty()) {
+            set_status([](Status &s) {
+                s.state = State::Failed;
+                s.error = "the release has no zip to download";
+            });
+            return;
+        }
+        std::error_code ec;
+        const std::filesystem::path zip = std::filesystem::temp_directory_path(ec) / "d012_update.zip";
+        std::string error;
+        bool ok = false;
+        {
+            std::ofstream out(zip, std::ios::binary | std::ios::trunc);
+            ok = out && http_get(url, [&](const char *data, std::size_t n) { out.write(data, static_cast<std::streamsize>(n)); },
+                                 [](std::uint64_t done, std::uint64_t total) {
+                                     if (total != 0u)
+                                         set_status([&](Status &s) { s.progress = static_cast<float>(done) / static_cast<float>(total); });
+                                 },
+                                 error);
+        }
+        if (ok) {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            g_zip_path = zip;
+            g_status.state = State::Ready;
+            g_status.progress = 1.0f;
+        } else {
+            std::filesystem::remove(zip, ec);
+            set_status([&](Status &s) {
+                s.state = State::Failed;
+                s.error = error.empty() ? "the download failed" : error;
+            });
+        }
+    }).detach();
+#endif
+}
+
+bool launch_installer() {
+#if defined(_WIN32)
+    std::filesystem::path zip;
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state != State::Ready) return false;
+        zip = g_zip_path;
+    }
+    wchar_t exe_buffer[MAX_PATH * 4]{};
+    GetModuleFileNameW(nullptr, exe_buffer, MAX_PATH * 4);
+    const std::filesystem::path exe = exe_buffer;
+    std::error_code ec;
+    const std::filesystem::path script = std::filesystem::temp_directory_path(ec) / "d012_update.ps1";
+    // Waits for the game to close, unpacks the zip, copies it over the game's folder except the player's own
+    // folders (data: saves, settings, textures, cheats; game: the disc image), then starts the game again.
+    // Whatever goes wrong is written to d012_update.log in the temp folder.
+    {
+        std::ofstream out(script, std::ios::trunc);
+        out << "param($ProcessId, $Zip, $Target, $Exe)\r\n"
+               "$log = Join-Path $env:TEMP 'd012_update.log'\r\n"
+               "try {\r\n"
+               "  Wait-Process -Id $ProcessId -ErrorAction SilentlyContinue\r\n"
+               "  $x = Join-Path $env:TEMP 'd012_update_files'\r\n"
+               "  if (Test-Path -LiteralPath $x) { Remove-Item -LiteralPath $x -Recurse -Force }\r\n"
+               "  Expand-Archive -LiteralPath $Zip -DestinationPath $x -Force\r\n"
+               "  $name = Split-Path $Exe -Leaf\r\n"
+               "  $src = (Get-ChildItem -LiteralPath $x -Recurse -Filter $name | Select-Object -First 1).DirectoryName\r\n"
+               "  if (-not $src) { throw 'the update has no ' + $name }\r\n"
+               "  robocopy $src $Target /E /XD data game /R:5 /W:1 | Out-Null\r\n"
+               "  if ($LASTEXITCODE -ge 8) { throw ('robocopy failed: ' + $LASTEXITCODE) }\r\n"
+               "  Remove-Item -LiteralPath $x, $Zip -Recurse -Force\r\n"
+               "} catch { $_ | Out-File -LiteralPath $log }\r\n"
+               "Start-Process -FilePath $Exe -WorkingDirectory $Target\r\n";
+        if (!out) return false;
+    }
+    const std::wstring command = L"powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" +
+                                 script.wstring() + L"\" -ProcessId " + std::to_wstring(GetCurrentProcessId()) +
+                                 L" -Zip \"" + zip.wstring() + L"\" -Target \"" + exe.parent_path().wstring() +
+                                 L"\" -Exe \"" + exe.wstring() + L"\"";
+    std::vector<wchar_t> mutable_command(command.begin(), command.end());
+    mutable_command.push_back(L'\0');
+    STARTUPINFOW startup{};
+    startup.cb = sizeof(startup);
+    PROCESS_INFORMATION process{};
+    if (!CreateProcessW(nullptr, mutable_command.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW | DETACHED_PROCESS,
+                        nullptr, nullptr, &startup, &process))
+        return false;
+    CloseHandle(process.hProcess);
+    CloseHandle(process.hThread);
+    return true;
+#else
+    return false;
+#endif
+}
+
+} // namespace portablekit::ui::updater
diff --git a/host/ui/updater.hpp b/host/ui/updater.hpp
new file mode 100644
index 0000000..efa0449
--- /dev/null
+++ b/host/ui/updater.hpp
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <string>
+
+// Checks GitHub for a newer release and installs it over the program's own files. The check runs once, on a
+// thread of its own, and only reads the latest release's tag. An install downloads the release's zip, then a
+// script waits for the game to close and copies the zip's files over the game's folder, leaving the player's
+// own folders (data, game) alone. Windows only; elsewhere nothing is ever reported as available.
+namespace portablekit::ui::updater {
+
+enum class State { Idle, Checking, UpToDate, Available, Failed, Downloading, Ready };
+
+struct Status {
+    State state{State::Idle};
+    std::string latest;       // the newest release's tag, e.g. "v1.1"
+    std::string page_url;     // its page on GitHub
+    std::string error;
+    float progress{};         // 0 to 1 while downloading
+};
+
+// Starts the check; ignored while one or a download is running.
+void start_check();
+[[nodiscard]] Status status();
+// Downloads the release's zip on a thread of its own; State::Ready when it is done.
+void start_download();
+// Starts the script that installs the downloaded zip once this program has exited, then runs the game again.
+// The caller quits straight after. False when it cannot be started.
+bool launch_installer();
+
+[[nodiscard]] std::string local_version();
+
+// True when `latest` is a newer release than `local` (git describe text: "v1.0", "v1.0-8-g424ca06-dirty").
+// A build made after a release is not older than it.
+[[nodiscard]] bool is_newer(const std::string &latest, const std::string &local);
+
+} // namespace portablekit::ui::updater
