+bool TexturePack::wait_decoded(Replacement &replacement, std::chrono::milliseconds timeout) {
+    const auto finished = [&] {
+        const Replacement::State state = replacement.state.load(std::memory_order_acquire);
+        return state == Replacement::State::Decoded || state == Replacement::State::Failed;
+    };
+    std::unique_lock lock(mutex_);
+    done_.wait_for(lock, timeout, finished);
+    return replacement.state.load(std::memory_order_acquire) == Replacement::State::Decoded;
+}
+
 void TexturePack::consumed(Replacement &replacement) {
     std::size_t freed = replacement.pixels.size();
     std::vector<std::uint8_t>().swap(replacement.pixels);
@@ -631,6 +641,11 @@ void TexturePack::loader_main() {
             queue_.pop_front();
         }
         decode(*replacement);
+        {
+            // Taking the lock orders the state store before a waiter's recheck.
+            std::lock_guard lock(mutex_);
+        }
+        done_.notify_all();
     }
 }
 
