From a65f135cb660cc4c01df697c250fada936a124d1 Mon Sep 17 00:00:00 2001
From: LiinkPK <linkgarciafiverr@gmail.com>
Date: Sat, 31 Oct 2026 14:22:49 +0100
Subject: [PATCH 67/74] Texture packs: accept the quick hash

Packs made with the format's first hash (hash = quick) keep working next to xxh32 and xxh64.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 host/gpu/texture_pack.cpp | 42 +++++++++++++++++++++++++++++++++++++++
 host/gpu/texture_pack.hpp |  3 ++-
 2 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/host/gpu/texture_pack.cpp b/host/gpu/texture_pack.cpp
index 28628eb..1fe5b3e 100644
--- a/host/gpu/texture_pack.cpp
+++ b/host/gpu/texture_pack.cpp
@@ -134,7 +134,48 @@ bool is_paletted(TextureFormat format) {
            format == TextureFormat::Clut32;
 }
 
+// The quick hash: 16-bit multiply-and-mix over 64-byte groups when the size is a multiple of 64, else a plain
+// fold of 8-byte steps. Guest textures are 16-byte aligned, so the grouped form applies to most.
+std::uint32_t quick_data_hash(const std::uint8_t *data, std::size_t size) {
+    auto rd16 = [&](std::size_t o) { return static_cast<std::uint16_t>(data[o] | (data[o + 1] << 8)); };
+    auto rd32 = [&](std::size_t o) {
+        return static_cast<std::uint32_t>(data[o]) | (static_cast<std::uint32_t>(data[o + 1]) << 8) |
+               (static_cast<std::uint32_t>(data[o + 2]) << 16) | (static_cast<std::uint32_t>(data[o + 3]) << 24);
+    };
+    if (size != 0u && (size & 0x3Fu) == 0u) {
+        std::uint16_t cur[8] = {};
+        std::uint16_t c2[8] = {0xC00B, 0x9BD9, 0x4B73, 0xB651, 0x4D9B, 0x4309, 0x0083, 0x0001};
+        for (std::size_t g = 0; g < size / 64u; ++g) {
+            const std::size_t b = g * 64u;
+            for (int j = 0; j < 8; ++j) cur[j] = static_cast<std::uint16_t>(cur[j] + rd16(b + j * 2) * c2[j]);
+            for (int j = 0; j < 4; ++j) {
+                std::uint32_t c = static_cast<std::uint32_t>(cur[j * 2]) | (static_cast<std::uint32_t>(cur[j * 2 + 1]) << 16);
+                c ^= rd32(b + 16 + j * 4);
+                c += rd32(b + 32 + j * 4);
+                cur[j * 2] = static_cast<std::uint16_t>(c);
+                cur[j * 2 + 1] = static_cast<std::uint16_t>(c >> 16);
+            }
+            for (int j = 0; j < 8; ++j) cur[j] ^= static_cast<std::uint16_t>(rd16(b + 48 + j * 2) * c2[j]);
+            for (int j = 0; j < 8; ++j) c2[j] = static_cast<std::uint16_t>(c2[j] + 0x2455u);
+        }
+        std::uint32_t sum = 0;
+        for (int j = 0; j < 4; ++j) {
+            const std::uint32_t c = static_cast<std::uint32_t>(cur[j * 2]) | (static_cast<std::uint32_t>(cur[j * 2 + 1]) << 16);
+            const std::uint32_t k = static_cast<std::uint32_t>(c2[j * 2]) | (static_cast<std::uint32_t>(c2[j * 2 + 1]) << 16);
+            sum += c + k;
+        }
+        return sum;
+    }
+    std::uint32_t check = 0;
+    for (std::size_t i = 0; i + 8u <= size; i += 8u) {
+        check += rd32(i);
+        check ^= rd32(i + 4u);
+    }
+    return check;
+}
+
 std::uint32_t data_hash(const std::uint8_t *data, std::size_t size, TexturePackHash hash) {
+    if (hash == TexturePackHash::Quick) return quick_data_hash(data, size);
     // xxh64 keys keep the low 32 bits of the 64-bit hash.
     return hash == TexturePackHash::Xxh32 ? XXH32(data, size, kDataSeed)
                                           : static_cast<std::uint32_t>(XXH64(data, size, kDataSeed));
@@ -386,6 +427,7 @@ bool TexturePack::load_ini(const std::filesystem::path &path, bool is_override,
                 const std::string kind = lower(value);
                 if (kind == "xxh64") options_.hash = TexturePackHash::Xxh64;
                 else if (kind == "xxh32") options_.hash = TexturePackHash::Xxh32;
+                else if (kind == "quick") options_.hash = TexturePackHash::Quick;
                 else if (!value.empty() || !is_override) {
                     // "quick" was the format's first hash; packs made with it
                     // are rare, and it is not implemented here.
diff --git a/host/gpu/texture_pack.hpp b/host/gpu/texture_pack.hpp
index 4d4c222..2a93bb6 100644
--- a/host/gpu/texture_pack.hpp
+++ b/host/gpu/texture_pack.hpp
@@ -86,7 +86,8 @@ struct TexturePackKey {
 // "0000000022585cbda625131a"
 [[nodiscard]] std::string format_texture_pack_key(const TexturePackKey &key);
 
-enum class TexturePackHash : std::uint8_t { Xxh32, Xxh64 };
+// Quick is the format's first hash (a fast sum over the texture's bytes); packs made with it keep working.
+enum class TexturePackHash : std::uint8_t { Xxh32, Xxh64, Quick };
 
 // What [options] says, plus the parts of the other sections that change a
 // texture's key.
