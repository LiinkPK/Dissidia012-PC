diff --git a/host/kernel/kernel.hpp b/host/kernel/kernel.hpp
index 276dfe1..77e0342 100644
--- a/host/kernel/kernel.hpp
+++ b/host/kernel/kernel.hpp
@@ -7,6 +7,7 @@
 #include <chrono>
 #include <cstdint>
 #include <deque>
+#include <atomic>
 #include <functional>
 #include <iosfwd>
 #include <map>
@@ -273,6 +274,15 @@ public:
     void set_idle_hook(IdleHook hook) { idle_hook_ = std::move(hook); }
     void set_poll_hook(PollHook hook) { poll_hook_ = std::move(hook); }
 
+    // Work done on another thread (the graphics thread of hle_media.cpp) that ends in interrupts for the guest. That thread must not call
+    // the kernel: it raises the flag, and the kernel thread calls `deliver` (which queues the interrupts) the next time it looks, and
+    // `wait` (which returns true if it waited for the other thread to finish) before it decides nothing is runnable.
+    void set_external_interrupts(PollHook deliver, std::function<bool()> wait) {
+        external_deliver_ = std::move(deliver);
+        external_wait_ = std::move(wait);
+    }
+    void raise_external_interrupt() noexcept { external_pending_.store(true, std::memory_order_release); }
+
     // Threads -------------------------------------------------------------
     [[nodiscard]] SceUID allocate_uid() noexcept { return next_uid_++; }
     [[nodiscard]] Thread *find_thread(SceUID uid) noexcept;
@@ -428,6 +438,15 @@ private:
     std::uint64_t pacing_virtual_base_{};
     IdleHook idle_hook_;
     PollHook poll_hook_;
+    PollHook external_deliver_;
+    std::function<bool()> external_wait_;
+    std::atomic<bool> external_pending_{false};
+    void deliver_external() {
+        if (external_deliver_ && external_pending_.load(std::memory_order_acquire)) {
+            external_pending_.store(false, std::memory_order_relaxed);
+            external_deliver_();
+        }
+    }
     std::uint64_t next_vblank_us_{kVBlankPeriodUs};
