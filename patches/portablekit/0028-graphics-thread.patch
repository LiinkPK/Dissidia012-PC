+// The graphics thread. A display list is run on a thread of its own, so the game's code goes on with the next frame while the list of
+// the last one is turned into draws (about 14 ms a frame in a battle on a phone, on top of the game's own 17). The game waits for it where
+// real hardware would make it wait: sceGeListSync, sceGeDrawSync, the flip, and a copy in or out of video memory. Its interrupts (signal
+// and finish callbacks) are handed to the kernel thread, which queues them; nothing here calls the kernel except to raise a flag.
+// Settings: Graphics thread.
+struct GeWorker {
+    std::mutex mutex;  // also guards media().ge_lists and media().ge_callbacks
+    std::condition_variable wake;
+    std::condition_variable idle;
+    std::deque<std::uint32_t> queue;  // list ids to run, in order
+    bool busy{};                      // a list is being run
+    bool started{};
+    std::vector<InterruptCall> interrupts;
+    Runtime *runtime{};
+};
+
+GeWorker &ge_worker() {
+    static GeWorker worker;
+    return worker;
+}
+
+void run_ge_list(Runtime &rt, std::uint32_t id, bool on_worker) {
+    GeWorker &worker = ge_worker();
     const perf::Clock::time_point start = perf::Clock::now();
-    GeList &list = found->second;
-    const GeCallback *callback = nullptr;
-    if (const auto cb = media().ge_callbacks.find(list.callback); cb != media().ge_callbacks.end())
-        callback = &cb->second;
+    GeList list{};
+    GeCallback callback{};
+    bool has_callback = false;
+    {
+        const std::lock_guard<std::mutex> lock(worker.mutex);
+        auto found = media().ge_lists.find(id);
+        if (found == media().ge_lists.end()) return;
+        list = found->second;
+        if (const auto cb = media().ge_callbacks.find(list.callback); cb != media().ge_callbacks.end()) {
+            callback = cb->second;
+            has_callback = true;
+        }
+    }
 
-    media().ge.set_signal_sink([callback](std::uint32_t signal, std::uint32_t pc) {
-        if (callback == nullptr) return;
+    media().ge.set_signal_sink([callback, has_callback, on_worker, &worker](std::uint32_t signal, std::uint32_t pc) {
+        if (!has_callback) return;
         const bool finish = (signal & 0x10000u) != 0u;
-        const std::uint32_t function = finish ? callback->finish_function : callback->signal_function;
+        const std::uint32_t function = finish ? callback.finish_function : callback.signal_function;
         if (function == 0u) return;
         InterruptCall call{};
         call.function = function;
-        call.arguments = {signal & 0xFFFFu, finish ? callback->finish_argument : callback->signal_argument, pc, 0u};
-        kernel().queue_interrupt(std::move(call));
+        call.arguments = {signal & 0xFFFFu, finish ? callback.finish_argument : callback.signal_argument, pc, 0u};
+        if (on_worker) {
+            {
+                const std::lock_guard<std::mutex> lock(worker.mutex);
+                worker.interrupts.push_back(std::move(call));
+            }
+            kernel().raise_external_interrupt();
+        } else {
+            kernel().queue_interrupt(std::move(call));
+        }
     });
 #if defined(PORTABLEKIT_HAS_RENDERER)
     if (media().renderer && media().renderer->available()) {
@@ -217,12 +258,98 @@ void run_ge_list(Runtime &rt, std::uint32_t id) {
         log_once("ge-list-error", std::string("[ge] display list aborted: ") + error.what());
         finished = true;
     }
-    list.done = finished;
+    {
+        const std::lock_guard<std::mutex> lock(worker.mutex);
+        if (auto found = media().ge_lists.find(id); found != media().ge_lists.end()) {
+            found->second.pc = list.pc;
+            found->second.done = finished;
+        }
+    }
     media().ge.set_draw_sink(nullptr);
     media().ge.set_transfer_sink(nullptr);
     perf::add_render_time(perf::Clock::now() - start);
 }
 
+void ge_worker_main() {
+    GeWorker &worker = ge_worker();
+    for (;;) {
+        std::uint32_t id = 0u;
+        {
+            std::unique_lock<std::mutex> lock(worker.mutex);
+            worker.wake.wait(lock, [&] { return !worker.queue.empty(); });
+            id = worker.queue.front();
+            worker.queue.pop_front();
+            worker.busy = true;
+        }
+        try {
+            run_ge_list(*worker.runtime, id, true);
+        } catch (const std::exception &error) {
+            log_once("ge-worker-error", std::string("[ge] graphics thread: ") + error.what());
+        }
+        {
+            const std::lock_guard<std::mutex> lock(worker.mutex);
+            worker.busy = false;
+            if (worker.queue.empty()) worker.idle.notify_all();
+        }
+    }
+}
+
+// Waits until every list handed to the graphics thread has been run.
+void ge_wait_idle() {
+    GeWorker &worker = ge_worker();
+    if (!worker.started) return;
+    std::unique_lock<std::mutex> lock(worker.mutex);
+    if (worker.queue.empty() && !worker.busy) return;
+    const perf::Clock::time_point start = perf::Clock::now();
+    worker.idle.wait(lock, [&] { return worker.queue.empty() && !worker.busy; });
+    perf::add_wait_time(perf::Clock::now() - start, perf::Stall::GeThread);
+}
+
+// The kernel's: true if it had to wait (the list may have raised an interrupt a thread is waiting for).
+bool ge_wait_for_kernel() {
+    GeWorker &worker = ge_worker();
+    if (!worker.started) return false;
+    std::unique_lock<std::mutex> lock(worker.mutex);
+    if (worker.queue.empty() && !worker.busy) return false;
+    worker.idle.wait(lock, [&] { return worker.queue.empty() && !worker.busy; });
+    return true;
+}
+
+void ge_deliver_interrupts() {
+    GeWorker &worker = ge_worker();
+    std::vector<InterruptCall> calls;
+    {
+        const std::lock_guard<std::mutex> lock(worker.mutex);
+        calls.swap(worker.interrupts);
+    }
+    for (InterruptCall &call : calls) kernel().queue_interrupt(std::move(call));
+}
+
+// Runs the list now, or hands it to the graphics thread when Graphics thread is on.
+void ge_run(Runtime &rt, std::uint32_t id) {
+    bool threaded = false;
+#if defined(PORTABLEKIT_HAS_RENDERER)
+    threaded = settings::current().gpu_thread && media().renderer && media().renderer->available();
+#endif
+    GeWorker &worker = ge_worker();
+    if (!threaded) {
+        ge_wait_idle();  // the setting was just turned off, or an earlier list is still running
+        run_ge_list(rt, id, false);
+        return;
+    }
+    if (!worker.started) {
+        worker.runtime = &rt;
+        worker.started = true;
+        kernel().set_external_interrupts(ge_deliver_interrupts, ge_wait_for_kernel);
+        std::thread(ge_worker_main).detach();
+    }
+    {
+        const std::lock_guard<std::mutex> lock(worker.mutex);
+        worker.queue.push_back(id);
+    }
+    worker.wake.notify_one();
+}
+
 #if defined(PORTABLEKIT_HAS_RENDERER)
 // The mouse's motion since the previous pump, as degrees for the camera
 // layer. Added after the flip, so whoever drives the camera takes it in the
@@ -274,6 +401,7 @@ std::uint64_t frame_start_us(std::uint64_t latest_vblank_us) {
 }
 
