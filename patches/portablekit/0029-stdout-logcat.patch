From ec4c293def00c1eee4d38619fd0f694f25fd1908 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 27 Nov 2026 00:14:59 +0100
Subject: [PATCH] STDOUT_LOGCAT: the Android log also goes to logcat

---
 host/platform/android_app.cpp | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/host/platform/android_app.cpp b/host/platform/android_app.cpp
index bad2125..cd4b2d2 100644
--- a/host/platform/android_app.cpp
+++ b/host/platform/android_app.cpp
@@ -11,7 +11,9 @@
 #include <SDL3/SDL.h>
 #include <SDL3/SDL_main.h>
 
+#include <android/log.h>
 #include <pthread.h>
+#include <unistd.h>
 
 #include <cstdint>
 #include <cstdio>
@@ -19,6 +21,7 @@
 #include <fstream>
 #include <sstream>
 #include <string>
+#include <thread>
 #include <vector>
 
 int portablekit_main(int argc, char **argv);
@@ -65,6 +68,35 @@ void redirect_output() {
                 (std::string(storage) + "/" + portablekit::game().app_name + "-previous.log").c_str());
     if (std::freopen(log.c_str(), "w", stdout) != nullptr) std::setvbuf(stdout, nullptr, _IOLBF, 0);
     if (std::freopen(log.c_str(), "a", stderr) != nullptr) std::setvbuf(stderr, nullptr, _IONBF, 0);
+    // <prefix>_STDOUT_LOGCAT=1: the log also goes to logcat (tag <app>out), line by line, so the TRACE_ variables can be read from a
+    // phone with `adb logcat`, which cannot read the app's private folder. The file keeps everything too.
+    if (portablekit::env("STDOUT_LOGCAT") != nullptr) {
+        int fds[2];
+        const int file_out = dup(1);
+        const int file_err = dup(2);
+        if (file_out >= 0 && pipe(fds) == 0) {
+            dup2(fds[1], 1);
+            dup2(fds[1], 2);
+            const int reader = fds[0];
+            const std::string tag = std::string(portablekit::game().app_name) + "out";
+            std::thread([reader, file_out, tag] {
+                std::string pending;
+                char block[4096];
+                for (;;) {
+                    const ssize_t got = read(reader, block, sizeof block);
+                    if (got <= 0) return;
+                    if (write(file_out, block, static_cast<std::size_t>(got)) < 0) {}
+                    pending.append(block, static_cast<std::size_t>(got));
+                    std::size_t newline;
+                    while ((newline = pending.find('\n')) != std::string::npos) {
+                        __android_log_print(ANDROID_LOG_INFO, tag.c_str(), "%s", pending.substr(0, newline).c_str());
+                        pending.erase(0, newline + 1);
+                    }
+                }
+            }).detach();
+        }
+        (void)file_err;
+    }
 }
 
 // The APK carries the fallback font a release ships in fonts/, as an asset.
