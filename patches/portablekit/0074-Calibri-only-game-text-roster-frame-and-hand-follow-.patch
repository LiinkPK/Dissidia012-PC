+    // Font and Weight are fixed (Calibri Regular, see game_font.cpp load()): only the size is a choice.
     {
         // Applied by the renderer on the next frame; no reload needed.
         const std::string size_text = std::to_string(s.text_size) + "%";
@@ -237,15 +211,6 @@ void font_rows() {
             settings::save();
         }
     }
-    draw_preview();
-    if (button_row("Open the fonts folder",
-                   {false, {}, "Fonts put in this folder (.ttf, .otf, .ttc) are listed first under Font: " +
