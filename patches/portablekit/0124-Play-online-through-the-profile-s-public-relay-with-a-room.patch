+                    if (!relay_timing) {
+                        relay_timing = true;
+                        relay_since = Clock::now();
+                    }
+                    info_row("Relay", "Connecting...");
+                    if (Clock::now() - relay_since > std::chrono::seconds(12)) {
+                        // The relay is down, or this network blocks it: host directly with an opened router port instead.
+                        relay_fell_back = true;
+                        relay_timing = false;
+                        adhoc_host_start();
+                    }
+                }
+            } else {
+                relay_timing = false;
+            }
+        }
+        if (relay_fell_back && adhoc_hosting())
+            info_row("Relay", "Not reachable, so this game hosts directly. Share the internet address below.");
