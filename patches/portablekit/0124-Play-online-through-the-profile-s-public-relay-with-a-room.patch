+    // Through the profile's public relay: nobody opens a port, and a room code is all the others need. When the relay cannot be
+    // reached, this game hosts directly instead (the router's ports are opened, see below) and shows the address to share.
+    static bool relay_fell_back = false;
+    if (!adhoc_relay_address().empty()) {
