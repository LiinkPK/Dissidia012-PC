+namespace {
+
+std::string lower_ascii(std::string text) {
+    for (char &c : text) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return text;
+}
+
+} // namespace
+
+std::string adhoc_room_code(const std::string &room) {
+    std::string name;
+    for (const char c : room)
+        if (std::isalnum(static_cast<unsigned char>(c))) name += static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+    if (name.empty()) return {};
+    std::uint32_t hash = 2166136261u;  // FNV-1a
+    for (const char c : name) hash = (hash ^ static_cast<std::uint8_t>(c)) * 16777619u;
+    static constexpr char kDigits[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+    std::string code(4, '0');
+    std::uint32_t value = hash % (36u * 36u * 36u * 36u);
+    for (int i = 3; i >= 0; --i, value /= 36u) code[static_cast<std::size_t>(i)] = kDigits[value % 36u];
+    return code;
+}
+
+std::string adhoc_relay_address() {
+    const char *relay = game().adhoc_relay_server;
+    return relay != nullptr ? std::string(relay) : std::string();
+}
+
+bool adhoc_relay_selected() {
+    const std::string relay = adhoc_relay_address();
+    if (relay.empty() || adhoc_hosting()) return false;
+    const settings::Settings &s = settings::current();
+    return s.adhoc && lower_ascii(s.adhoc_server) == lower_ascii(relay);
+}
+
 std::string adhoc_effective_product(std::string product) {
     const GameProfile &profile = game();
     if (profile.adhoc_edition_mark != 0 && profile.adhoc_edition_active != nullptr && profile.adhoc_edition_active() &&
         !product.empty())
         product[0] = profile.adhoc_edition_mark;
+    // On the public relay the room is the last four characters of the product code: the server keeps products apart, so
+    // players in different rooms never see each other, and the login format is the ordinary one.
+    if (product.size() == 9u && adhoc_relay_selected()) {
+        const std::string code = adhoc_room_code(settings::current().adhoc_room);
+        if (!code.empty()) product.replace(5u, 4u, code);
+    }
     return product;
 }
 
