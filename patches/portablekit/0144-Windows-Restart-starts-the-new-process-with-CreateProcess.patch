From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 <d012@localhost>
Date: Sat, 21 Nov 2026 12:00:00 +0000
Subject: [PATCH] Windows: Restart starts the new process with CreateProcess

_execv does not quote its arguments and failed to bring the game back when it was started from Explorer or a shortcut.
---
diff --git a/host/install/installer.cpp b/host/install/installer.cpp
index 9e5fb91..78fe743 100644
--- a/host/install/installer.cpp
+++ b/host/install/installer.cpp
@@ -29,6 +29,13 @@
 #include <vector>
 
 #if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
 #include <process.h>
 #else
 #include <unistd.h>
@@ -422,8 +429,28 @@ int restart(char **argv) {
     const std::filesystem::path self = executable_path();
     const std::string program = self.empty() ? std::string(argv[0]) : self.string();
 #if defined(_WIN32)
-    const intptr_t result = _execv(program.c_str(), argv);
-    (void)result;
+    // _execv does not quote its arguments and, started from Explorer, the replacement could fail to appear. A new process
+    // with a quoted command line, then this one ends.
+    {
+        auto quoted = [](const std::string &s) { return "\"" + s + "\""; };
+        std::string command = quoted(program);
+        for (int i = 1; argv != nullptr && argv[i] != nullptr; ++i) command += " " + quoted(argv[i]);
+        std::vector<char> line(command.begin(), command.end());
+        line.push_back('\0');
+        STARTUPINFOA startup{};
+        startup.cb = sizeof(startup);
+        PROCESS_INFORMATION info{};
+        const std::string directory = self.empty() ? std::string() : self.parent_path().string();
+        if (CreateProcessA(program.c_str(), line.data(), nullptr, nullptr, TRUE, 0, nullptr,
+                           directory.empty() ? nullptr : directory.c_str(), &startup, &info)) {
+            CloseHandle(info.hThread);
+            CloseHandle(info.hProcess);
+            std::cerr << "Restarted " << program << "\n";
+            std::cerr.flush();
+            std::exit(0);
+        }
+        std::cerr << "CreateProcess failed (error " << GetLastError() << ")\n";
+    }
 #else
     execv(program.c_str(), argv);
 #endif
-- 
