 namespace portablekit::install {
 namespace {
 
@@ -94,9 +99,30 @@ std::filesystem::path path_from_utf8(const std::string &text) {
 #endif
 }
 
+#if defined(PORTABLEKIT_ANDROID_APP)
+std::filesystem::path private_data_directory() {
+    char *pref = SDL_GetPrefPath(portablekit::game().data_organization, portablekit::game().data_application);
+    if (pref == nullptr) throw psprecomp::Error(std::string("Cannot determine the user data directory: ") + SDL_GetError());
+    std::filesystem::path result = path_from_utf8(pref);
+    SDL_free(pref);
+    return result;
+}
+
+std::filesystem::path shared_data_directory() {
+    const char *name = portablekit::game().android_shared_data_folder;
+    if (name == nullptr || *name == '\0') return {};
+    return std::filesystem::path("/storage/emulated/0") / name;
+}
+#endif
+
 std::filesystem::path user_data_directory() {
     if (const char *dir = portablekit::env("DATA_DIR"); dir != nullptr && *dir != '\0') return path_from_utf8(dir);
-#if defined(PORTABLEKIT_HAS_SDL)
+#if defined(PORTABLEKIT_ANDROID_APP)
+    // Decided once per run: the folder in the phone's shared storage when the app may use it (see shared_data.hpp), else the private one.
+    static const std::filesystem::path chosen =
+        choose_data_root(private_data_directory(), shared_data_directory(), portablekit::android::all_files_access());
+    return chosen;
+#elif defined(PORTABLEKIT_HAS_SDL)
     char *pref = SDL_GetPrefPath(portablekit::game().data_organization, portablekit::game().data_application);
     if (pref == nullptr) throw psprecomp::Error(std::string("Cannot determine the user data directory: ") + SDL_GetError());
     std::filesystem::path result = path_from_utf8(pref);
