                                             (project + " log " + savedata::timestamp_for_path(std::chrono::system_clock::now()));
         std::filesystem::remove_all(local.parent_path(), ec);
@@ -1899,6 +1906,55 @@ void Menu::system() {
                                                      : "Not saved: " + copied->error;
     }
     if (!saved_log_path().empty()) info_row("Log", saved_log_path());
+    // The game's data (saves, textures, mods, cheats) in a folder every file manager shows, instead of the app's private storage.
+    {
+        const std::filesystem::path shared = install::shared_data_directory();
+        if (!shared.empty()) {
+            static std::atomic<bool> moving{false};
+            static std::mutex note_lock;
+            static std::string note;
+            const bool in_use = install::user_data_directory() == shared;
+            if (moving.load()) {
+                info_row("Data folder", "Moving the game's data. Keep the app open.");
+            } else if (in_use) {
+                info_row("Data folder", install::path_to_utf8(shared));
+                if (button_row("Open the data folder###opendata", {false, {}, "Show the game's data folder in the file manager."}))
+                    open_folder(shared);
+                std::error_code ec;
+                if (std::filesystem::exists(install::private_data_directory() / install::kSettingsFile, ec) &&
+                    button_row("Delete the old copy of the data###deleteold",
+                               {false, {}, "The data was copied to the folder above. This deletes the old copy in the app's private storage."})) {
+                    std::string error;
+                    const bool ok = install::delete_private_copy(install::private_data_directory(), shared, error);
+                    const std::lock_guard<std::mutex> guard(note_lock);
+                    note = ok ? std::string() : error;
+                }
+            } else if (button_row("Move the game's data to a folder you can open###movedata",
+                                  {false, {}, "Copies the saves, textures, mods and cheats to " + install::path_to_utf8(shared) +
+                                                  ", a folder any file manager shows. Needs access to all files. The old copy stays until you delete it."})) {
+                if (!android::all_files_access()) {
+                    android::request_all_files_access();
+                    const std::lock_guard<std::mutex> guard(note_lock);
+                    note = "Allow access to all files in the page that opened, then press this again.";
+                } else {
+                    moving = true;
+                    std::thread([shared] {
+                        std::string error;
+                        const bool ok = install::move_data_to_shared(install::private_data_directory(), shared, error);
+                        if (ok) {
+                            android::relaunch();
+                        } else {
+                            const std::lock_guard<std::mutex> guard(note_lock);
+                            note = error;
+                        }
+                        moving = false;
+                    }).detach();
+                }
+            }
+            const std::lock_guard<std::mutex> guard(note_lock);
+            if (!note.empty()) info_row("Data", note);
+        }
+    }
 #else
     if (button_row("Open the data folder", {false, {}, std::string("Show ") + portablekit::game().project_name + "'s data folder in the file manager."})) {
         open_folder(install::path_from_utf8(data_dir));
