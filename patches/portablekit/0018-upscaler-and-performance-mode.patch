From: x <x@x>
Date: Thu, 26 Nov 2026 17:56:14 +0100
Subject: [PATCH] Video: Upscaling (bicubic with sharpening, from the game's
 own resolution) and Performance mode

---
 host/gpu/shaders/level.frag  | 59 ++++++++++++++++++++++++++++++++++--
 host/gpu/vulkan_renderer.cpp | 50 +++++++++++++++++++++---------
 host/gpu/vulkan_renderer.hpp |  2 ++
 host/settings/settings.cpp   |  1 +
 host/settings/settings.hpp   |  1 +
 host/ui/menu.cpp             | 28 +++++++++++++++++
 6 files changed, 124 insertions(+), 17 deletions(-)

diff --git a/host/gpu/shaders/level.frag b/host/gpu/shaders/level.frag
index 2a64241..0f388e3 100644
--- a/host/gpu/shaders/level.frag
+++ b/host/gpu/shaders/level.frag
@@ -13,7 +13,8 @@ layout(push_constant) uniform Level {
     // cos and sin of the turn (anticlockwise on screen), the zoom, and the
     // picture's width over its height.
     vec4 turn;
-    // x: 1 when the picture is smoothed (FXAA).
+    // x: 1 when the picture is smoothed (FXAA). y: 1 when it is upscaled (the frame image is then the game's own size, not the
+    // window's). z: the upscaler's sharpening, 0 to 1.
     vec4 options;
 } level;
 
@@ -47,6 +48,53 @@ vec3 fxaa(vec2 uv) {
     return (l_b < l_min || l_b > l_max) ? a : b;
 }
 
+// Bicubic (Catmull-Rom) sample in five bilinear taps: sharper than the plain bilinear stretch of a picture drawn smaller than
+// the window.
+vec3 catmull(vec2 uv) {
+    vec2 size = vec2(textureSize(frame, 0));
+    vec2 position = uv * size;
+    vec2 centre = floor(position - 0.5) + 0.5;
+    vec2 f = position - centre;
+    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
+    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
+    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
+    vec2 w3 = f * f * (-0.5 + 0.5 * f);
+    vec2 w12 = w1 + w2;
+    vec2 offset12 = w2 / w12;
+    vec2 p0 = (centre - 1.0) / size;
+    vec2 p3 = (centre + 2.0) / size;
+    vec2 p12 = (centre + offset12) / size;
+    vec3 result = vec3(0.0);
+    result += texture(frame, vec2(p0.x, p0.y)).rgb * (w0.x * w0.y);
+    result += texture(frame, vec2(p12.x, p0.y)).rgb * (w12.x * w0.y);
+    result += texture(frame, vec2(p3.x, p0.y)).rgb * (w3.x * w0.y);
+    result += texture(frame, vec2(p0.x, p12.y)).rgb * (w0.x * w12.y);
+    result += texture(frame, vec2(p12.x, p12.y)).rgb * (w12.x * w12.y);
+    result += texture(frame, vec2(p3.x, p12.y)).rgb * (w3.x * w12.y);
+    result += texture(frame, vec2(p0.x, p3.y)).rgb * (w0.x * w3.y);
+    result += texture(frame, vec2(p12.x, p3.y)).rgb * (w12.x * w3.y);
+    result += texture(frame, vec2(p3.x, p3.y)).rgb * (w3.x * w3.y);
+    return clamp(result, 0.0, 1.0);
+}
+
+// Contrast adaptive sharpening (AMD FidelityFX CAS, MIT), the cross-shaped form: each pixel is sharpened as much as its neighbourhood
+// can take without overshooting, so flat areas stay clean and edges gain bite.
+vec3 sharpen(vec2 uv, vec3 e, float amount) {
+    vec2 dx = dFdx(uv), dy = dFdy(uv);
+    vec2 px_step = vec2(abs(dx.x) + abs(dy.x), abs(dx.y) + abs(dy.y));
+    vec3 b = texture(frame, uv + vec2(0.0, -px_step.y)).rgb;
+    vec3 d = texture(frame, uv + vec2(-px_step.x, 0.0)).rgb;
+    vec3 f = texture(frame, uv + vec2(px_step.x, 0.0)).rgb;
+    vec3 h = texture(frame, uv + vec2(0.0, px_step.y)).rgb;
+    vec3 low = min(min(min(d, e), min(f, b)), h);
+    vec3 high = max(max(max(d, e), max(f, b)), h);
+    vec3 amp = sqrt(clamp(min(low, 1.0 - high) / max(high, vec3(1e-4)), 0.0, 1.0));
+    float peak = -1.0 / mix(8.0, 5.0, clamp(amount, 0.0, 1.0));
+    vec3 w = amp * peak;
+    vec3 weight = 1.0 / (1.0 + 4.0 * w);
+    return clamp((b * w + d * w + f * w + h * w + e) * weight, 0.0, 1.0);
+}
+
 void main() {
     // Centred, in units of the picture's height, y down as on screen.
     vec2 point = (picture - 0.5) * vec2(level.turn.w, 1.0);
@@ -57,5 +105,12 @@ void main() {
     vec2 source = vec2(c * point.x - s * point.y, s * point.x + c * point.y) / level.turn.z;
     vec2 uv = source / vec2(level.turn.w, 1.0) + 0.5;
     vec2 frame_uv = level.rect.xy + clamp(uv, 0.0, 1.0) * level.rect.zw;
-    color = level.options.x > 0.5 ? vec4(fxaa(frame_uv), 1.0) : texture(frame, frame_uv);
+    if (level.options.x > 0.5 || level.options.y > 0.5) {
+        // Smoothed (FXAA), or upscaled (bicubic); the upscaler also sharpens whichever of the two it starts from.
+        vec3 base = level.options.x > 0.5 ? fxaa(frame_uv) : catmull(frame_uv);
+        if (level.options.y > 0.5 && level.options.z > 0.0) base = sharpen(frame_uv, base, level.options.z);
+        color = vec4(base, 1.0);
+    } else {
+        color = texture(frame, frame_uv);
+    }
 }
