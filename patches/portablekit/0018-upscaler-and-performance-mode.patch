diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index b258ddd..100bbde 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -742,6 +742,32 @@ void Menu::video() {
         renderer().set_sharp_screen(s.sharp_screen);
         settings::save();
     }
+    {
+        // One step for a slow computer or a phone: the game is drawn at 2x and made sharp again by the upscaler, with FXAA over it, which
+        // costs a fraction of drawing 4x. Turning it off goes back to 4x with neither.
+        const bool performance = s.internal_scale == 2u && s.upscale && s.fxaa;
+        if (choice_row("Performance mode", performance ? "On" : "Off",
+                       options_for("video.internal_scale",
+                                   "Draws the game at 2x and scales it up with a sharp upscaler and FXAA: much lighter on the graphics card, "
+                                   "and it still looks clean. Sets Resolution, Anti-aliasing and Upscaling together; you can change "
+                                   "each afterwards."))) {
+            s.internal_scale = performance ? 4u : 2u;
+            s.upscale = !performance;
+            s.fxaa = !performance;
+            renderer().set_internal_scale(s.internal_scale);
+            renderer().set_upscale(s.upscale);
+            renderer().set_fxaa(s.fxaa);
+            settings::save();
+        }
+    }
+    if (choice_row("Upscaling", s.upscale ? "Sharp" : "Off",
+                   options_for("video.upscale", "How the picture is scaled to the window when the Resolution is lower than the window: Off is "
+                                                "the plain smooth stretch; Sharp is a bicubic scale with light sharpening, which keeps "
+                                                "edges crisp."))) {
+        s.upscale = !s.upscale;
+        renderer().set_upscale(s.upscale);
+        settings::save();
+    }
     if (choice_row("Anti-aliasing", s.fxaa ? "FXAA" : "Off",
                    options_for("video.fxaa", "Smooths jagged edges on the finished picture. FXAA is light on the graphics card "
                                              "(it costs a little more on a phone); Off draws the picture as it is."))) {
