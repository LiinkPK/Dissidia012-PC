+bool open_folder(const std::string &path) {
+    Call call;
+    if (!call.ok()) return false;
+    jmethodID id = call.method("openFolder", "(Ljava/lang/String;)Z");
+    if (id == nullptr) return false;
+    jstring text = call.string(path);
+    const jboolean opened = call.env->CallStaticBooleanMethod(call.type, id, text);
+    call.env->DeleteLocalRef(text);
+    return !call.failed() && opened == JNI_TRUE;
+}
