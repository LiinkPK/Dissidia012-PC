 // Reads the file again when it is new or has changed on disk.
+#if defined(PORTABLEKIT_ANDROID_APP)
+// The APK carries no memory stick folder, so the cheat file is fetched, once per run, from the profile's address when it is missing or
+// blank. It is placed in PSP/CHEATS; the next load_cheats() sees the new file by its time stamp.
+void fetch_cheats(const std::filesystem::path &path) {
+    static std::atomic<bool> started{false};
+    const char *base = portablekit::game().cheats_download_base;
+    if (base == nullptr || base[0] == '\0' || started.exchange(true)) return;
+    const std::string url = std::string(base) + portablekit::game().disc_id + ".ini";
+    std::thread([path, url] {
+        std::string error;
+        const std::optional<std::string> text = android::update_get(url, error);
+        if (!text || text->size() < 8u) {
+            std::cout << "[cheats] the cheat file could not be downloaded: " << (error.empty() ? "empty answer" : error) << "\n";
+            return;
+        }
+        std::error_code ec;
+        std::filesystem::create_directories(path.parent_path(), ec);
+        std::ofstream out(path, std::ios::binary | std::ios::trunc);
+        out << *text;
+        std::cout << "[cheats] downloaded " << url << " into " << path.string() << "\n";
+    }).detach();
+}
+#endif
+
