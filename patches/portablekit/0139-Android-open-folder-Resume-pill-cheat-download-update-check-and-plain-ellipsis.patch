@@ -708,6 +708,9 @@ struct Client::Impl {
         for (auto it = datagrams.begin(); it != datagrams.end();) {
             DatagramSocket &socket = it->second;
             if (socket.closing) {
+                // The game sends its last datagram and closes the socket at once (the matching handshake's final answer, then a stop):
+                // what is still queued goes out first, or the other side never gets it and waits for ever.
+                socket.link.flush();
                 socket.link.close();
