+void adhoc_leave_relay() {
+    settings::Settings &s = settings::current();
+    if (settings::overridden_by("network.adhoc").empty()) s.adhoc = false;
+    if (settings::overridden_by("network.server").empty()) s.adhoc_server.clear();
+    settings::save();
+    adhoc::Client::log("[adhoc] leaving the relay, as asked", true);
+    adhoc_apply_settings(true);
+}
+
+void adhoc_auto_relay() {
+    const std::string relay = adhoc_relay_address();
+    if (relay.empty() || adhoc_hosting()) return;
+    settings::Settings &s = settings::current();
+    if (s.adhoc) return;  // already on line: the relay, a server the player typed, or a session they host
+    if (!settings::overridden_by("network.adhoc").empty() || !settings::overridden_by("network.server").empty()) return;
+    if (adhoc_room_code(s.adhoc_room).empty() && settings::overridden_by("network.room").empty()) s.adhoc_room = adhoc_new_room();
+    s.adhoc = true;
+    s.adhoc_server = relay;
+    adhoc::Client::log("[adhoc] the game joined a group: going on line through the relay", true);
+}
+
+bool adhoc_online_mode() { return adhoc_session_active() || adhoc_relay_selected(); }
