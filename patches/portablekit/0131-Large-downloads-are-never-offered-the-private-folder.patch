From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Thu, 19 Nov 2026 00:00:00 +0100
Subject: [PATCH] Large downloads are never offered the private folder

The places offered for a mod download began with the app private folder, which no file manager can open: a player who chose it could not see the files or open the mods folder. Only the shared area and the other external volumes are offered now.
---

diff --git a/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java b/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
index 6c6c4fd..860658e 100644
--- a/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
+++ b/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
@@ -386,11 +386,11 @@ public class GameActivity extends SDLActivity {
 
     // ---- Large downloads (a mod's data): where they can go, and the download itself. ----
 
-    /** The places a large file can go, as "path<TAB>name<TAB>free bytes": the app's own storage first, then each external volume. */
+    /** The places a large file can go, as "path<TAB>name<TAB>free bytes": the phone's shared area, then each other external volume. */
     public static String[] storageChoices() {
         java.util.ArrayList<String> choices = new java.util.ArrayList<>();
-        java.io.File own = mSingleton.getFilesDir();
-        choices.add(own.getPath() + "\t" + "Phone storage, private to the app" + "\t" + own.getUsableSpace());
+        // Not the app's private folder (getFilesDir()): no file manager can open it, so a player could never see the files or open the
+        // mods folder. Only places a file manager reaches are offered.
         java.io.File[] external = mSingleton.getExternalFilesDirs(null);
         if (external != null) {
             for (int i = 0; i < external.length; i++) {
-- 
