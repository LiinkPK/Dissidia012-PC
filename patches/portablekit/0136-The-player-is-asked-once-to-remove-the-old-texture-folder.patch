From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Thu, 19 Nov 2026 00:00:00 +0100
Subject: [PATCH] The player is asked once to remove the old texture folder

The texture pack is the textures folder itself now. An older install keeps a copy in a folder of it named for a disc id, which is no longer needed. When both are there, the menu opens on a question a few seconds into the run: remove it (deleted in the background, then the pack is reloaded) or keep it. The answer is kept in settings.ini as the folder path, so it is asked once, and the Textures page has a button to delete the folder later.
---

diff --git a/host/gpu/texture_pack_import.cpp b/host/gpu/texture_pack_import.cpp
index 1a83796..8fd2566 100644
--- a/host/gpu/texture_pack_import.cpp
+++ b/host/gpu/texture_pack_import.cpp
@@ -216,6 +216,19 @@ std::string friendly(const std::string &error) {
 
 } // namespace
 
+fs::path old_texture_folder(const fs::path &textures_root) {
+    std::error_code ec;
+    if (!fs::is_regular_file(textures_root / "textures.ini", ec)) return {};
+    fs::path found;
+    for (fs::directory_iterator it(textures_root, fs::directory_options::skip_permission_denied, ec);
+         !ec && it != fs::directory_iterator(); it.increment(ec)) {
+        std::error_code inner;
+        if (!it->is_directory(inner) || !fs::is_regular_file(it->path() / "textures.ini", inner)) continue;
+        if (found.empty() || it->path().filename() < found.filename()) found = it->path();
+    }
+    return found;
+}
+
 TexturePackLocation texture_pack_location(const fs::path &textures_root, const std::string &game_id,
                                           const std::string &in_place) {
     if (const char *variable = portablekit::env("TEXTURE_PACK"); variable != nullptr) {
diff --git a/host/gpu/texture_pack_import.hpp b/host/gpu/texture_pack_import.hpp
index bd59b27..1408fb2 100644
--- a/host/gpu/texture_pack_import.hpp
+++ b/host/gpu/texture_pack_import.hpp
@@ -39,6 +39,10 @@ struct TexturePackLocation {
     std::filesystem::path folder;
     Source source{Source::Installed};
 };
+// An older install's pack, once the pack is the textures folder itself: a folder of it (named for a disc id, with its own textures.ini)
+// that is no longer needed. Empty when the textures folder holds no pack of its own, or no such folder.
+[[nodiscard]] std::filesystem::path old_texture_folder(const std::filesystem::path &textures_root);
+
 [[nodiscard]] TexturePackLocation texture_pack_location(const std::filesystem::path &textures_root,
                                                         const std::string &game_id, const std::string &in_place);
 
diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index 0f0defb..44bb6ef 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -23,6 +23,7 @@
 #include "adhoc/session.hpp"
 #include "audio/audio_sink.hpp"
 #include "gpu/frame_pacing.hpp"
+#include "gpu/texture_pack_import.hpp"
 #include "gpu/vulkan_renderer.hpp"
 #include "profile.hpp"
 #include "input/bindings.hpp"
@@ -424,6 +425,25 @@ void save_cheats() {
     f.stamp = std::filesystem::last_write_time(f.path, ec);
 }
 
+// The question about the old texture folder is asked once: what was answered is kept in settings.ini as the folder's path.
+const char *const kOldTextureKey = "textures.old_folder_asked";
+std::string old_texture_asked() {
+    try {
+        const install::SettingsEntries entries = install::read_settings_file(install::user_data_directory());
+        if (const auto found = entries.find(kOldTextureKey); found != entries.end()) return found->second;
+    } catch (const std::exception &) {
+    }
+    return {};
+}
+void set_old_texture_asked(const std::string &folder) {
+    try {
+        const std::filesystem::path dir = install::user_data_directory();
+        install::SettingsEntries entries = install::read_settings_file(dir);
+        entries[kOldTextureKey] = folder;
+        install::write_settings_file(dir, entries);
+    } catch (const std::exception &) {
+    }
+}
 class Menu {
 public:
     explicit Menu(bool paused) : paused_(paused) {}
@@ -431,13 +451,14 @@ public:
     bool frame();
     [[nodiscard]] bool quit() const noexcept { return quit_; }
     // Opens on the System page with the update question up.
+    void ask_old_textures() { confirm_ = Confirm::OldTextures; }
     void show_update() {
         tab_ = 6;
         update_open_ = true;
     }
 
 private:
-    enum class Confirm { None, Quit, Setup };
+    enum class Confirm { None, Quit, Setup, OldTextures };
 
     void video();
     void audio();
@@ -2016,6 +2037,45 @@ bool Menu::confirm_dialog() {
             return true;
         }
         confirm_opened_ = true;
+        if (confirm_ == Confirm::OldTextures) {
+            // The pack is the textures folder itself now; an older install keeps a copy in a folder named for a disc. 0: asking, 1: removing, 2: done
+            static std::atomic<int> removing{0};
+            const std::filesystem::path old_folder = gpu::old_texture_folder(gpu::VulkanRenderer::textures_root());
+            heading("Remove the old texture folder?");
+            if (removing.load() == 2 || (removing.load() == 0 && old_folder.empty())) {
+                removing = 0;
+                Layer::get().renderer().reload_texture_pack();
+                confirm_ = Confirm::None;
+            } else if (removing.load() == 1) {
+                paragraph("Removing it…", colors::kTextDim);
+            } else {
+                paragraph("The HD texture pack now lives in the textures folder itself, and updates will go there. The older copy in " +
+                              install::path_to_utf8(old_folder) + " is no longer needed. Removing it frees the space.",
+                          colors::kTextDim);
+                ImGui::Dummy({0.0f, font * 0.6f});
+                const float gap = font * 0.6f;
+                const float width = (ImGui::GetContentRegionAvail().x - gap) * 0.5f;
+                if (big_button("Remove it", width, true)) {
+                    removing = 1;
+                    std::thread([old_folder] {
+                        std::error_code ec;
+                        std::filesystem::remove_all(old_folder, ec);
+                        set_old_texture_asked(install::path_to_utf8(old_folder));
+                        removing = 2;
+                    }).detach();
+                }
+                ImGui::SameLine(0.0f, gap);
+                if (big_button("Keep it", width)) {
+                    set_old_texture_asked(install::path_to_utf8(old_folder));
+                    confirm_ = Confirm::None;
+                }
+                ImGui::SetItemDefaultFocus();
+            }
+            ImGui::Dummy({0.0f, font * 0.2f});
+            if (confirm_ == Confirm::None) ImGui::CloseCurrentPopup();
+            ImGui::EndPopup();
+            return true;
+        }
         const bool quit = confirm_ == Confirm::Quit;
         heading(quit ? "Quit the game?" : "Set up game data again?");
         paragraph(quit ? "Progress since your last save is lost."
@@ -2271,6 +2331,15 @@ void add_system_rows(void (*rows)()) {
     if (rows != nullptr) system_rows().push_back(rows);
 }
 
+bool &old_textures_pending() {
+    static bool value = false;
+    return value;
+}
+bool &show_old_textures_on_open() {
+    static bool value = false;
+    return value;
+}
+
 // The update question is waiting to be shown: menu_requested() reports it as a menu request, and the menu that opens
 // for it starts on the question (show_update_on_open).
 bool &update_prompt_pending() {
@@ -2311,6 +2380,15 @@ void draw_over_game() {
         return true;
     }();
     (void)update_check_started;
+    // An older install keeps its texture pack in a folder named for a disc: asked about once, a few seconds in, when the pack the
+    // release ships (the textures folder itself) is there too.
+    static const std::chrono::steady_clock::time_point first_frame = std::chrono::steady_clock::now();
+    static bool old_textures_checked = false;
+    if (!menu && !old_textures_checked && std::chrono::steady_clock::now() - first_frame >= std::chrono::seconds(5)) {
+        old_textures_checked = true;
+        const std::filesystem::path old_folder = gpu::old_texture_folder(gpu::VulkanRenderer::textures_root());
+        if (!old_folder.empty() && old_texture_asked() != install::path_to_utf8(old_folder)) old_textures_pending() = true;
+    }
     static bool update_offered = false;
     // The question opens a second after the release is found, so the game is already running and pauses itself when the
     // menu opens over it (straight away, it opened before the game had a frame to pause on).
@@ -2371,6 +2449,7 @@ void open_menu_over_game() {
     layer.set_interactive(true);
     menu.emplace(false);
     if (std::exchange(show_update_on_open(), false)) menu->show_update();
+    if (std::exchange(show_old_textures_on_open(), false)) menu->ask_old_textures();
 }
 
 bool menu_over_game() { return menu_over_game_state().has_value(); }
@@ -2388,6 +2467,11 @@ bool menu_requested() {
         show_update_on_open() = true;
         return true;
     }
+    if (old_textures_pending()) {
+        old_textures_pending() = false;
+        show_old_textures_on_open() = true;
+        return true;
+    }
     return asked;
 }
 
@@ -2398,6 +2482,7 @@ bool run_menu() {
     layer.set_interactive(true);
     Menu menu(true);
     if (std::exchange(show_update_on_open(), false)) menu.show_update();
+    if (std::exchange(show_old_textures_on_open(), false)) menu.ask_old_textures();
     const bool window_open = layer.run([&] { return menu.frame(); }, true);
     layer.set_interactive(false);
     layer.renderer().set_game_input(true);
