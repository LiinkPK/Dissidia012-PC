From 28726c6da22dd91b2e9ecddc67ac93a0f0dd66b5 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 27 Nov 2026 10:40:49 +0100
Subject: [PATCH] TRACE_PASSES: which target each render pass begins on, and
 what ended the one before

---
 host/gpu/vulkan_renderer.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index 102b054..c33002b 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -2891,6 +2891,7 @@ struct VulkanRenderer::Impl {
     // and alpha; bit 1, every pixel's depth.
     void begin_pass(std::uint32_t address, std::uint32_t overwritten = 0u);
     void end_pass();
+    const char *last_pass_note{nullptr};  // what ended the pass before (TRACE_PASSES)
     VkPipeline pipeline_for(const PipelineKey &key);
     Texture &texture_for(const GuestMemory &memory, const DrawCall &call);
     void trace_framebuffer_texture(const DrawCall &call);
@@ -5088,6 +5089,12 @@ void VulkanRenderer::Impl::begin_pass(std::uint32_t address, std::uint32_t overw
     vkCmdBeginRenderPass(command_buffer, &pass, VK_SUBPASS_CONTENTS_INLINE);
     perf::count_render_pass();
     if ((overwritten & 3u) != 0u) perf::count_cleared_pass();
+    static const bool trace_passes = portablekit::env("TRACE_PASSES") != nullptr;
+    if (trace_passes)
+        std::cout << "[pass] frame " << frames << " into 0x" << std::hex << address << std::dec << " format "
+                  << target->format << (overwritten != 0u ? " (cleared)" : "") << " after "
+                  << (last_pass_note != nullptr ? last_pass_note : "?") << "\n";
+    last_pass_note = nullptr;
     forget_bindings();
     current_target = address;
     last_drawn_target = address;
@@ -6237,6 +6244,7 @@ void VulkanRenderer::Impl::record_writeback(std::uint32_t address) {
     if (!target.initialized || target.guest_words.empty() || target.stride < kPspWidth) return;
     if (target.stencil_sync == Target::StencilSync::StencilNewer) {
         bring_alpha_up_to_date(target);
+        last_pass_note = "writeback";
         end_pass();
     }
     if (writeback_image == VK_NULL_HANDLE) {
@@ -6462,6 +6470,7 @@ VkDescriptorSet VulkanRenderer::Impl::framebuffer_descriptor(Target &target, boo
     }
     if (!target.copy_valid || target.copy_serial != target.draw_serial) {
         bring_alpha_up_to_date(target);
+        last_pass_note = "fb copy";
         end_pass();
         transition(command_buffer, target.color, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
                    VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
@@ -7226,6 +7235,7 @@ void VulkanRenderer::Impl::copy_alpha_to_stencil(Target &target) {
                   << " from the alpha (format " << target.format << ")\n";
     const VkDescriptorSet copy = framebuffer_descriptor(target, false);
     if (copy == VK_NULL_HANDLE) return;
+    last_pass_note = "alpha to stencil";
     end_pass();
     const std::uint32_t last_drawn = last_drawn_target;
     begin_pass(target.address, 0u);
@@ -7268,6 +7278,7 @@ void VulkanRenderer::Impl::share_depth(Target &target, std::uint32_t address, st
     }
     const auto holder = targets.find(picture.holder);
     if (holder == targets.end() || !holder->second.initialized) return;
+    last_pass_note = "depth share";
     end_pass();
     initialize_layouts(command_buffer, target);
     transition(command_buffer, holder->second.depth, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL,
@@ -7300,6 +7311,7 @@ void VulkanRenderer::Impl::bring_alpha_up_to_date(Target &target) {
     if (target.stencil_sync != Target::StencilSync::StencilNewer || !target.initialized) return;
     const std::uint32_t last_drawn = last_drawn_target;
     if (!pass_active || current_target != target.address) {
+        last_pass_note = "stencil to alpha (other target)";
         end_pass();
         begin_pass(target.address, 0u);
     }
@@ -10624,6 +10636,7 @@ void VulkanRenderer::submit(const DrawCall &call, const GuestMemory &memory) {
         }
     }
     if (!impl.pass_active || impl.current_target != call.target.color_address) {
+        if (impl.pass_active) impl.last_pass_note = "draw into another target";
         impl.end_pass();
         // A clear that covers the whole screen, first in its pass, writes
         // every pixel of what it clears: nothing needs loading for it.
-- 
2.54.0.windows.1

