From 1d196951a048926da365ab481077e0f8a6d949b0 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Mon, 16 Nov 2026 22:26:37 +0100
Subject: [PATCH] Synchronous texture uploads wait on a fence of their own, not
 on the whole queue

vkQueueWaitIdle also waits for the present thread's queued presents and
interpolation replays. With frame interpolation (above 30 fps) on an NVIDIA GPU
that uses synchronous uploads, that wait froze the game.
---
 host/gpu/vulkan_renderer.cpp | 20 ++++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index e596957..41074c7 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -2207,6 +2207,20 @@ struct VulkanRenderer::Impl {
         const std::lock_guard<std::mutex> guard(presenter->queue);
         vkDeviceWaitIdle(device);
     }
+    // Submits one batch and waits for that batch alone, through a fence of its own. vkQueueWaitIdle (queue_wait_idle) also
+    // waits for every present and replay the present thread has queued, which can themselves wait on the emulation thread:
+    // with frame interpolation on, a synchronous texture upload waiting that way froze the game.
+    void queue_submit_and_wait(const VkSubmitInfo &submit) {
+        VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        VkFence fence{};
+        if (vkCreateFence(device, &fence_info, nullptr, &fence) != VK_SUCCESS) {
+            (void)queue_submit(1u, &submit, VK_NULL_HANDLE);
+            queue_wait_idle();
+            return;
+        }
+        if (queue_submit(1u, &submit, fence) == VK_SUCCESS) vkWaitForFences(device, 1u, &fence, VK_TRUE, UINT64_MAX);
+        vkDestroyFence(device, fence, nullptr);
+    }
     // A flip without interpolation, handed to the present thread: the newest
     // picture (take_picture) with this interface over it.
     bool plain_pending{};
@@ -4774,8 +4788,7 @@ void VulkanRenderer::Impl::run_commands(const std::function<void(VkCommandBuffer
     VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
     submit.commandBufferCount = 1u;
     submit.pCommandBuffers = &commands;
-    (void)queue_submit(1u, &submit, VK_NULL_HANDLE);
-    queue_wait_idle();
+    queue_submit_and_wait(submit);
     vkFreeCommandBuffers(device, command_pool, 1u, &commands);
 }
 
@@ -5044,8 +5057,7 @@ void VulkanRenderer::Impl::upload_texture(VkImage image, std::uint32_t width, st
     // Uploads are synchronous: the GPU finishes everything queued before this
     // returns, which counts as waiting rather than rendering.
     const perf::Clock::time_point wait_start = perf::Clock::now();
-    (void)queue_submit(1u, &submit, VK_NULL_HANDLE);
-    queue_wait_idle();
+    queue_submit_and_wait(submit);
     perf::add_wait_time(perf::Clock::now() - wait_start, perf::Stall::Upload);
     if (!reuse) {
         vkFreeCommandBuffers(device, command_pool, 1u, &commands);
