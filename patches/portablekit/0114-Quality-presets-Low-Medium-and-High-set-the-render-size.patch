From a5a7cf5adc6631492e5583894f67d8087187beb5 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Wed, 18 Nov 2026 11:57:41 +0100
Subject: [PATCH] Quality presets: Low, Medium and High set the render size,
 the HD textures and the HD text together

A Quality row on the Video page, and on the first run a device that is not a discrete GPU, or has under 3 GiB of device memory, starts on Low.
Desktop only; an environment variable that sets either option wins.
---
 host/gpu/vulkan_renderer.cpp | 23 ++++++++++++++++++
 host/settings/settings.cpp   | 46 ++++++++++++++++++++++++++++++++++++
 host/settings/settings.hpp   | 10 ++++++++
 host/ui/menu.cpp             | 21 ++++++++++++++++
 4 files changed, 100 insertions(+)

diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index 1d63537..0c8b200 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -3724,6 +3724,29 @@ bool VulkanRenderer::initialize(const RendererConfig &config, std::string &error
               << impl.target_extent.height << "\n";
     impl.ready = true;
     impl.note_window_size();
+#if !defined(__ANDROID__) && !defined(__APPLE__)
+    // First run: a weak graphics card starts on the Low quality preset instead of the default High (settings::Quality). Only a device
+    // that is not a discrete GPU, or has under 3 GiB of device-local memory, is moved; every other keeps the defaults. An environment
+    // variable that sets either option wins. The player can change it at once on the Video page.
+    if (settings::first_run() && portablekit::env("INTERNAL_SCALE") == nullptr && portablekit::env("TEXTURE_PACK") == nullptr) {
+        VkPhysicalDeviceMemoryProperties heaps{};
+        vkGetPhysicalDeviceMemoryProperties(impl.physical_device, &heaps);
+        VkDeviceSize local_bytes = 0;
+        for (std::uint32_t i = 0; i < heaps.memoryHeapCount; ++i)
+            if ((heaps.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) != 0u)
+                local_bytes = std::max(local_bytes, heaps.memoryHeaps[i].size);
+        const bool discrete = properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU;
+        if (!discrete || local_bytes < (3ull << 30)) {
+            settings::Settings &chosen = settings::current();
+            settings::apply_quality(chosen, settings::Quality::Low);
+            set_internal_scale(chosen.internal_scale);
+            set_texture_pack(chosen.texture_pack);
+            settings::save();
+            std::cout << "[render] first run: " << (discrete ? "a card with " : "a shared-memory or software device with ")
+                      << (local_bytes >> 20u) << " MiB of device memory; quality set to Low (Video page)\n";
+        }
+    }
+#endif
 #if !defined(__ANDROID__)
     // An exit that never stops the thread (one past the game's own, such as
     // the setup screens closing) stops it before the statics it uses go:
diff --git a/host/settings/settings.cpp b/host/settings/settings.cpp
index c2c1463..ad54f67 100644
--- a/host/settings/settings.cpp
+++ b/host/settings/settings.cpp
@@ -481,6 +481,7 @@ struct State {
     // back as the file had them.
     install::SettingsEntries file;
     std::map<std::string, std::string> overrides;
+    bool first_run{};  // settings.ini held nothing when it was read
 };
 
 State &state() {
@@ -494,6 +495,7 @@ void load(State &s) {
     try {
         s.data_dir = install::user_data_directory();
         s.file = install::read_settings_file(s.data_dir);
+        s.first_run = s.file.empty();
     } catch (const std::exception &e) {
         std::cerr << "[settings] cannot read settings.ini: " << e.what() << "\n";
     }
@@ -539,6 +541,50 @@ Settings &current() {
     return s.values;
 }
 
+bool first_run() {
+    State &s = state();
+    if (!s.loaded) load(s);
+    return s.first_run;
+}
+
+Quality quality_of(const Settings &s) {
+    if (s.internal_scale == 1u && !s.texture_pack && !s.hd_text) return Quality::Low;
+    if (s.internal_scale == 2u && !s.texture_pack && !s.hd_text) return Quality::Medium;
+    if (s.internal_scale == 2u && s.texture_pack && s.hd_text) return Quality::High;
+    return Quality::Custom;
+}
+
+void apply_quality(Settings &s, Quality quality) {
+    switch (quality) {
+    case Quality::Low:
+        s.internal_scale = 1u;
+        s.texture_pack = false;
+        s.hd_text = false;
+        break;
+    case Quality::Medium:
+        s.internal_scale = 2u;
+        s.texture_pack = false;
+        s.hd_text = false;
+        break;
+    case Quality::High:
+        s.internal_scale = 2u;
+        s.texture_pack = true;
+        s.hd_text = true;
+        break;
+    case Quality::Custom: break;
+    }
+}
+
+const char *quality_name(Quality quality) {
+    switch (quality) {
+    case Quality::Low: return "Low";
+    case Quality::Medium: return "Medium";
+    case Quality::High: return "High";
+    case Quality::Custom: break;
+    }
+    return "Custom";
+}
+
 std::string game_default_name() {
     const char *name = game().default_player_name;
     return name != nullptr ? name : "";
diff --git a/host/settings/settings.hpp b/host/settings/settings.hpp
index 901ffda..23f3292 100644
--- a/host/settings/settings.hpp
+++ b/host/settings/settings.hpp
@@ -186,6 +186,16 @@ inline constexpr Platform kPlatform = Platform::Desktop;
 // variables at what the file had. Failures are reported on the console.
 void save();
 
+// Quality presets: the three options that cost the most on a slow machine, set together. Low draws at the PSP's own size with no HD
+// textures and no HD text; Medium draws at twice that, still with neither; High is the default: twice the size with the HD texture pack
+// and HD text. A set of options that matches none of them is Custom. Nothing else is changed.
+enum class Quality { Low, Medium, High, Custom };
+[[nodiscard]] Quality quality_of(const Settings &s);
+void apply_quality(Settings &s, Quality quality);
+[[nodiscard]] const char *quality_name(Quality quality);
+// True when there was no settings.ini when the settings were first read: the first run of this installation.
+[[nodiscard]] bool first_run();
+
 // The environment variable that decides the setting stored under `key`
 // (for example "video.internal_scale") for this run, or null.
 // The environment variable that decided this setting, or empty when the
diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index 514533b..9058c77 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -552,6 +552,27 @@ void Menu::video() {
             settings::save();
         }
     }
+    {
+        // The three options that cost the most on a slow machine, set together (settings::Quality).
+        RowOptions o;
+        o.description = "Low: the PSP's own size, no HD textures, no HD text. Medium: twice that size, still without them. High: "
+                        "twice the size with the HD textures and HD text. Changing any of those yourself shows Custom.";
+        if (!settings::overridden_by("video.internal_scale").empty() || !settings::overridden_by("video.texture_pack").empty()) {
+            o.disabled = true;
+            o.note = "set by an environment variable";
+        }
+        const settings::Quality now = settings::quality_of(s);
+        if (const int delta = choice_row("Quality", settings::quality_name(now), o)) {
+            static const settings::Quality order[3] = {settings::Quality::Low, settings::Quality::Medium, settings::Quality::High};
+            int index = delta > 0 ? 0 : 2;  // from Custom: the first on the way up, the last on the way down
+            for (int i = 0; i < 3; ++i)
+                if (order[i] == now) index = cycle(i, delta, 3);
+            settings::apply_quality(s, order[index]);
+            renderer().set_internal_scale(s.internal_scale);
+            renderer().set_texture_pack(s.texture_pack);
+            settings::save();
+        }
+    }
 #if !defined(__ANDROID__)
     // A phone is always full screen: no window to size.
     {
-- 
