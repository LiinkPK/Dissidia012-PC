+
+std::string read_text(const std::filesystem::path &path) {
+    std::ifstream in(path, std::ios::binary);
+    std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    while (!text.empty() && (text.back() == '\r' || text.back() == '\n' || text.back() == ' ')) text.pop_back();
+    return text;
+}
+
+// Starts the script with no window of its own. It reports through a file: "N/total" while unpacking, then "unpacked",
+// or "failed: why".
+bool start_helper(const std::filesystem::path &zip, std::string &error) {
+    std::error_code ec;
+    const std::filesystem::path temp = std::filesystem::temp_directory_path(ec);
+    const std::filesystem::path script = temp / "d012_update.ps1";
+    g_progress_path = temp / "d012_update_progress.txt";
+    std::filesystem::remove(g_progress_path, ec);
+    {
+        std::ofstream out(script, std::ios::trunc);
+        out << kHelperScript;
+        if (!out) {
+            error = "the installer script could not be written";
+            return false;
+        }
     }
+    wchar_t exe_buffer[MAX_PATH * 4]{};
+    GetModuleFileNameW(nullptr, exe_buffer, MAX_PATH * 4);
+    const std::filesystem::path exe = exe_buffer;
     // By its full path: a PATH without the PowerShell folder must not keep the update from starting.
     wchar_t system_dir[MAX_PATH]{};
