     std::wstring powershell = std::wstring(system_dir) + L"\\WindowsPowerShell\\v1.0\\powershell.exe";
     if (!std::filesystem::exists(powershell, ec)) powershell = L"powershell.exe";
-    const std::wstring command = L"\"" + powershell + L"\" -NoProfile -ExecutionPolicy Bypass -File \"" +
-                                 script.wstring() + L"\" -ProcessId " + std::to_wstring(GetCurrentProcessId()) +
-                                 L" -Zip \"" + zip.wstring() + L"\" -Target \"" + exe.parent_path().wstring() +
-                                 L"\" -Exe \"" + exe.wstring() + L"\"";
+    const std::wstring command = L"\"" + powershell + L"\" -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" +
+                                 script.wstring() + L"\" -ProcessId " + std::to_wstring(GetCurrentProcessId()) + L" -Zip \"" +
+                                 zip.wstring() + L"\" -Target \"" + exe.parent_path().wstring() + L"\" -Exe \"" + exe.wstring() +
+                                 L"\" -Progress \"" + g_progress_path.wstring() + L"\"";
     std::vector<wchar_t> mutable_command(command.begin(), command.end());
     mutable_command.push_back(L'\0');
     STARTUPINFOW startup{};
     startup.cb = sizeof(startup);
+    startup.dwFlags = STARTF_USESHOWWINDOW;
+    startup.wShowWindow = SW_HIDE;
     PROCESS_INFORMATION process{};
-    // A console window of its own (it outlives the game, and shows the update's progress).
-    if (!CreateProcessW(nullptr, mutable_command.data(), nullptr, nullptr, FALSE, CREATE_NEW_CONSOLE, nullptr, nullptr,
-                        &startup, &process)) {
-        std::cerr << "[update] could not start " << std::filesystem::path(powershell).string() << " (error " << GetLastError() << ")\n";
+    // No window at all; the script outlives the game, which is what it waits for.
+    if (!CreateProcessW(nullptr, mutable_command.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP,
+                        nullptr, nullptr, &startup, &process)) {
+        error = "PowerShell could not be started (error " + std::to_string(GetLastError()) + ")";
         return false;
     }
-    CloseHandle(process.hProcess);
     CloseHandle(process.hThread);
+    if (g_helper != nullptr) CloseHandle(g_helper);
+    g_helper = process.hProcess;
     return true;
+}
+
+// Runs on the download's thread: starts the script, then follows what it reports until the update is unpacked.
+void unpack(const std::filesystem::path &zip) {
+    set_status([](Status &s) {
+        s.state = State::Unpacking;
+        s.progress = 0.0f;
+        s.error.clear();
+    });
+    std::string error;
+    if (!start_helper(zip, error)) {
+        set_status([&](Status &s) {
+            s.state = State::Failed;
+            s.error = error;
+        });
+        return;
+    }
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        std::string text = read_text(g_progress_path);
+        const bool stopped = WaitForSingleObject(g_helper, 0) == WAIT_OBJECT_0;
+        if (stopped) text = read_text(g_progress_path);  // what it wrote last
+        if (text == "unpacked") {
+            set_status([](Status &s) {
+                s.state = State::Ready;
+                s.progress = 1.0f;
+            });
+            return;
+        }
+        if (text.rfind("failed:", 0) == 0) {
+            set_status([&](Status &s) {
+                s.state = State::Failed;
+                s.error = text.substr(7);
+            });
+            return;
+        }
+        if (stopped) {
+            set_status([](Status &s) {
+                s.state = State::Failed;
+                s.error = "the installer stopped (see d012_update.log in the temp folder)";
+            });
+            return;
+        }
+        const std::size_t slash = text.find('/');
+        if (slash != std::string::npos) {
+            const double done = std::atof(text.substr(0, slash).c_str());
+            const double total = std::atof(text.substr(slash + 1u).c_str());
+            if (total > 0.0) set_status([&](Status &s) { s.progress = static_cast<float>(done / total); });
+        }
+    }
+}
+
+} // namespace
+#endif
+
+void start_download() {
+#if defined(_WIN32)
+    std::string url;
+    std::filesystem::path test_zip;
+    {
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_status.state != State::Available && g_status.state != State::Failed) return;
+        // D012_UPDATE_TEST_ZIP: a zip already on this disk, unpacked as if it had just been downloaded.
+        if (const char *test = std::getenv("D012_UPDATE_TEST_ZIP"); test != nullptr && *test != '\0') test_zip = test;
+        url = g_zip_url;
+        g_status.state = test_zip.empty() ? State::Downloading : State::Unpacking;
+        g_status.progress = 0.0f;
+        g_status.error.clear();
+    }
+    std::thread([url, test_zip] {
+        if (!test_zip.empty()) {
+            unpack(test_zip);
+            return;
+        }
+        if (url.empty()) {
+            set_status([](Status &s) {
+                s.state = State::Failed;
+                s.error = "the release has no zip to download";
+            });
+            return;
+        }
+        std::error_code ec;
+        const std::filesystem::path zip = std::filesystem::temp_directory_path(ec) / "d012_update.zip";
+        std::string error;
+        bool ok = false;
+        {
+            std::ofstream out(zip, std::ios::binary | std::ios::trunc);
+            ok = out && http_get(url, [&](const char *data, std::size_t n) { out.write(data, static_cast<std::streamsize>(n)); },
+                                 [](std::uint64_t done, std::uint64_t total) {
+                                     if (total != 0u)
+                                         set_status([&](Status &s) { s.progress = static_cast<float>(done) / static_cast<float>(total); });
+                                 },
+                                 error);
+        }
+        if (ok) {
+            {
+                const std::lock_guard<std::mutex> lock(g_mutex);
+                g_zip_path = zip;
+            }
+            unpack(zip);
+        } else {
+            std::filesystem::remove(zip, ec);
+            set_status([&](Status &s) {
+                s.state = State::Failed;
+                s.error = error.empty() ? "the download failed" : error;
+            });
+        }
+    }).detach();
+#endif
+}
+
+// The script is already running and waits for the game to close: the caller only has to quit.
+bool launch_installer() {
+#if defined(_WIN32)
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    return g_status.state == State::Ready && g_helper != nullptr;
 #else
     return false;
 #endif
