From 416fc0fd824efd17909bf8138170ecc4ed6939ec Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 27 Nov 2026 23:34:55 +0100
Subject: [PATCH] PASS_MERGE: record passes as secondary command buffers and
 merge passes into the same target (PPSSPP's ApplyRenderPassMerge)

---
 host/gpu/vulkan_renderer.cpp | 185 +++++++++++++++++++++++++++++++++--
 1 file changed, 176 insertions(+), 9 deletions(-)

diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index 9b4c2f1..239d83f 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -2909,6 +2909,7 @@ struct VulkanRenderer::Impl {
         return address != 0u && (address == display_addresses[0] || address == display_addresses[1]);
     }
     void submit_and_present(VkImage source, bool game_frame) {
+        flush_segments();
         submit_and_present(command_buffer, frame_fence, source, game_frame, true);
     }
     // `main_frame`: `commands` is the frame's own command buffer, which ends
@@ -2928,6 +2929,36 @@ struct VulkanRenderer::Impl {
     void begin_pass(std::uint32_t address, std::uint32_t overwritten = 0u);
     void end_pass();
     const char *last_pass_note{nullptr};  // what ended the pass before (TRACE_PASSES)
+    // Pass merging (<prefix>_PASS_MERGE, as PPSSPP's VulkanQueueRunner::ApplyRenderPassMerge). While a frame is recorded, each render
+    // pass, and each stretch of commands between two passes, goes into a secondary command buffer of its own (a Segment). When the
+    // frame is handed to the GPU the segments run in order, except that passes into the same target with only passes into other
+    // targets between them run as one render pass: its colour and depth are loaded and stored once instead of once per pass.
+    // A stretch between passes is a barrier, which no pass is moved across, unless it is only a switch of target (soft): nothing but
+    // those has been recorded in it, and no pass reads another target.
+    struct Segment {
+        VkCommandBuffer commands{};
+        bool pass{};
+        bool barrier{true};
+        std::uint32_t target{};
+        VkRenderPass render_pass{};
+        VkFramebuffer framebuffer{};
+        std::uint32_t overwritten{};
+        VkExtent2D area{};  // the render area; 0: the targets' size
+        bool merged{};      // run inside an earlier pass of the same target
+    };
+    bool pass_merge{};
+    bool segmenting{};
+    VkCommandBuffer primary_commands{};
+    std::vector<Segment> segments;
+    std::array<std::vector<VkCommandBuffer>, kMaxSlots> segment_buffers{};
+    std::uint32_t segment_next{};
+    void start_segments();
+    void open_segment(bool pass, std::uint32_t target, VkRenderPass render_pass, VkFramebuffer framebuffer,
+                      std::uint32_t overwritten);
+    void flush_segments();
+    void mark_segment_soft() {
+        if (segmenting && !segments.empty() && !segments.back().pass) segments.back().barrier = false;
+    }
     // The rectangle the scissors of the draws of the pass in progress cover (TRACE_PASSES): how much of the target a render area
     // limited to the drawn part would load and store.
     std::int32_t pass_area[4]{0x7fffffff, 0x7fffffff, 0, 0};
@@ -5105,7 +5136,11 @@ bool VulkanRenderer::Impl::create_upload(std::uint32_t width, std::uint32_t heig
 void VulkanRenderer::Impl::begin_pass(std::uint32_t address, std::uint32_t overwritten) {
     std::string error;
     Target *target = target_for(address, error);
-    if (target == nullptr) return;
+    if (target == nullptr) {
+        if (segmenting && !segments.empty()) segments.back().barrier = true;
+        return;
+    }
+    const bool fresh_target = !target->initialized;
     if (!target->initialized) {
         // Attachments are loaded, not cleared, so a new target starts undefined:
         // move it into the layouts the render pass expects once.
@@ -5125,9 +5160,15 @@ void VulkanRenderer::Impl::begin_pass(std::uint32_t address, std::uint32_t overw
                       (overwritten & 3u) != 0u ? " (cleared)" : "");
         breadcrumb(command_buffer, label);
     }
-    vkCmdBeginRenderPass(command_buffer, &pass, VK_SUBPASS_CONTENTS_INLINE);
-    perf::count_render_pass();
-    if ((overwritten & 3u) != 0u) perf::count_cleared_pass();
+    if (segmenting) {
+        // A target's first use moves its images into their layouts in the stretch before: no pass is moved across it.
+        if (fresh_target && !segments.empty()) segments.back().barrier = true;
+        open_segment(true, address, pass.renderPass, pass.framebuffer, overwritten);
+    } else {
+        vkCmdBeginRenderPass(command_buffer, &pass, VK_SUBPASS_CONTENTS_INLINE);
+        perf::count_render_pass();
+        if ((overwritten & 3u) != 0u) perf::count_cleared_pass();
+    }
     static const bool trace_passes = portablekit::env("TRACE_PASSES") != nullptr;
     if (trace_passes)
         std::cout << "[pass] frame " << frames << " into 0x" << std::hex << address << std::dec << " format "
@@ -5145,7 +5186,12 @@ void VulkanRenderer::Impl::begin_pass(std::uint32_t address, std::uint32_t overw
 void VulkanRenderer::Impl::end_pass() {
     flush_group();
     if (!pass_active) return;
-    vkCmdEndRenderPass(command_buffer);
+    if (segmenting) {
+        vkEndCommandBuffer(command_buffer);
+        open_segment(false, 0u, VK_NULL_HANDLE, VK_NULL_HANDLE, 0u);
+    } else {
+        vkCmdEndRenderPass(command_buffer);
+    }
     pass_active = false;
     static const bool trace_area = portablekit::env("TRACE_PASSES") != nullptr;
     if (trace_area && pass_area[2] > pass_area[0] && pass_area[3] > pass_area[1])
@@ -5154,6 +5200,109 @@ void VulkanRenderer::Impl::end_pass() {
                   << target_extent.height << "\n";
 }
 
+// Starts recording the frame's commands as segments (see Impl::Segment). `command_buffer` is then the segment being recorded
+// into; the frame's own command buffer is `primary_commands`, which flush_segments() fills.
+void VulkanRenderer::Impl::start_segments() {
+    static const bool wanted = portablekit::env("PASS_MERGE") != nullptr;
+    pass_merge = wanted;
+    if (!pass_merge || interpolating || segmenting) return;
+    primary_commands = command_buffer;
+    segments.clear();
+    segment_next = 0u;
+    segmenting = true;
+    open_segment(false, 0u, VK_NULL_HANDLE, VK_NULL_HANDLE, 0u);
+}
+
+void VulkanRenderer::Impl::open_segment(bool pass, std::uint32_t target, VkRenderPass render_pass,
+                                        VkFramebuffer framebuffer, std::uint32_t overwritten) {
+    std::vector<VkCommandBuffer> &buffers = segment_buffers[slot];
+    if (segment_next >= buffers.size()) {
+        VkCommandBufferAllocateInfo info{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        info.commandPool = command_pool;
+        info.level = VK_COMMAND_BUFFER_LEVEL_SECONDARY;
+        info.commandBufferCount = 1u;
+        VkCommandBuffer made{};
+        if (vkAllocateCommandBuffers(device, &info, &made) != VK_SUCCESS) {
+            std::cerr << "Renderer: no secondary command buffer\n";
+            std::abort();
+        }
+        buffers.push_back(made);
+    }
+    const VkCommandBuffer commands = buffers[segment_next++];
+    VkCommandBufferInheritanceInfo inherit{VK_STRUCTURE_TYPE_COMMAND_BUFFER_INHERITANCE_INFO};
+    inherit.renderPass = pass ? render_pass : VK_NULL_HANDLE;
+    inherit.subpass = 0u;
+    inherit.framebuffer = pass ? framebuffer : VK_NULL_HANDLE;
+    VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT |
+                  (pass ? VK_COMMAND_BUFFER_USAGE_RENDER_PASS_CONTINUE_BIT : 0u);
+    begin.pInheritanceInfo = &inherit;
+    vkBeginCommandBuffer(commands, &begin);
+    Segment segment{};
+    segment.commands = commands;
+    segment.pass = pass;
+    segment.barrier = true;
+    segment.target = target;
+    segment.render_pass = render_pass;
+    segment.framebuffer = framebuffer;
+    segment.overwritten = overwritten;
+    segments.push_back(segment);
+    command_buffer = commands;
+}
+
+// Ends the segments and records them into the frame's command buffer, merging passes (see Impl::Segment). Afterwards
+// `command_buffer` is the frame's own again.
+void VulkanRenderer::Impl::flush_segments() {
+    if (!segmenting) return;
+    end_pass();
+    vkEndCommandBuffer(command_buffer);
+    segmenting = false;
+    command_buffer = primary_commands;
+    // A pass into a target runs the later passes into it that nothing in between depends on: only passes into other targets,
+    // and stretches that are plain switches, lie between (no pass reads another target without a copy, which is a barrier).
+    for (std::size_t i = 0; i < segments.size(); ++i) {
+        Segment &head = segments[i];
+        if (!head.pass || head.merged) continue;
+        for (std::size_t j = i + 1; j < segments.size(); ++j) {
+            Segment &next = segments[j];
+            if (!next.pass) {
+                if (next.barrier) break;
+                continue;
+            }
+            if (next.target == head.target) next.merged = true;
+        }
+    }
+    std::vector<VkCommandBuffer> run;
+    for (std::size_t i = 0; i < segments.size(); ++i) {
+        const Segment &segment = segments[i];
+        if (!segment.pass) {
+            vkCmdExecuteCommands(primary_commands, 1u, &segment.commands);
+            continue;
+        }
+        if (segment.merged) continue;
+        run.clear();
+        run.push_back(segment.commands);
+        for (std::size_t j = i + 1; j < segments.size(); ++j) {
+            const Segment &next = segments[j];
+            if (!next.pass) {
+                if (next.barrier) break;
+                continue;
+            }
+            if (next.merged && next.target == segment.target) run.push_back(next.commands);
+        }
+        VkRenderPassBeginInfo pass{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+        pass.renderPass = segment.render_pass;
+        pass.framebuffer = segment.framebuffer;
+        pass.renderArea = {{0, 0}, segment.area.width != 0u ? segment.area : target_extent};
+        vkCmdBeginRenderPass(primary_commands, &pass, VK_SUBPASS_CONTENTS_SECONDARY_COMMAND_BUFFERS);
+        vkCmdExecuteCommands(primary_commands, static_cast<std::uint32_t>(run.size()), run.data());
+        vkCmdEndRenderPass(primary_commands);
+        perf::count_render_pass();
+        if ((segment.overwritten & 3u) != 0u) perf::count_cleared_pass();
+    }
+    segments.clear();
+}
+
 VulkanRenderer::Impl::Texture VulkanRenderer::Impl::create_texture(std::uint32_t width, std::uint32_t height,
                                                                    const std::uint32_t *pixels) {
     Texture texture = create_texture_image(width, height);
@@ -7160,8 +7309,15 @@ VkDescriptorSet VulkanRenderer::Impl::palette_view(const GuestMemory &memory, co
     pass.renderPass = palette_render_pass;
     pass.framebuffer = view.framebuffer;
     pass.renderArea = {{0, 0}, extent};
-    vkCmdBeginRenderPass(command_buffer, &pass, VK_SUBPASS_CONTENTS_INLINE);
-    perf::count_render_pass();
+    if (segmenting) {
+        // Its own pass, never merged: a number no target has.
