+        segments.back().area = extent;
+    } else {
+        vkCmdBeginRenderPass(command_buffer, &pass, VK_SUBPASS_CONTENTS_INLINE);
+        perf::count_render_pass();
+    }
     const VkViewport viewport{0.0f, 0.0f, static_cast<float>(extent.width), static_cast<float>(extent.height),
                               0.0f, 1.0f};
     const VkRect2D scissor{{0, 0}, extent};
@@ -7192,7 +7348,12 @@ VkDescriptorSet VulkanRenderer::Impl::palette_view(const GuestMemory &memory, co
     }
     vkCmdPushConstants(command_buffer, palette_layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0u, sizeof(push), push.data());
     vkCmdDraw(command_buffer, 3u, 1u, 0u, 0u);
-    vkCmdEndRenderPass(command_buffer);
+    if (segmenting) {
+        vkEndCommandBuffer(command_buffer);
+        open_segment(false, 0u, VK_NULL_HANDLE, VK_NULL_HANDLE, 0u);
+    } else {
+        vkCmdEndRenderPass(command_buffer);
+    }
     transition(command_buffer, view.image, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
                VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
     forget_bindings();
@@ -8773,6 +8934,7 @@ void VulkanRenderer::begin_frame() {
     impl.forget_bindings();
     impl.pass_active = false;
     impl.recording = true;
+    impl.start_segments();
 }
 
