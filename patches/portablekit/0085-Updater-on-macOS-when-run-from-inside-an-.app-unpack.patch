From ec38f6983ad364bd43aa2fee907e393fc2f599e5 Mon Sep 17 00:00:00 2001
From: LiinkPK <linkgarciafiverr@gmail.com>
Date: Mon, 9 Nov 2026 14:58:52 +0100
Subject: [PATCH] Updater on macOS: when run from inside an .app, unpack beside
 it and replace the whole .app (the player's data is outside it), clear the
 quarantine flag and open it again

---
 host/ui/updater.cpp | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/host/ui/updater.cpp b/host/ui/updater.cpp
index f7d6282..24f7931 100644
--- a/host/ui/updater.cpp
+++ b/host/ui/updater.cpp
@@ -479,6 +479,10 @@ const char *kHelperScript = R"SH(#!/bin/sh
 PID="$1"; PKG="$2"; TARGET="$3"; EXE="$4"; PROGRESS="$5"
 LOG="${TMPDIR:-/tmp}/d012_update.log"
 STAGE="$TARGET/update_staging"
+# Run from inside a macOS .app (.../X.app/Contents/MacOS/exe): the whole .app is replaced, never written into, so the unpacking
+# goes beside it and the player's data (kept outside the app) is not involved.
+APPDIR=""
+case "$EXE" in */Contents/MacOS/*) APPDIR="${EXE%%/Contents/MacOS/*}"; STAGE="$(dirname "$APPDIR")/.d012_update_staging" ;; esac
 report() { printf '%s\n' "$1" > "$PROGRESS"; }
 fail() { printf '%s\n' "$1" >> "$LOG"; report "failed: $1"; rm -rf "$STAGE"; exit 1; }
 printf 'started %s pkg=%s target=%s exe=%s\n' "$(date)" "$PKG" "$TARGET" "$EXE" > "$LOG"
@@ -503,6 +507,22 @@ report "unpacked"
 # Unpacked while the game ran. Once it has closed, the new files go over the game's own.
 while kill -0 "$PID" 2>/dev/null; do sleep 1; done
 sleep 1
+if [ -n "$APPDIR" ]; then
+  APPNAME="$(basename "$APPDIR")"
+  NEWAPP="$STAGE/$APPNAME"
+  [ -d "$NEWAPP" ] || fail "the update has no $APPNAME"
+  BACKUP="$(dirname "$APPDIR")/.$APPNAME.old"
+  rm -rf "$BACKUP"
+  mv "$APPDIR" "$BACKUP" || fail "the old app could not be moved aside"
+  if mv "$NEWAPP" "$APPDIR"; then rm -rf "$BACKUP"; else mv "$BACKUP" "$APPDIR"; fail "the new app could not be put in place"; fi
+  # A downloaded app carries the quarantine flag; the update came from the game itself, so it is cleared.
+  xattr -dr com.apple.quarantine "$APPDIR" 2>/dev/null
+  rm -rf "$STAGE"
+  case "$PKG" in "${TMPDIR:-/tmp}/"?*) rm -f "$PKG" ;; esac
+  printf 'installed (app)\n' >> "$LOG"
+  nohup open "$APPDIR" >/dev/null 2>&1 &
+  exit 0
+fi
 SRC="$STAGE/${PREFIX%/}"
 [ -n "$PREFIX" ] || SRC="$STAGE"
 # The overlays are replaced as a whole: a library of an older version left beside the new ones would be loaded with them.
-- 
2.54.0.windows.1

