From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Wed, 18 Nov 2026 12:00:00 +0100
Subject: [PATCH] Cheats: the page shows what each enabled cheat did

A cheat that does nothing was silent: unsupported code types and writes outside guest memory were dropped. Each run now
counts its writes, skipped writes, unsupported codes and unmet conditions; the Cheats page shows the result under the
cheat and the console prints it once.
---
diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index 4c381fe..ac846f1 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -177,6 +178,28 @@ std::FILE *cheat_log() {
 }
 bool cheat_logging = false;  // this run of the cheat is one of the logged ones
 
+// What the last run of each cheat did, shown on the Cheats page and printed once to the console: a cheat that "does
+// nothing" is otherwise silent (a write to an address that is not guest memory, a code type that is not supported, a
+// condition that never passes).
+struct CheatStat {
+    unsigned writes{};       // writes made
+    unsigned skipped{};      // writes whose address is not guest memory
+    unsigned unsupported{};  // codes of a type that is not supported (jokers, delay, PPSSPP's own)
+    unsigned failed{};       // conditions that did not pass
+    unsigned changed{};      // writes whose address held another value than the one written last frame: the game changed it
+    bool reported{};         // printed to the console already
+};
+CheatStat cheat_stat;  // the run in progress
+// The value each address was given by the cheats last frame, to tell a game that never reads the address from one that writes it back.
+std::map<std::uint32_t, std::uint32_t> &cheat_written() {
+    static std::map<std::uint32_t, std::uint32_t> written;
+    return written;
+}
+std::map<std::size_t, CheatStat> &cheat_stats() {  // by cheat number, the last run
+    static std::map<std::size_t, CheatStat> stats;
+    return stats;
+}
+
 // One cheat's codes against the guest's memory, as PPSSPP's CWCheatEngine
 // runs them (Core/CwCheat.cpp), less the joker, vibration and shader codes.
 void run_cheat(psprecomp::GuestMemory &m, const std::vector<CheatLine> &lines) {
@@ -188,7 +211,17 @@ void run_cheat(psprecomp::GuestMemory &m, const std::vector<CheatLine> &lines) {
     };
     const auto wr = [&](u32 a, int sz, u32 v) {
         if (cheat_logging) std::fprintf(cheat_log(), "  write %d bytes at %08X value %08X %s\n", sz, a, v, ok(a, static_cast<u32>(sz)) ? "" : "SKIPPED (not guest memory)");
-        if (!ok(a, static_cast<u32>(sz))) return;
+        if (!ok(a, static_cast<u32>(sz))) {
+            ++cheat_stat.skipped;
+            return;
+        }
+        ++cheat_stat.writes;
+        {
+            const std::uint32_t mask = sz == 1 ? 0xFFu : sz == 2 ? 0xFFFFu : 0xFFFFFFFFu;
+            const auto before = cheat_written().find(a);
+            if (before != cheat_written().end() && rd(a, sz) != before->second) ++cheat_stat.changed;
+            cheat_written()[a] = v & mask;
+        }
         if (sz == 1) m.store8(a, static_cast<std::uint8_t>(v));
         else if (sz == 2) m.store16(a, static_cast<std::uint16_t>(v));
         else m.store32(a, v);
@@ -326,6 +359,7 @@ void run_cheat(psprecomp::GuestMemory &m, const std::vector<CheatLine> &lines) {
                 }
                 if (!pass) i += l2.a;
             } else {
+                ++cheat_stat.unsupported;
                 return;  // jokers: no pad state here
             }
             break;
@@ -338,10 +372,13 @@ void run_cheat(psprecomp::GuestMemory &m, const std::vector<CheatLine> &lines) {
             if (cheat_logging)
                 std::fprintf(cheat_log(), "  condition at %08X wants %X, memory has %X: %s\n", addr(arg & 0x0FFFFFFFu), v,
                              rd(addr(arg & 0x0FFFFFFFu), b8 ? 1 : 2), passed ? "passes" : "fails, skips the next lines");
-            if (!passed) i += (p >> 16) & (b8 ? 0xFFu : 0xFFFu);
+            if (!passed) {
+                ++cheat_stat.failed;
+                i += (p >> 16) & (b8 ? 0xFFu : 0xFFFu);
+            }
             break;
         }
-        default: break;  // delay, PPSSPP's own codes: not supported
+        default: ++cheat_stat.unsupported; break;  // delay, PPSSPP's own codes: not supported
         }
     }
 }
@@ -1637,6 +1691,9 @@ void Menu::cheats() {
         info_row("Cheats", "None found");
         return;
     }
+    static bool show_status = false;  // off by default: the status is a diagnostic, listed after the codes when switched on
+    if (toggle_row("Show status", show_status, {false, {}, "Lists after the codes what each cheat that is on did on its last run."}))
+        show_status = !show_status;
     section("Codes");
     for (std::size_t i = 0; i < f.heads.size(); ++i) {
         std::string &line = f.lines[f.heads[i]];
@@ -1650,6 +1707,32 @@ void Menu::cheats() {
         }
         ImGui::PopID();
     }
+    // What each enabled cheat did on its last run, all together after the codes, and only when asked for.
+    if (show_status) {
+        section("Status");
+        bool any = false;
+        for (std::size_t i = 0; i < f.heads.size(); ++i) {
+            const std::string &line = f.lines[f.heads[i]];
+            if (line[2] != '1') continue;
+            any = true;
+            std::string title = line.size() > 3 ? line.substr(3) : std::string();
+            title.erase(0, title.find_first_not_of(" \t"));
+            if (title.empty()) title = "Cheat " + std::to_string(i + 1);
+            const auto found = cheat_stats().find(i);
+            std::string note;
+            if (f.codes[i].empty()) note = "No code lines";
+            else if (found == cheat_stats().end()) note = "Not run yet";
+            else if (found->second.unsupported != 0u) note = "Unsupported code type";
+            else if (found->second.skipped != 0u && found->second.writes == 0u) note = "Writes outside game memory";
+            else if (found->second.failed != 0u && found->second.writes == 0u) note = "Conditions not met";
+            else {
+                note = std::to_string(found->second.writes) + " writes per frame";
+                if (found->second.changed != 0u) note += ", " + std::to_string(found->second.changed) + " changed by the game";
+            }
+            info_row(title.c_str(), note);
+        }
+        if (!any) info_row("Status", "No cheat is on");
+    }
 }
 
 void Menu::mods() {
@@ -1994,7 +2093,17 @@ void apply_cheats(psprecomp::Runtime &runtime) {
             static std::map<std::size_t, unsigned> runs;
             cheat_logging = cheat_log() != nullptr && ++runs[i] <= 60u;
             if (cheat_logging) std::fprintf(cheat_log(), "cheat %zu \"%s\" run %u\n", i, f.lines[f.heads[i]].c_str() + 3, runs[i]);
+            cheat_stat = CheatStat{};
             run_cheat(runtime.memory(), f.codes[i]);
+            CheatStat &kept = cheat_stats()[i];
+            const bool was_reported = kept.reported;
+            kept = cheat_stat;
+            kept.reported = was_reported;
+            if (!kept.reported && runs[i] >= 2u) {  // the second run: the first may only have set a pointer up
+                kept.reported = true;
+                std::fprintf(stderr, "[cheats] \"%s\": %zu code lines, %u writes made, %u skipped (not guest memory), %u unsupported, %u conditions not met, %u values changed by the game\n",
+                             f.lines[f.heads[i]].c_str() + 3, f.codes[i].size(), kept.writes, kept.skipped, kept.unsupported, kept.failed, kept.changed);
+            }
             if (cheat_logging) std::fflush(cheat_log());
         }
 }
-- 
