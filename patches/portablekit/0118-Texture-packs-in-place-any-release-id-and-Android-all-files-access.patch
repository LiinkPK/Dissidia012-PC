diff --git a/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java b/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
index 63a346e..6c6c4fd 100644
--- a/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
+++ b/packaging/android/java/io/github/teamgdb/portablekit/GameActivity.java
@@ -149,6 +149,30 @@ public class GameActivity extends SDLActivity {
         Runtime.getRuntime().exit(0);
     }
 
+    /** Whether the app may read and write any folder on the phone (all files access on Android 11 and up, the storage permission before). */
+    public static boolean allFilesAccess() {
+        if (mSingleton == null) return false;
+        if (Build.VERSION.SDK_INT >= 30) return android.os.Environment.isExternalStorageManager();
+        return mSingleton.checkSelfPermission(android.Manifest.permission.WRITE_EXTERNAL_STORAGE)
+                == android.content.pm.PackageManager.PERMISSION_GRANTED;
+    }
+
+    /** Asks for that access: the system's settings page for this app (Android 11 and up), or the permission dialog. */
+    public static void requestAllFilesAccess() {
+        if (mSingleton == null) return;
+        if (Build.VERSION.SDK_INT >= 30) {
+            try {
+                mSingleton.startActivity(new Intent(android.provider.Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION,
+                        Uri.parse("package:" + mSingleton.getPackageName())));
+            } catch (Exception e) {
+                mSingleton.startActivity(new Intent(android.provider.Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION));
+            }
+        } else {
+            mSingleton.requestPermissions(new String[] {android.Manifest.permission.READ_EXTERNAL_STORAGE,
+                    android.Manifest.permission.WRITE_EXTERNAL_STORAGE}, 4242);
+        }
+    }
+
     /** The document that stands for a picked tree itself. */
     public static String treeRoot(String treeUri) {
         Uri tree = Uri.parse(treeUri);
