From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Wed, 18 Nov 2026 14:00:00 +0100
Subject: [PATCH] Texture packs in place, any release id, and Android all files access

The texture pack import offers only "Use this folder" (nothing is copied) and finds a pack whatever disc id it is named for. On Android the app asks once for all files access, and the in-game folder browser then lists any folder, SD cards included, so saves, cheats, mods, DLC and textures are used where they are.
---

diff --git a/host/gpu/texture_pack_import.cpp b/host/gpu/texture_pack_import.cpp
index b105f1c..1a83796 100644
--- a/host/gpu/texture_pack_import.cpp
+++ b/host/gpu/texture_pack_import.cpp
@@ -183,6 +183,25 @@ fs::path find_pack(const fs::path &chosen, const std::string &game_id, std::stri
             return candidate;
         }
     }
+    // The release's disc id is never a reason to refuse a pack: the same pack serves every region, so a folder named for another
+    // release (ULES01505 on a ULUS10566 disc) or a pack whose textures.ini lists other ids is used all the same. A folder named
+    // like a disc id comes first.
+    for (const fs::path &parent : {chosen, textures, psp_textures}) {
+        if (parent.empty()) continue;
+        std::vector<fs::path> candidates;
+        std::error_code ec;
+        for (fs::directory_iterator it(parent, fs::directory_options::skip_permission_denied, ec);
+             !ec && it != fs::directory_iterator(); it.increment(ec)) {
+            if (is_folder(it->path()) && is_file(it->path() / "textures.ini")) candidates.push_back(it->path());
+        }
+        std::sort(candidates.begin(), candidates.end(), [](const fs::path &a, const fs::path &b) {
+            const bool ia = looks_like_game_id(name_of(a)), ib = looks_like_game_id(name_of(b));
+            return ia != ib ? ia : a < b;
+        });
+        if (candidates.empty()) continue;
+        layout = "Found as " + name_of(candidates.front()) + "; the release it was made for does not matter.";
+        return candidates.front();
+    }
     return {};
 }
 
diff --git a/host/platform/android_jni.cpp b/host/platform/android_jni.cpp
index 18a1c5e..4be0539 100644
--- a/host/platform/android_jni.cpp
+++ b/host/platform/android_jni.cpp
@@ -81,6 +81,24 @@ void relaunch() {
     call.failed();
 }
 
+bool all_files_access() {
+    Call call;
+    if (!call.ok()) return false;
+    jmethodID id = call.method("allFilesAccess", "()Z");
+    if (id == nullptr) return false;
+    const jboolean granted = call.env->CallStaticBooleanMethod(call.type, id);
+    return !call.failed() && granted == JNI_TRUE;
+}
+
+void request_all_files_access() {
+    Call call;
+    if (!call.ok()) return;
+    jmethodID id = call.method("requestAllFilesAccess", "()V");
+    if (id == nullptr) return;
+    call.env->CallStaticVoidMethod(call.type, id);
+    call.failed();
+}
+
 namespace {
 std::string update_error(const Call &call) {
     jmethodID id = call.method("updateError", "()Ljava/lang/String;");
