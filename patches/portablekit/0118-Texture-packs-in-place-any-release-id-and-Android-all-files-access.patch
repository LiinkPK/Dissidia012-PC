 #elif defined(_WIN32)
     for (char letter = 'A'; letter <= 'Z'; ++letter) {
         const std::string root = std::string(1, letter) + ":\\";
@@ -245,6 +262,11 @@ FileBrowser::Result FileBrowser::frame(bool back) {
     // browser can read by name.
 #if defined(PORTABLEKIT_ANDROID_APP)
     const bool system_dialog = false;
+    // Outside the app's own folders Android lists nothing until the player allows all files access, once, in the system's settings.
+    if (!android::all_files_access() && chip("##allfiles", "Allow access to all files…")) {
+        android::request_all_files_access();
+        open(folder_);
+    }
