index 496452c..a966a09 100644
--- a/packaging/android/AndroidManifest.xml
+++ b/packaging/android/AndroidManifest.xml
@@ -18,12 +18,18 @@
     <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
     <!-- The in-app update hands the downloaded APK to Android's installer (the player is asked once to allow it). -->
