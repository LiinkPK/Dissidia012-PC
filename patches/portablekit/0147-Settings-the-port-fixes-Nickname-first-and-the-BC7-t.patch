diff --git a/host/gpu/texture_cache.cpp b/host/gpu/texture_cache.cpp
new file mode 100644
index 0000000..2322520
--- /dev/null
+++ b/host/gpu/texture_cache.cpp
@@ -0,0 +1,190 @@
+#include "texture_cache.hpp"
+
+#include "bc7enc16/bc7enc16.h"
+
+#include <algorithm>
+#include <cstring>
+#include <fstream>
+#include <mutex>
+#include <functional>
+#include <string>
+#include <system_error>
+#include <thread>
+
+namespace portablekit::gpu::texture_cache {
+
+namespace {
+
+constexpr std::uint32_t kVersion = 1u;
+constexpr std::uint32_t kFormatBc7 = 1u;
+constexpr std::uint32_t kMaxSide = 8192u;
+
+std::uint32_t level_count(std::uint32_t width, std::uint32_t height) {
+    std::uint32_t levels = 1u;
+    for (std::uint32_t side = std::max(width, height); side > 1u; side >>= 1u) ++levels;
+    return levels;
+}
+
+std::int64_t source_time_of(const std::filesystem::path &file) {
+    std::error_code ec;
+    const auto time = std::filesystem::last_write_time(file, ec);
+    return ec ? 0 : static_cast<std::int64_t>(time.time_since_epoch().count());
+}
+
+std::uint64_t source_size_of(const std::filesystem::path &file) {
+    std::error_code ec;
+    const auto size = std::filesystem::file_size(file, ec);
+    return ec ? 0u : static_cast<std::uint64_t>(size);
+}
+
+// Each pixel is the average of its 2x2 source texels, the last row and column
+// repeating when a side is odd.
+void halve(const std::vector<std::uint8_t> &src, std::uint32_t width, std::uint32_t height,
+           std::vector<std::uint8_t> &dst, std::uint32_t &next_width, std::uint32_t &next_height) {
+    next_width = std::max(width / 2u, 1u);
+    next_height = std::max(height / 2u, 1u);
+    dst.resize(static_cast<std::size_t>(next_width) * next_height * 4u);
+    for (std::uint32_t y = 0; y < next_height; ++y) {
+        const std::uint32_t y0 = std::min(y * 2u, height - 1u), y1 = std::min(y * 2u + 1u, height - 1u);
+        for (std::uint32_t x = 0; x < next_width; ++x) {
+            const std::uint32_t x0 = std::min(x * 2u, width - 1u), x1 = std::min(x * 2u + 1u, width - 1u);
+            const std::uint8_t *a = &src[(static_cast<std::size_t>(y0) * width + x0) * 4u];
+            const std::uint8_t *b = &src[(static_cast<std::size_t>(y0) * width + x1) * 4u];
+            const std::uint8_t *c = &src[(static_cast<std::size_t>(y1) * width + x0) * 4u];
+            const std::uint8_t *d = &src[(static_cast<std::size_t>(y1) * width + x1) * 4u];
+            std::uint8_t *out = &dst[(static_cast<std::size_t>(y) * next_width + x) * 4u];
+            for (int channel = 0; channel < 4; ++channel)
+                out[channel] = static_cast<std::uint8_t>((a[channel] + b[channel] + c[channel] + d[channel] + 2) / 4);
+        }
+    }
+}
+
+void encode_level(const std::uint8_t *pixels, std::uint32_t width, std::uint32_t height, std::uint8_t *out,
+                  const bc7enc16_compress_block_params &params) {
+    const std::uint32_t blocks_x = (width + 3u) / 4u, blocks_y = (height + 3u) / 4u;
+    for (std::uint32_t by = 0; by < blocks_y; ++by) {
+        for (std::uint32_t bx = 0; bx < blocks_x; ++bx) {
+            std::uint8_t block[64];
+            for (std::uint32_t y = 0; y < 4u; ++y) {
+                const std::uint32_t sy = std::min(by * 4u + y, height - 1u);
+                for (std::uint32_t x = 0; x < 4u; ++x) {
+                    const std::uint32_t sx = std::min(bx * 4u + x, width - 1u);
+                    std::memcpy(block + (y * 4u + x) * 4u, pixels + (static_cast<std::size_t>(sy) * width + sx) * 4u, 4u);
+                }
+            }
+            bc7enc16_compress_block(out + (static_cast<std::size_t>(by) * blocks_x + bx) * 16u, block, &params);
+        }
+    }
+}
+
+} // namespace
+
+std::uint64_t level_bytes(std::uint32_t width, std::uint32_t height) noexcept {
+    return static_cast<std::uint64_t>((width + 3u) / 4u) * ((height + 3u) / 4u) * 16u;
+}
+
+std::filesystem::path cache_path(const std::filesystem::path &folder, const std::string &name) {
+    std::string flat = name;
+    for (char &c : flat)
+        if (c == '/' || c == '\\' || c == ':') c = '_';
+    return folder / (flat + ".bc7");
+}
+
+bool load(const std::filesystem::path &file, const std::filesystem::path &source, Image &out) {
+    std::ifstream in(file, std::ios::binary);
+    if (!in) return false;
+    Header header{};
+    in.read(reinterpret_cast<char *>(&header), sizeof(header));
+    if (!in || std::memcmp(header.magic, "PKTC", 4u) != 0 || header.version != kVersion || header.format != kFormatBc7)
+        return false;
+    if (header.width == 0u || header.height == 0u || header.width > kMaxSide || header.height > kMaxSide ||
+        header.levels != level_count(header.width, header.height))
+        return false;
+    if (header.source_size != source_size_of(source) || header.source_time != source_time_of(source)) return false;
+
+    out.width = header.width;
+    out.height = header.height;
+    out.levels = header.levels;
+    out.level_offsets.clear();
+    std::uint64_t total = 0u;
+    for (std::uint32_t level = 0; level < out.levels; ++level) {
+        out.level_offsets.push_back(total);
+        total += level_bytes(std::max(out.width >> level, 1u), std::max(out.height >> level, 1u));
+    }
+    out.data.resize(static_cast<std::size_t>(total));
+    in.read(reinterpret_cast<char *>(out.data.data()), static_cast<std::streamsize>(total));
+    if (static_cast<std::uint64_t>(in.gcount()) != total) return false;
+    // Nothing may follow: a longer file is not the one that was written.
+    return in.peek() == std::ifstream::traits_type::eof();
+}
+
+bool bake(const std::filesystem::path &file, const std::filesystem::path &source, const std::uint8_t *rgba,
+          std::uint32_t width, std::uint32_t height) {
+    if (width == 0u || height == 0u || width > kMaxSide || height > kMaxSide) return false;
+    static std::once_flag once;
+    std::call_once(once, [] { bc7enc16_compress_block_init(); });
+    bc7enc16_compress_block_params params;
+    bc7enc16_compress_block_params_init(&params);
+    // Plain RGBA error: the images carry alpha, which the perceptual weights
+    // would let drift. A smaller partition search keeps a bake short.
+    bc7enc16_compress_block_params_init_linear_weights(&params);
+    params.m_max_partitions_mode1 = 16u;
+
+    const std::uint32_t levels = level_count(width, height);
+    std::vector<std::uint8_t> encoded;
+    {
+        std::uint64_t total = 0u;
+        for (std::uint32_t level = 0; level < levels; ++level)
+            total += level_bytes(std::max(width >> level, 1u), std::max(height >> level, 1u));
+        encoded.resize(static_cast<std::size_t>(total));
+    }
+    std::vector<std::uint8_t> current(rgba, rgba + static_cast<std::size_t>(width) * height * 4u), next;
+    std::uint32_t level_width = width, level_height = height;
+    std::uint64_t offset = 0u;
+    for (std::uint32_t level = 0; level < levels; ++level) {
+        encode_level(current.data(), level_width, level_height, encoded.data() + offset, params);
+        offset += level_bytes(level_width, level_height);
+        if (level + 1u == levels) break;
+        std::uint32_t next_width = 0u, next_height = 0u;
+        halve(current, level_width, level_height, next, next_width, next_height);
+        current.swap(next);
+        level_width = next_width;
+        level_height = next_height;
+    }
+
+    Header header{};
+    std::memcpy(header.magic, "PKTC", 4u);
+    header.version = kVersion;
+    header.format = kFormatBc7;
+    header.width = width;
+    header.height = height;
+    header.levels = levels;
+    header.source_size = source_size_of(source);
+    header.source_time = source_time_of(source);
+
+    std::error_code ec;
+    std::filesystem::create_directories(file.parent_path(), ec);
+    std::filesystem::path temporary = file;
+    // Two loaders may bake the same image; each writes its own file.
+    temporary += "." + std::to_string(std::hash<std::thread::id>{}(std::this_thread::get_id())) + ".tmp";
+    {
+        std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+        if (!out) return false;
+        out.write(reinterpret_cast<const char *>(&header), sizeof(header));
+        out.write(reinterpret_cast<const char *>(encoded.data()), static_cast<std::streamsize>(encoded.size()));
+        out.flush();
+        if (!out) {
+            out.close();
+            std::filesystem::remove(temporary, ec);
+            return false;
+        }
+    }
+    std::filesystem::rename(temporary, file, ec);
+    if (ec) {
+        std::filesystem::remove(temporary, ec);
+        return false;
+    }
+    return true;
+}
+
+} // namespace portablekit::gpu::texture_cache
diff --git a/host/gpu/texture_cache.hpp b/host/gpu/texture_cache.hpp
new file mode 100644
index 0000000..a6433ca
--- /dev/null
+++ b/host/gpu/texture_cache.hpp
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+// A compressed copy of a pack image, kept next to the pack and read instead of
+// the PNG. BC7 is a quarter of the size of RGBA8 in memory and on the GPU, it
+// is sampled as it is, and the mip chain is stored in the file, so loading
+// one is a file read: no PNG decode, no mip blits, a quarter of the upload.
+//
+// The copy is made once, in the background, the first time an image is used;
+// until then the image loads from the PNG as before. A copy is valid only for
+// the PNG it was made from (its size and modification time are stored).
+namespace portablekit::gpu::texture_cache {
+
+// The file is "PKTC", then these, then the levels' blocks, level 0 first.
