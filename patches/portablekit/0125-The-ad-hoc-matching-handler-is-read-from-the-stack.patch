From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Thu, 19 Nov 2026 00:00:00 +0100
Subject: [PATCH] The ad hoc matching handler is read from the stack

sceNetAdhocMatchingCreate takes nine arguments. The game keeps the ninth, the handler, at sp+0 (the PSP passes eight in registers); the HLE read register t4, a leftover value, so the first matching event called an address that is no code (0x00025D40) and the runtime stopped when a second player joined.
---

diff --git a/host/hle/hle_adhoc_matching_api.cpp b/host/hle/hle_adhoc_matching_api.cpp
index 4ff1298..20acf09 100644
--- a/host/hle/hle_adhoc_matching_api.cpp
+++ b/host/hle/hle_adhoc_matching_api.cpp
@@ -38,7 +38,7 @@ void register_api(HleRegistrar &hle) {
     });
 
     // (mode, maxnum, port, rxbuflen, hello_int, keepalive_int, init_count, rexmt_int, handler)
-    hle.add(kModule, "sceNetAdhocMatchingCreate", [](Runtime &, AllegrexContext &ctx) {
+    hle.add(kModule, "sceNetAdhocMatchingCreate", [](Runtime &runtime, AllegrexContext &ctx) {
         if (!state().initialized) return answer(ctx, err::kNotInitialized);
         const auto mode = static_cast<int>(arg(ctx, 0));
         const auto maxnum = static_cast<int>(arg(ctx, 1));
@@ -48,7 +48,8 @@ void register_api(HleRegistrar &hle) {
         const std::uint32_t keepalive_int = arg(ctx, 5);
         const auto init_count = static_cast<std::int32_t>(arg(ctx, 6));
         const std::uint32_t rexmt_int = arg(ctx, 7);
-        const std::uint32_t handler = arg(ctx, 8);
+        // The ninth argument is on the stack, at sp+0: the eight registers a0-a3 and t0-t3 carry the others (t4 holds a leftover value).
+        const std::uint32_t handler = runtime.memory().load32(ctx.gpr[29]);
         if (maxnum <= 1 || maxnum > 16) return answer(ctx, err::kInvalidMaxnum);
         if (rxbuflen < 6 * maxnum + 4) return answer(ctx, err::kRxbufTooShort);
         if (rxbuflen > 1024 * 1024) return answer(ctx, err::kNoSpace);
