diff --git a/host/worker_priority.hpp b/host/worker_priority.hpp
new file mode 100644
index 0000000..081bd24
--- /dev/null
+++ b/host/worker_priority.hpp
@@ -0,0 +1,38 @@
+#pragma once
+
+// Background workers (HD texture decoding, the pipeline prewarm) must not take the CPU from the game's own thread and the present
+// thread: on a computer with few cores they ran at the same priority and the game stuttered whenever a texture pack was decoding.
+// Call this first thing on such a thread. It only ever lowers the calling thread's priority, needs no privilege, and does nothing where
+// the platform has no cheap way. <prefix>_WORKER_PRIORITY=0 leaves the priority as it was, for comparing.
+#include "profile.hpp"
+
+#include <cstring>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#elif defined(__linux__) || defined(__ANDROID__)
+#include <sys/resource.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#elif defined(__APPLE__)
+#include <pthread.h>
+#endif
+
+namespace portablekit {
+
+inline void lower_worker_priority() {
+    if (const char *off = env("WORKER_PRIORITY"); off != nullptr && std::strcmp(off, "0") == 0) return;
+#if defined(_WIN32)
+    // Below normal, not the background mode: that one also lowers the disk priority, and these workers read files.
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+#elif defined(__linux__) || defined(__ANDROID__)
+    // A nice value is per thread on Linux when it is set by the thread id.
+    setpriority(PRIO_PROCESS, static_cast<id_t>(syscall(SYS_gettid)), 10);
+#elif defined(__APPLE__)
+    pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+#endif
+}
+
+} // namespace portablekit
