 host/gpu/vulkan_renderer.cpp |  3 +++
 host/worker_priority.hpp     | 38 ++++++++++++++++++++++++++++++++++++
 3 files changed, 43 insertions(+)
 create mode 100644 host/worker_priority.hpp

