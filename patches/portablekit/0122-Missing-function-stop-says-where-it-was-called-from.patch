From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Thu, 19 Nov 2026 00:00:00 +0100
Subject: [PATCH] The missing-function stop says where it was called from

The stop for a jump to an address with no recompiled function also prints ra, sp and the first argument registers, so a bad function pointer can be traced to its caller.
---

diff --git a/src/runtime.cpp b/src/runtime.cpp
index a24b7e9..4f1ed7b 100644
--- a/src/runtime.cpp
+++ b/src/runtime.cpp
@@ -686,7 +686,7 @@ void Runtime::run(std::uint32_t entry, std::uint64_t max_dispatches) {
             }
             if (function == nullptr) {
                 if (!run_interpreter_fallback(cpu_)) {
-                    stop("No recompiled function registered at " + hex32(before));
+                    stop("No recompiled function registered at " + hex32(before) + " (ra " + hex32(cpu_.gpr[31]) + ", sp " + hex32(cpu_.gpr[29]) + ", a0 " + hex32(cpu_.gpr[4]) + ", a1 " + hex32(cpu_.gpr[5]) + ", a2 " + hex32(cpu_.gpr[6]) + ", a3 " + hex32(cpu_.gpr[7]) + ", t0 " + hex32(cpu_.gpr[8]) + ")");
                     return;
                 }
             } else {
@@ -773,7 +773,7 @@ void Runtime::run(std::uint32_t entry, std::uint64_t max_dispatches) {
             }
             if (function == nullptr) {
                 if (!run_interpreter_fallback(cpu_)) {
-                    stop("No recompiled function registered at " + hex32(before));
+                    stop("No recompiled function registered at " + hex32(before) + " (ra " + hex32(cpu_.gpr[31]) + ", sp " + hex32(cpu_.gpr[29]) + ", a0 " + hex32(cpu_.gpr[4]) + ", a1 " + hex32(cpu_.gpr[5]) + ", a2 " + hex32(cpu_.gpr[6]) + ", a3 " + hex32(cpu_.gpr[7]) + ", t0 " + hex32(cpu_.gpr[8]) + ")");
                     break;
                 }
             } else {
@@ -842,7 +842,7 @@ void Runtime::run(std::uint32_t entry, std::uint64_t max_dispatches) {
         const FunctionEntry *function_entry = lookup_entry(before);
         if (function == nullptr) {
             if (!run_interpreter_fallback(cpu_)) {
-                stop("No recompiled function registered at " + hex32(before));
+                stop("No recompiled function registered at " + hex32(before) + " (ra " + hex32(cpu_.gpr[31]) + ", sp " + hex32(cpu_.gpr[29]) + ", a0 " + hex32(cpu_.gpr[4]) + ", a1 " + hex32(cpu_.gpr[5]) + ", a2 " + hex32(cpu_.gpr[6]) + ", a3 " + hex32(cpu_.gpr[7]) + ", t0 " + hex32(cpu_.gpr[8]) + ")");
                 break;
             }
         } else {
