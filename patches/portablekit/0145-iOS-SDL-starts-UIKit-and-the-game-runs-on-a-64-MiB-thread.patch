From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 <d012@localhost>
Date: Sat, 21 Nov 2026 12:30:00 +0000
Subject: [PATCH] iOS: SDL starts UIKit and the game runs on a 64 MiB thread

Nothing started UIKit on iOS (no SDL_main), and the main thread has about 1 MiB of stack.
---
diff --git a/host/main.cpp b/host/main.cpp
index 68f0faa..e06627e 100644
--- a/host/main.cpp
+++ b/host/main.cpp
@@ -45,6 +45,17 @@
 #include <unistd.h>
 #endif
 
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+#if defined(__APPLE__) && TARGET_OS_IPHONE && !defined(PORTABLEKIT_HOST_MAIN_NAME)
+// iPhone: SDL starts UIKit itself (SDL_main.h turns main below into SDL_main, which SDL's own main calls from
+// UIApplicationMain), and the game runs on a thread with the 64 MiB stack it needs: the main thread's is about 1 MiB.
+#define PORTABLEKIT_IOS_ENTRY 1
+#include <SDL3/SDL_main.h>
+#include <pthread.h>
+#endif
+
 namespace {
 
 // configs/nids.csv, compiled in (see tools/embed_nids.cmake), so the program
@@ -328,6 +339,8 @@ int run_adhoc_server(int argc, char **argv) {
 int portablekit_main(int argc, char **argv) {
 #elif defined(PORTABLEKIT_HOST_MAIN_NAME)
 int PORTABLEKIT_HOST_MAIN_NAME(int argc, char **argv) {
+#elif defined(PORTABLEKIT_IOS_ENTRY)
+int portablekit_game_main(int argc, char **argv) {
 #else
 int main(int argc, char **argv) {
 #endif
@@ -506,3 +519,39 @@ int main(int argc, char **argv) {
         return 1;
     }
 }
+
+#if defined(PORTABLEKIT_IOS_ENTRY)
+namespace {
+struct IosLaunch {
+    int argc;
+    char **argv;
+    int result;
+};
+
+void *run_ios_game(void *data) {
+    auto *launch = static_cast<IosLaunch *>(data);
+    launch->result = portablekit_game_main(launch->argc, launch->argv);
+    std::cout.flush();
+    std::cerr.flush();
+    return nullptr;
+}
+} // namespace
+
+// SDL_main (see the include above): runs the game on a thread with a 64 MiB stack and waits for it.
+int main(int argc, char **argv) {
+    constexpr std::size_t kGameStackBytes = 64u * 1024u * 1024u;
+    IosLaunch launch{argc, argv, 1};
+    pthread_attr_t attributes;
+    pthread_attr_init(&attributes);
+    pthread_attr_setstacksize(&attributes, kGameStackBytes);
+    pthread_t thread;
+    const int started = pthread_create(&thread, &attributes, run_ios_game, &launch);
+    pthread_attr_destroy(&attributes);
+    if (started != 0) {
+        std::cerr << "cannot start the game thread with a 64 MiB stack; running on the main thread\n";
+        return portablekit_game_main(argc, argv);
+    }
+    pthread_join(thread, nullptr);
+    return launch.result;
+}
+#endif
