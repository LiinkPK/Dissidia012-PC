+// ---- The editable pictures (PNG) of the pack, downloaded from the profile's address into data/textures_png ----
+// Windows, Linux and macOS only (they have the updater's download and a tar that reads .tar.gz). The game does not read this folder: a
+// player copies the pictures they edit into the textures folder, with the same folder structure. Nothing already there is overwritten.
+#if defined(_WIN32) || (defined(__linux__) && !defined(__ANDROID__)) || (defined(__APPLE__) && !defined(__ANDROID__))
+#define PK_PNG_PACK 1
+#endif
+
+#if defined(PK_PNG_PACK)
+struct PngPackJob {
+    std::atomic<int> phase{0};  // 0 idle, 1 downloading, 2 unpacking, 3 done, 4 failed
+    std::atomic<std::uint64_t> done{0}, total{0};
+    std::mutex mutex;
+    std::string message;  // the result: where the pictures are, or why it failed
+};
+
+std::shared_ptr<PngPackJob> &png_job() {
+    static std::shared_ptr<PngPackJob> job = std::make_shared<PngPackJob>();
+    return job;
+}
+
+// Runs a command with no window and returns its exit code (-1 when it could not start).
+int run_hidden(const std::string &command) {
+#if defined(_WIN32)
+    std::vector<char> line(command.begin(), command.end());
+    line.push_back('\0');
+    STARTUPINFOA startup{};
+    startup.cb = sizeof(startup);
+    PROCESS_INFORMATION process{};
+    if (!CreateProcessA(nullptr, line.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW, nullptr, nullptr, &startup, &process)) return -1;
+    WaitForSingleObject(process.hProcess, INFINITE);
+    DWORD code = 1;
+    GetExitCodeProcess(process.hProcess, &code);
+    CloseHandle(process.hProcess);
+    CloseHandle(process.hThread);
+    return static_cast<int>(code);
+#else
+    return std::system(command.c_str());
+#endif
+}
+
+void png_pack_thread(std::shared_ptr<PngPackJob> job, std::string url, fs::path data) {
+    const auto fail = [&](const std::string &why) {
+        {
+            const std::lock_guard<std::mutex> lock(job->mutex);
+            job->message = why;
+        }
+        job->phase = 4;
+        std::cout << "[texpack] png pack: " << why << std::endl;
+    };
+    std::error_code ec;
+    const fs::path dest = data / "textures_png";
+    const fs::path archive = data / "textures_png_download.tar.gz";
+    fs::create_directories(dest, ec);
+    // The archive is about 2.5 GB and unpacks to as much again: say so before starting when the disk is too small.
+    const fs::space_info space = fs::space(data, ec);
+    if (!ec && space.available < (6ull << 30)) return fail("not enough free space (about 6 GB are needed while it downloads and unpacks)");
+    std::string error;
+    job->phase = 1;
+    if (!updater::download_file(url, archive, 0u,
+                                [&](std::uint64_t done, std::uint64_t total) {
+                                    job->done = done;
+                                    job->total = total;
+                                },
+                                error)) {
+        fs::remove(archive, ec);
+        return fail("the download failed: " + error);
+    }
+    job->phase = 2;
+    // tar reads .tar.gz everywhere (Windows 10 and later ship bsdtar). The repository's top folder is dropped; files that are already in
+    // the destination are skipped, never overwritten.
+    const std::string a = utf8(archive), d = utf8(dest);
+    if (a.find('"') != std::string::npos || d.find('"') != std::string::npos) return fail("the data folder's path has a quote in it");
+#if defined(_WIN32)
+    char system_dir[MAX_PATH]{};
+    GetSystemDirectoryA(system_dir, MAX_PATH);
+    const std::string tar = std::string("\"") + system_dir + "\\tar.exe\"";
+    const std::string skip = "-k";
+#elif defined(__APPLE__)
+    const std::string tar = "tar", skip = "-k";
+#else
+    const std::string tar = "tar", skip = "--skip-old-files";
+#endif
+    const std::string command = tar + " -xzf \"" + a + "\" -C \"" + d + "\" --strip-components=1 " + skip +
+                                " --exclude=\"*/.github\" --exclude=\"*/.gitignore\"";
+    const int code = run_hidden(command);
+    fs::remove(archive, ec);
+    if (code != 0) return fail("unpacking failed (tar exit code " + std::to_string(code) + ")");
+    {
+        const std::lock_guard<std::mutex> lock(job->mutex);
+        job->message = "The pictures are in " + utf8(dest) + ". Copy only the ones you edit into the textures folder, keeping their folder structure.";
+    }
+    job->phase = 3;
+    std::cout << "[texpack] png pack unpacked into " << utf8(dest) << std::endl;
+}
+
+void png_pack_rows() {
+    const char *url = portablekit::game().png_pack_url;
+    if (url == nullptr || *url == '\0') return;
+    const std::shared_ptr<PngPackJob> job = png_job();
+    const int phase = job->phase;
+    if (phase == 1 || phase == 2) {
+        if (phase == 1) {
+            const double done = static_cast<double>(job->done.load()) / (1024.0 * 1024.0);
+            const double total = static_cast<double>(job->total.load()) / (1024.0 * 1024.0);
+            char text[96];
+            if (total > 0.0) std::snprintf(text, sizeof(text), "%.0f of %.0f MB", done, total);
+            else std::snprintf(text, sizeof(text), "%.0f MB", done);
+            info_row("Downloading the editable textures", text);
+        } else {
+            info_row("Editable textures", "Unpacking...");
+        }
+        return;
+    }
+    if (phase == 3 || phase == 4) {
+        std::string message;
+        {
+            const std::lock_guard<std::mutex> lock(job->mutex);
+            message = job->message;
+        }
+        info_row(phase == 3 ? "Editable textures" : "Editable textures: failed", message);
+    }
+    if (button_row("Download the editable textures (PNG)...",
+                   {false, {},
+                    "Downloads the texture pack's original pictures (about 2.5 GB) into the data folder's textures_png folder, to edit. "
+                    "Files you already have there are not overwritten. The game reads only the textures folder: copy the ones you "
+                    "edit into it, with the same folder structure."})) {
+        job->phase = 1;
+        job->done = 0;
+        job->total = 0;
+        std::thread(png_pack_thread, job, std::string(url), install::user_data_directory()).detach();
+    }
+}
+#endif
+
 } // namespace
 
