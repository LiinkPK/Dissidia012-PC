+// For a row of another kind (a text box): the hand and the bookkeeping a Row does, for the item just drawn, when it has the cursor.
+void focus_marker(ImVec2 min, ImVec2 max) {
+    if (!ImGui::IsItemFocused()) return;
+    const ImGuiID id = ImGui::GetItemID();
+    if (id != row_last_focused) pointer_since = ImGui::GetTime();
+    if (id != row_last_focused && ImGui::GetFrameCount() - row_focus_frame <= 2) sound::play(sound::Cue::Navigate);
+    row_last_focused = id;
+    row_focus_frame = ImGui::GetFrameCount();
+    draw_hand(min, max);
+}
