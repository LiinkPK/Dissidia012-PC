@@ -72,6 +72,33 @@ ImTextureData *pointer_texture = nullptr;
 ImVec2 pointer_uv0{0, 0}, pointer_uv1{1, 1};
 float pointer_aspect = 1.0f;  // width over height of that part
 
+// The pointing hand in the margin at the left of a focused row (min and max are the row's corners).
+void draw_hand(ImVec2 min, ImVec2 max) {
+    const float mid = (min.y + max.y) * 0.5f, size = font() * 0.34f;
+    // Drawn on the foreground list: it lies outside the scrolling area, which would clip it away.
+    ImDrawList *front = ImGui::GetForegroundDrawList();
+    // The hand goes under the header and the footer with the rows: clipped to the list's height (and not to its width: the hand is in
+    // the margin beside it).
+    const ImGuiWindow *list = ImGui::GetCurrentWindow();
+    front->PushClipRect({0.0f, list->InnerClipRect.Min.y}, {ImGui::GetIO().DisplaySize.x, list->InnerClipRect.Max.y}, false);
+    if (pointer_texture != nullptr) {
+        const float hand_height = font() * 1.3f, hand_width = hand_height * pointer_aspect;
+        // The hand points at the row: right and back, right and back (two beats), then a 2 second pause, over and over.
+        const double beat = 0.20, gap = 0.04, moving = 2.0 * beat, cycle = moving + 1.7;
+        const double into_cycle = std::fmod(ImGui::GetTime() - pointer_since, cycle);
+        const float shift = into_cycle < moving
+                                ? static_cast<float>(std::sin(3.14159265358979 * std::fmod(into_cycle, beat) / beat)) * font() * 0.3f
+                                : 0.0f;
+        front->AddImage(pointer_texture->GetTexRef(),
+                        {min.x - px(6.0f) - hand_width + shift, mid - hand_height * 0.5f + px(3.0f)},
+                        {min.x - px(6.0f) + shift, mid + hand_height * 0.5f + px(3.0f)}, pointer_uv0, pointer_uv1);
+    } else {
+        front->AddTriangleFilled({min.x - px(20.0f), mid - size}, {min.x - px(20.0f), mid + size},
+                                 {min.x - px(20.0f) + size * 1.6f, mid}, colors::kAccentBright);
+    }
+    front->PopClipRect();
+}
+
