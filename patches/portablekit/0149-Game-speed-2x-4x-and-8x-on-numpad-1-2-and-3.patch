From 4ef0c17f97480e71c59a1781f0ad5e50782209eb Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Sun, 22 Nov 2026 15:06:47 +0100
Subject: [PATCH] Game speed 2x, 4x and 8x, on numpad 1, 2 and 3

Game speed is Normal, 2x, 4x, 8x or Unlimited (settings.ini video.game_speed, D012_GAME_SPEED). 2x, 4x and 8x use the pacing hold that fast
loading uses, with a smaller factor, drop the game's sound (it would play that many times too fast), thin the presents out and turn frame
interpolation off. Numpad 1, 2 and 3 switch to 2x, 4x and 8x, and the same key again back to Normal, outside the menu's text fields. While
the game is online the speed is always Normal (adhoc_game_speed) and the keys do nothing.
---
 host/adhoc/host.cpp          |  2 ++
 host/adhoc/session.hpp       |  2 ++
 host/gpu/vulkan_renderer.cpp | 15 ++++++++++++++-
 host/hle/hle_media.cpp       |  4 ++--
 host/kernel/fast_loading.cpp |  2 ++
 host/kernel/kernel.cpp       |  9 ++++++---
 host/kernel/kernel.hpp       |  3 ++-
 host/settings/settings.cpp   | 12 ++++++++++++
 host/settings/settings.hpp   |  1 +
 host/ui/menu.cpp             | 13 +++++++++----
 10 files changed, 52 insertions(+), 11 deletions(-)

diff --git a/host/adhoc/host.cpp b/host/adhoc/host.cpp
index 563fae3..c627e59 100644
--- a/host/adhoc/host.cpp
+++ b/host/adhoc/host.cpp
@@ -168,6 +168,8 @@ void adhoc_auto_relay() {
 
 bool adhoc_online_mode() { return adhoc_session_active() || adhoc_relay_selected(); }
 
+unsigned adhoc_game_speed() { return adhoc_online_mode() ? 1u : settings::current().game_speed; }
+
 bool adhoc_unthrottled() { return settings::current().unthrottled && !adhoc_online_mode(); }
 
 void adhoc_join(const std::string &address) {
diff --git a/host/adhoc/session.hpp b/host/adhoc/session.hpp
index cf20000..516da49 100644
--- a/host/adhoc/session.hpp
+++ b/host/adhoc/session.hpp
@@ -44,6 +44,8 @@ void adhoc_auto_relay();
 [[nodiscard]] bool adhoc_online_mode();
 // The Game speed setting as it applies now: Unlimited never applies while the game is online (the setting itself is kept).
 [[nodiscard]] bool adhoc_unthrottled();
+// The Game speed multiplier (1, 2, 4 or 8) as it applies now: always 1 while the game is online.
+[[nodiscard]] unsigned adhoc_game_speed();
 // True when a host's or player's product code is of the edition this instance runs.
 [[nodiscard]] bool adhoc_same_edition(const std::string &product);
 
diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index 1fa2f76..6af87bd 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -7545,6 +7545,19 @@ bool VulkanRenderer::pump_events() {
 #endif
         if (event.type == SDL_EVENT_KEY_DOWN && event.key.key == SDLK_F3 && !event.key.repeat && impl_->overlay_ready)
             impl_->overlay_visible = !impl_->overlay_visible;
+        // Numpad 1, 2 and 3: Game speed 2x, 4x and 8x; the same key again goes back to Normal. Not online (the speed is locked there)
+        // and not while a text field is being typed in.
+        if (event.type == SDL_EVENT_KEY_DOWN && !event.key.repeat && !SDL_TextInputActive(impl_->window) && !adhoc_online_mode()) {
+            const std::uint32_t wanted = event.key.key == SDLK_KP_1 ? 2u : event.key.key == SDLK_KP_2 ? 4u : event.key.key == SDLK_KP_3 ? 8u : 0u;
+            if (wanted != 0u) {
+                settings::Settings &s = settings::current();
+                s.unthrottled = false;
+                s.game_speed = s.game_speed == wanted ? 1u : wanted;
+                std::printf("[speed] game speed %ux
+", s.game_speed);
+                std::fflush(stdout);
+            }
+        }
     }
 #if !defined(__ANDROID__)
     // Hide the pointer over the window after 2 seconds without moving; any move brings it back (above). While the mouse is
@@ -10928,7 +10941,7 @@ double VulkanRenderer::Impl::wanted_rate() const {
 bool VulkanRenderer::Impl::interpolation_wanted() const {
     // Emulated time running ahead of real time already presents faster than
     // the game's own rate; the keyboard's held frame is shown as it is.
-    return frame_rate != settings::FrameRate::Fps30 && !adhoc_unthrottled() && !holding && !fast_forward &&
+    return frame_rate != settings::FrameRate::Fps30 && !adhoc_unthrottled() && adhoc_game_speed() == 1u && !holding && !fast_forward &&
            governor.rate() > pacing::game_rate() + 0.5;
 }
 
diff --git a/host/hle/hle_media.cpp b/host/hle/hle_media.cpp
index eb8fbee..93cf05b 100644
--- a/host/hle/hle_media.cpp
