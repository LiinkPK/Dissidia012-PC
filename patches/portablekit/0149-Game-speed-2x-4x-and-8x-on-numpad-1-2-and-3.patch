+             return true;
+         },
+         [](const Settings &s) { return std::to_string(s.game_speed); },
+         [](Settings &s, const char *t) {
+             const long value = t != nullptr ? std::strtol(t, nullptr, 10) : 1;
+             if (value == 2 || value == 4 || value == 8) s.game_speed = static_cast<std::uint32_t>(value);
+         }},
         {"video.fast_loading", "FAST_LOADING",
          [](Settings &s, const std::string &t) { return parse_bool(t, s.fast_loading); },
          [](const Settings &s) { return std::string(s.fast_loading ? "1" : "0"); },
