diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index c6e9f31..031557d 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -812,14 +812,19 @@ void Menu::video() {
     }
     {
         const bool online = adhoc_online_mode();
-        RowOptions o = options_for("video.unthrottled", "Normal holds the game to real time. Unlimited lets it run as "
-                                                        "fast as frames can be drawn, which also speeds up the game.");
+        RowOptions o = options_for("video.unthrottled", "Normal holds the game to real time. 2x, 4x and 8x run it that "
+                                                        "many times faster (sound off); Unlimited as fast as frames can be "
+                                                        "drawn. Numpad 1, 2 and 3 switch to 2x, 4x and 8x without the menu.");
         if (online) {
             o.disabled = true;
             o.note = "Locked to Normal while you play online";
         }
-        if (choice_row("Game speed", s.unthrottled && !online ? "Unlimited" : "Normal", o) && !online) {
-            s.unthrottled = !s.unthrottled;
+        static const char *const kSpeeds[] = {"Normal", "2x", "4x", "8x", "Unlimited"};
+        const int current = online ? 0 : s.unthrottled ? 4 : s.game_speed == 2u ? 1 : s.game_speed == 4u ? 2 : s.game_speed == 8u ? 3 : 0;
+        if (const int delta = choice_row("Game speed", kSpeeds[current], o); delta != 0 && !online) {
+            const int next = cycle(current, delta, 5);
+            s.unthrottled = next == 4;
+            s.game_speed = next == 1 ? 2u : next == 2 ? 4u : next == 3 ? 8u : 1u;
             settings::save();
         }
     }
