     const bool presented = renderer.present(address, kernel().real_time_of(frame_start_us(kernel().last_vblank_us())));
@@ -349,7 +349,7 @@ void present_frame(Runtime &rt) {
         const char *text = portablekit::env("TEST_GUEST_SPIN_MS");
         return text != nullptr ? std::clamp(std::strtod(text, nullptr), 0.0, 30.0) : 0.0;
     }();
-    if (spin_ms > 0.0 && !adhoc_unthrottled() && !fast_loading::active()) {
+    if (spin_ms > 0.0 && !adhoc_unthrottled() && adhoc_game_speed() == 1u && !fast_loading::active()) {
         static const bool poll = portablekit::env("NO_CODE_PRESENT_POLL") == nullptr;
         const perf::Clock::time_point until =
             perf::Clock::now() + std::chrono::microseconds(static_cast<std::int64_t>(spin_ms * 1000.0));
diff --git a/host/kernel/fast_loading.cpp b/host/kernel/fast_loading.cpp
index ef47afd..d0bfaaa 100644
--- a/host/kernel/fast_loading.cpp
+++ b/host/kernel/fast_loading.cpp
@@ -81,6 +81,8 @@ void note_disc_read() { state().detector.disc_read(kernel().now_us()); }
 bool note_audio(int peak) {
     // Forced fast time: the sound the game makes is dropped, not played sixteen times too fast.
     if (state().forced && sample_guards().enabled) return true;
+    // Game speed above 1: the sound would play that many times too fast, so it is dropped.
+    if (adhoc_game_speed() > 1u && windowed()) return true;
     Detector &detector = state().detector;
     const bool was_fast = detector.fast();
     const bool drop = detector.audio(kernel().now_us(), peak);
diff --git a/host/kernel/kernel.cpp b/host/kernel/kernel.cpp
index 94246a4..871e92a 100644
--- a/host/kernel/kernel.cpp
+++ b/host/kernel/kernel.cpp
@@ -534,9 +534,12 @@ bool Kernel::pace_to_real_time() {
     // fast as real time (kernel/fast_loading.hpp). Either change starts the
     // hold over from the current moment, so a load that ran fast is not made
     // up for afterwards, and normal time is not rushed to catch up with it.
-    const bool fast = fast_loading::active();
-    if (fast != pacing_fast_) {
+    // Game speed (2x, 4x, 8x) is the same hold with a smaller factor; a load running fast takes precedence.
+    const double speed = fast_loading::active() ? fast_loading::kMaxSpeed : static_cast<double>(adhoc_game_speed());
+    const bool fast = speed > 1.0;
+    if (fast != pacing_fast_ || speed != pacing_speed_) {
         pacing_fast_ = fast;
+        pacing_speed_ = speed;
         pacing_started_ = false;
     }
     using Clock = std::chrono::steady_clock;
@@ -551,7 +554,7 @@ bool Kernel::pace_to_real_time() {
         std::chrono::duration_cast<std::chrono::microseconds>(now - pacing_real_base_).count();
     const std::int64_t virtual_us = static_cast<std::int64_t>(now_us_ - pacing_virtual_base_);
     const std::int64_t ahead_us =
-        fast ? static_cast<std::int64_t>(static_cast<double>(virtual_us) / fast_loading::kMaxSpeed) - real_us
+        fast ? static_cast<std::int64_t>(static_cast<double>(virtual_us) / speed) - real_us
              : virtual_us - real_us;
     // Ahead of real time: wait. More than a tenth of a second behind (a slow
     // frame, a load): drop the debt instead of racing to make it up.
diff --git a/host/kernel/kernel.hpp b/host/kernel/kernel.hpp
index d542b73..276dfe1 100644
--- a/host/kernel/kernel.hpp
+++ b/host/kernel/kernel.hpp
@@ -422,7 +422,8 @@ private:
     std::uint64_t busy_waits_{};
     std::chrono::steady_clock::time_point busy_since_{};
     bool pacing_started_{};
-    bool pacing_fast_{};  // the hold lets emulated time run ahead: a load runs fast
+    bool pacing_fast_{};  // the hold lets emulated time run ahead: a load runs fast, or Game speed is above 1
+    double pacing_speed_{1.0};
     std::chrono::steady_clock::time_point pacing_real_base_{};
     std::uint64_t pacing_virtual_base_{};
     IdleHook idle_hook_;
diff --git a/host/settings/settings.cpp b/host/settings/settings.cpp
index 2ebbd1d..88f1582 100644
--- a/host/settings/settings.cpp
