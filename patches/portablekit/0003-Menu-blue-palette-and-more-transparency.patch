From d5f52183f420125468c106db11656577ef483c44 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 25 Nov 2026 15:21:11 +0100
Subject: [PATCH] Menu: a blue palette and a more transparent panel and
 backdrop

The menu's colours (widgets.hpp, make_style) go from amber to blue, and the panel and backdrop alpha drop (246 to 205, 170 to 120) so
the game shows through.
---
 host/ui/widgets.cpp | 18 +++++++++---------
 host/ui/widgets.hpp | 24 ++++++++++++------------
 2 files changed, 21 insertions(+), 21 deletions(-)

diff --git a/host/ui/widgets.cpp b/host/ui/widgets.cpp
index 56b1ce4..b59d864 100644
--- a/host/ui/widgets.cpp
+++ b/host/ui/widgets.cpp
@@ -233,18 +233,18 @@ ImGuiStyle make_style(float scale, float font_size) {
     c[ImGuiCol_TextDisabled] = rgba(colors::kTextDisabled);
     c[ImGuiCol_WindowBg] = rgba(colors::kPanel);
     c[ImGuiCol_ChildBg] = ImVec4(0, 0, 0, 0);
-    c[ImGuiCol_PopupBg] = rgba(IM_COL32(38, 27, 19, 252));
-    c[ImGuiCol_ModalWindowDimBg] = rgba(IM_COL32(8, 5, 3, 150));
+    c[ImGuiCol_PopupBg] = rgba(IM_COL32(10, 26, 72, 240));
+    c[ImGuiCol_ModalWindowDimBg] = rgba(IM_COL32(2, 6, 20, 150));
     c[ImGuiCol_Border] = rgba(colors::kPanelEdge);
-    c[ImGuiCol_FrameBg] = rgba(IM_COL32(255, 240, 210, 20));
+    c[ImGuiCol_FrameBg] = rgba(IM_COL32(190, 220, 255, 20));
     c[ImGuiCol_FrameBgHovered] = rgba(colors::kRowHover);
     c[ImGuiCol_FrameBgActive] = rgba(colors::kRowFocus);
-    c[ImGuiCol_TextSelectedBg] = rgba(IM_COL32(217, 166, 75, 110));
+    c[ImGuiCol_TextSelectedBg] = rgba(IM_COL32(74, 170, 255, 110));
     c[ImGuiCol_ScrollbarBg] = ImVec4(0, 0, 0, 0);
-    c[ImGuiCol_ScrollbarGrab] = rgba(IM_COL32(143, 93, 36, 160));
-    c[ImGuiCol_ScrollbarGrabHovered] = rgba(IM_COL32(176, 122, 54, 200));
+    c[ImGuiCol_ScrollbarGrab] = rgba(IM_COL32(40, 100, 180, 160));
+    c[ImGuiCol_ScrollbarGrabHovered] = rgba(IM_COL32(60, 130, 210, 200));
     c[ImGuiCol_ScrollbarGrabActive] = rgba(colors::kAccent);
-    c[ImGuiCol_Separator] = rgba(IM_COL32(143, 93, 36, 120));
+    c[ImGuiCol_Separator] = rgba(IM_COL32(40, 100, 180, 120));
     // Rows draw their own focus; ImGui's rectangle would double it.
     c[ImGuiCol_NavCursor] = ImVec4(0, 0, 0, 0);
     return style;
@@ -279,7 +279,7 @@ void begin_panel(const char *id, const std::string &title, const std::string &su
     const ImVec2 line = ImGui::GetCursorScreenPos();
     const float line_width = ImGui::GetContentRegionAvail().x;
     draw->AddRectFilledMultiColor(line, {line.x + line_width, line.y + px(2.0f)}, colors::kAccent,
-                                  IM_COL32(143, 93, 36, 0), IM_COL32(143, 93, 36, 0), colors::kAccent);
+                                  IM_COL32(40, 100, 180, 0), IM_COL32(40, 100, 180, 0), colors::kAccent);
     ImGui::Dummy({0.0f, px(10.0f)});
 }
 
@@ -307,7 +307,7 @@ void begin_footer() {
     ImDrawList *draw = ImGui::GetWindowDrawList();
     const ImVec2 line = ImGui::GetCursorScreenPos();
     const float width = ImGui::GetContentRegionAvail().x;
-    draw->AddLine({line.x, line.y + px(4.0f)}, {line.x + width, line.y + px(4.0f)}, IM_COL32(143, 93, 36, 90),
+    draw->AddLine({line.x, line.y + px(4.0f)}, {line.x + width, line.y + px(4.0f)}, IM_COL32(40, 100, 180, 90),
                   px(1.0f));
     ImGui::Dummy({0.0f, px(10.0f)});
     // Two lines for the description, whatever it holds, so the hints stay put.
diff --git a/host/ui/widgets.hpp b/host/ui/widgets.hpp
index 8e16a27..6a16f80 100644
--- a/host/ui/widgets.hpp
+++ b/host/ui/widgets.hpp
@@ -12,20 +12,20 @@ namespace portablekit::ui {
 
 // Colours from the project's logo: dark brown, bronze and gold.
 namespace colors {
-inline constexpr ImU32 kBackdrop = IM_COL32(12, 8, 5, 170);
-inline constexpr ImU32 kPanel = IM_COL32(30, 21, 15, 246);
-inline constexpr ImU32 kPanelEdge = IM_COL32(143, 93, 36, 255);
-inline constexpr ImU32 kRow = IM_COL32(255, 240, 210, 10);
-inline constexpr ImU32 kRowHover = IM_COL32(233, 199, 122, 28);
-inline constexpr ImU32 kRowFocus = IM_COL32(217, 166, 75, 64);
-inline constexpr ImU32 kAccent = IM_COL32(217, 166, 75, 255);
-inline constexpr ImU32 kAccentBright = IM_COL32(251, 230, 166, 255);
-inline constexpr ImU32 kText = IM_COL32(246, 220, 174, 255);
-inline constexpr ImU32 kTextDim = IM_COL32(179, 154, 124, 255);
-inline constexpr ImU32 kTextDisabled = IM_COL32(120, 103, 86, 255);
+inline constexpr ImU32 kBackdrop = IM_COL32(3, 8, 24, 120);
+inline constexpr ImU32 kPanel = IM_COL32(8, 22, 66, 205);
+inline constexpr ImU32 kPanelEdge = IM_COL32(70, 140, 225, 255);
+inline constexpr ImU32 kRow = IM_COL32(190, 220, 255, 10);
+inline constexpr ImU32 kRowHover = IM_COL32(110, 170, 255, 34);
+inline constexpr ImU32 kRowFocus = IM_COL32(60, 130, 230, 92);
+inline constexpr ImU32 kAccent = IM_COL32(74, 170, 255, 255);
+inline constexpr ImU32 kAccentBright = IM_COL32(190, 226, 255, 255);
+inline constexpr ImU32 kText = IM_COL32(232, 242, 255, 255);
+inline constexpr ImU32 kTextDim = IM_COL32(150, 178, 216, 255);
+inline constexpr ImU32 kTextDisabled = IM_COL32(88, 108, 140, 255);
 inline constexpr ImU32 kDanger = IM_COL32(214, 102, 76, 255);
 inline constexpr ImU32 kGood = IM_COL32(150, 196, 120, 255);
-inline constexpr ImU32 kTrack = IM_COL32(255, 240, 210, 36);
+inline constexpr ImU32 kTrack = IM_COL32(190, 220, 255, 40);
 } // namespace colors
 
 // The system dialogs a game opens over itself (the message and save-data
-- 
