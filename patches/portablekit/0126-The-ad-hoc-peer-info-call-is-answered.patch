From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Thu, 19 Nov 2026 00:00:00 +0100
Subject: [PATCH] The ad hoc peer info call is answered

The game calls sceNetAdhocctlGetPeerInfo for the sender of every Hello it receives; it was an unimplemented stub, so the game never accepted the host and a second player could not join. It now returns the entry of the peer (or of this player), the same layout GetPeerList writes.
---

diff --git a/host/hle/hle_adhoc.cpp b/host/hle/hle_adhoc.cpp
index 0227fff..8cc6a17 100644
--- a/host/hle/hle_adhoc.cpp
+++ b/host/hle/hle_adhoc.cpp
@@ -491,6 +491,29 @@ void register_adhocctl(HleRegistrar &hle) {
         memory.store32(length_address, count * kPeerInfoSize);
         done(ctx, "sceNetAdhocctlGetPeerList", 2, 0u, std::to_string(count) + " peers");
     });
+    // sceNetAdhocctlGetPeerInfo(const mac *, int size, SceNetAdhocctlPeerInfo *): the entry of one peer in the group, or this player's own.
+    hle.add("sceNetAdhocctl", "sceNetAdhocctlGetPeerInfo", [](Runtime &rt, AllegrexContext &ctx) {
+        auto &memory = rt.memory();
+        pump_events();
+        if (!state().ctl_initialized) return done(ctx, "sceNetAdhocctlGetPeerInfo", 3, err::kCtlNotInitialized);
+        if (arg(ctx, 0) == 0u || arg(ctx, 2) == 0u || arg(ctx, 1) < kPeerInfoSize)
+            return done(ctx, "sceNetAdhocctlGetPeerInfo", 3, err::kCtlInvalidArg);
+        Mac mac{};
+        for (std::size_t i = 0; i < mac.size(); ++i) mac[i] = memory.load8(arg(ctx, 0) + static_cast<std::uint32_t>(i));
+        std::optional<std::string> name;
+        if (mac == own_mac()) name = nickname();
+        for (const auto &peer : Client::get().peers())
+            if (peer.mac == mac) name = peer.nickname;
+        if (!name) return done(ctx, "sceNetAdhocctlGetPeerInfo", 3, err::kCtlIdNotFound, adhoc::format_mac(mac));
+        const std::uint32_t entry = arg(ctx, 2);
+        memory.store32(entry, 0u);
+        write_cstring(memory, entry + 4u, *name, 128u);
+        write_mac(memory, entry + 132u, mac);
+        memory.store16(entry + 138u, 0u);
+        memory.store32(entry + 140u, 0u);
+        store64(memory, entry + 144u, kernel().now_us());
+        done(ctx, "sceNetAdhocctlGetPeerInfo", 3, 0u, adhoc::format_mac(mac) + " " + *name);
+    });
 }
 
 // sceNetAdhoc: PDP ---------------------------------------------------------------
