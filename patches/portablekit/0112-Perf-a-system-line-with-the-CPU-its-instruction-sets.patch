diff --git a/host/perf/frame_stats.cpp b/host/perf/frame_stats.cpp
index fa53a59..8dcf6d9 100644
--- a/host/perf/frame_stats.cpp
+++ b/host/perf/frame_stats.cpp
@@ -7,8 +7,21 @@
 #include "platform/android_performance.hpp"
 #endif
 
+// x86 CPU identification for log_system_info.
+#if defined(__x86_64__) || defined(_M_X64) || defined(__i386__) || defined(_M_IX86)
+#define PK_X86 1
+#if defined(_MSC_VER)
+#include <intrin.h>
+#else
+#include <cpuid.h>
+#endif
+#endif
+
 #include <algorithm>
 #include <array>
+#include <cstdint>
+#include <string>
+#include <thread>
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
@@ -559,6 +572,106 @@ const char *kind_name(PresentKind kind) {
 
 bool csv_enabled() noexcept { return csv().file != nullptr; }
 
+// ---- The machine, for a log read on someone else's computer. ----
+namespace {
+
+#if defined(PK_X86)
+void cpu_id(unsigned leaf, unsigned sub, unsigned (&regs)[4]) {
+#if defined(_MSC_VER)
+    int r[4];
+    __cpuidex(r, static_cast<int>(leaf), static_cast<int>(sub));
+    for (int i = 0; i < 4; ++i) regs[i] = static_cast<unsigned>(r[i]);
+#else
+    __cpuid_count(leaf, sub, regs[0], regs[1], regs[2], regs[3]);
+#endif
+}
+
+std::string cpu_brand() {
+    unsigned regs[4]{};
+    cpu_id(0x80000000u, 0u, regs);
+    if (regs[0] < 0x80000004u) return "unknown CPU";
+    char text[49]{};
+    for (unsigned i = 0; i < 3; ++i) {
+        cpu_id(0x80000002u + i, 0u, regs);
+        std::memcpy(text + i * 16u, regs, 16u);
+    }
+    std::string brand = text;
+    const std::size_t first = brand.find_first_not_of(' ');
+    return first == std::string::npos ? std::string("unknown CPU") : brand.substr(first);
+}
+
+std::string cpu_features() {
+    unsigned regs[4]{};
+    cpu_id(0u, 0u, regs);
+    const unsigned highest = regs[0];
+    std::string out;
+    const auto add = [&](bool on, const char *name) { out += std::string(out.empty() ? "" : " ") + (on ? "" : "no-") + name; };
+    cpu_id(1u, 0u, regs);
+    const bool osxsave = (regs[2] & (1u << 27)) != 0u;
+    add((regs[2] & (1u << 20)) != 0u, "SSE4.2");
+    // AVX and AVX2 need the operating system to save the wide registers too (XGETBV), not only the CPU to have them.
+    bool avx_usable = false;
+#if defined(_MSC_VER)
+    if (osxsave && (regs[2] & (1u << 28)) != 0u) avx_usable = (_xgetbv(0) & 6u) == 6u;
+#elif defined(__GNUC__)
+    if (osxsave && (regs[2] & (1u << 28)) != 0u) {
+        unsigned low = 0, high = 0;
+        __asm__ volatile("xgetbv" : "=a"(low), "=d"(high) : "c"(0));
+        avx_usable = (low & 6u) == 6u;
+    }
+#endif
+    add(avx_usable, "AVX");
+    add(avx_usable && (regs[2] & (1u << 12)) != 0u, "FMA");
+    bool avx2 = false, bmi2 = false;
+    if (highest >= 7u) {
+        unsigned seven[4]{};
+        cpu_id(7u, 0u, seven);
+        avx2 = avx_usable && (seven[1] & (1u << 5)) != 0u;
+        bmi2 = (seven[1] & (1u << 8)) != 0u;
+    }
+    add(avx2, "AVX2");
+    add(bmi2, "BMI2");
+    return out;
+}
+#endif
+
+std::uint64_t physical_memory_mib() {
+#if defined(_WIN32)
+    MEMORYSTATUSEX status{};
+    status.dwLength = sizeof(status);
+    return GlobalMemoryStatusEx(&status) ? static_cast<std::uint64_t>(status.ullTotalPhys >> 20u) : 0u;
+#elif defined(__linux__)
+    std::FILE *file = std::fopen("/proc/meminfo", "r");
+    if (file == nullptr) return 0u;
+    unsigned long long kib = 0;
+    char line[128];
+    while (std::fgets(line, sizeof(line), file) != nullptr)
+        if (std::sscanf(line, "MemTotal: %llu kB", &kib) == 1) break;
+    std::fclose(file);
+    return static_cast<std::uint64_t>(kib >> 10u);
+#else
+    return 0u;
+#endif
+}
+
+} // namespace
+
+void log_system_info() {
+    static bool printed = false;
+    if (printed) return;
+    printed = true;
+    std::string line = "[system] ";
+#if defined(PK_X86)
+    line += cpu_brand() + "; " + cpu_features();
+#else
+    line += "non-x86 CPU";
+#endif
+    line += "; " + std::to_string(std::thread::hardware_concurrency()) + " logical cores";
+    if (const std::uint64_t mib = physical_memory_mib(); mib != 0u) line += "; " + std::to_string(mib) + " MiB RAM";
+    std::cout << line << std::endl;
+}
+
+
 void note_present(PresentKind kind, float t, std::uint32_t skipped, double late_ms) noexcept {
     const Guard guard(stats_mutex());
     Csv &c = csv();
diff --git a/host/perf/frame_stats.hpp b/host/perf/frame_stats.hpp
index 8b22aef..66bd012 100644
--- a/host/perf/frame_stats.hpp
+++ b/host/perf/frame_stats.hpp
@@ -35,6 +35,10 @@ struct Options {
 // those, and only those, from it.
 void add_render_time(Clock::duration duration);
 
+// One log line about the machine: CPU model and the instruction sets that matter to this build (SSE4.2, AVX, AVX2, FMA, BMI2),
+// logical cores and RAM. A report from a slow computer is hard to read without it. Printed once, whatever the performance setting.
+void log_system_info();
+
 // Where the render thread stops, for <prefix>_TRACE_STALLS. The waits count
 // towards "wait"; the copies are CPU work inside "render" that reads memory
 // the GPU wrote, which can be slow when that memory is not cached.
