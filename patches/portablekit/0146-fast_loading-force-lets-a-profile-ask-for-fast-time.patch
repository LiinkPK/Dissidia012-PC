From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 <d012@localhost>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH] fast_loading: force() lets a profile ask for fast time

A profile can run emulated time fast for a screen the player skips; the audio is dropped as in a load, and a session or the menu ends it.
---
diff --git a/host/kernel/fast_loading.cpp b/host/kernel/fast_loading.cpp
index fa659a6..128c927 100644
--- a/host/kernel/fast_loading.cpp
+++ b/host/kernel/fast_loading.cpp
@@ -20,6 +20,7 @@ using Clock = std::chrono::steady_clock;
 
 struct State {
     Detector detector;
+    bool forced{};
     bool buttons_held{};
     // The episode running fast now: when it started, in both clocks.
     Clock::time_point real_start{};
@@ -78,6 +79,8 @@ void end_episode(Reason reason) {
 void note_disc_read() { state().detector.disc_read(kernel().now_us()); }
 
 bool note_audio(int peak) {
+    // Forced fast time: the sound the game makes is dropped, not played sixteen times too fast.
+    if (state().forced && sample_guards().enabled) return true;
     Detector &detector = state().detector;
     const bool was_fast = detector.fast();
     const bool drop = detector.audio(kernel().now_us(), peak);
@@ -90,11 +93,22 @@ void note_buttons(bool held) { state().buttons_held = held; }
 void update() {
     Detector &detector = state().detector;
     const bool was_fast = detector.fast();
-    const bool fast = detector.update(kernel().now_us(), sample_guards());
+    const Guards guards = sample_guards();
+    // A forced stretch ends if the menu opens or a session starts.
+    if (state().forced && (!guards.enabled || guards.online || guards.menu)) state().forced = false;
+    const bool fast = detector.update(kernel().now_us(), guards);
     if (fast && !was_fast) begin_episode();
     else if (!fast && was_fast) end_episode(detector.reason());
 }
 
-bool active() { return state().detector.fast(); }
+bool active() { return state().detector.fast() || state().forced; }
+
+void force(bool on) {
+    if (on) {
+        const Guards guards = sample_guards();
+        if (!guards.enabled || guards.online || guards.menu) on = false;
+    }
+    state().forced = on;
+}
 
 } // namespace portablekit::fast_loading
diff --git a/host/kernel/fast_loading.hpp b/host/kernel/fast_loading.hpp
index 7b1dbad..13f3831 100644
--- a/host/kernel/fast_loading.hpp
+++ b/host/kernel/fast_loading.hpp
@@ -87,5 +87,9 @@ void note_buttons(bool held);
 void update();
 // Whether emulated time runs ahead of real time at the moment.
 [[nodiscard]] bool active();
+// A profile's own request for fast time (a screen the player skips, say): on, time runs ahead as in a load, and the audio
+// handed to the game's sound is dropped as in one. Never while an ad hoc session or the menu needs real time, or when
+// fast loading is off in the settings. Call it from the emulation thread; off again as soon as the screen is over.
+void force(bool on);
 
 } // namespace portablekit::fast_loading
-- 
