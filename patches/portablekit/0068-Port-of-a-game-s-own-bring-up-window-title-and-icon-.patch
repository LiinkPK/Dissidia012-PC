diff --git a/host/profile.hpp b/host/profile.hpp
index ddcf7eb..7e9f848 100644
--- a/host/profile.hpp
+++ b/host/profile.hpp
@@ -246,6 +246,23 @@ struct GameProfile {
     // Called once the executable is in memory and before it runs, for the
     // per-game patches that have no better home. Null means there are none.
     void (*patch_loaded_image)(psprecomp::Runtime &, const psprecomp::Elf32Image &) = nullptr;
+    // Called whenever the guest flushes the instruction cache, which is how it
+    // announces code it has just copied into memory. Null means no reaction.
+    void (*on_code_flushed)(psprecomp::Runtime &) = nullptr;
+
+    // --- Window --------------------------------------------------------------
+    // Title shown on the window; null uses app_name.
+    const char *window_title = nullptr;
+    // A PNG (any size, square is best) embedded in the program and used as the window icon.
+    const unsigned char *window_icon_png = nullptr;
+    std::size_t window_icon_png_size = 0;
+
+    // --- Renderer ------------------------------------------------------------
+    // The game draws one frame's layers into both of its display buffers (one pass keeps the
+    // buffer it was first given while the others follow the flip), so only half of each frame's
+    // layers reach the screen. With this set, a frame's draws into either display buffer, and
