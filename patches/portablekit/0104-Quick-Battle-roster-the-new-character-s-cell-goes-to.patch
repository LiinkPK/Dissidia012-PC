From cd6e100356b7a8ec7175b0b7586c425d1db9c3cd Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Tue, 17 Nov 2026 15:05:33 +0100
Subject: [PATCH] Quick Battle roster: the new character's cell goes to the
 17th place of the first row

---
 host/gpu/vulkan_renderer.cpp | 37 ++++++++++++++++++------------------
 1 file changed, 18 insertions(+), 19 deletions(-)

diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index 5fc194d..5fe1739 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -76,6 +76,7 @@
 // game's own top-left position of each grid cell, in position order.
 float g_d012_roster_cells[40][2];
 int g_d012_roster_count = 0;
+int g_d012_roster_extra_rank = -1;  // draw number of the roster cell that goes to the 17th place of the first row, or -1 (set by the profile)
 
 namespace portablekit::gpu {
 std::atomic<float> g_d012_model_scale{1.0f};  // the replayed 3D model's size about the screen centre,
@@ -87,25 +88,23 @@ std::atomic<bool> g_d012_defer_3d{false};      // set by the profile while the s
 // so they never end up in the source tree root.
 static bool g_text_trace_active = false;  // true while the two traced frames are being drawn
 
-// The Quick Battle roster's new grid is two rows of 17: the game's slot of a cell (it draws slot s at rows of 6, 10, 10 and 6
-// cells: y = 113, 152, 191, 230 at x = 92, 28, 28, 92 + 32 n) decides where the cell goes, not the order the cells are drawn in.
-// Slot 16, empty in the game's own roster, is the 17th cell of the top row (the new character's place). Cells whose position is
-// not on that geometry keep their draw rank.
-static void roster_grid_cell(float game_x, float game_y, int rank, int &row, int &col) {
-    static const int first_slot[4] = {0, 6, 16, 26};
-    static const float first_x[4] = {92.0f, 28.0f, 28.0f, 92.0f};
-    static const float first_y[4] = {113.0f, 152.0f, 191.0f, 230.0f};
-    int slot = rank;
-    for (int line = 0; line < 4; ++line) {
-        if (std::fabs(game_y - first_y[line]) < 1.0f) {
-            const float n = (game_x - first_x[line]) / 32.0f;
-            const int index = static_cast<int>(n + 0.5f);
-            if (index >= 0 && std::fabs(n - static_cast<float>(index)) < 0.05f) slot = first_slot[line] + index;
-            break;
+// The Quick Battle roster: cell number p (in the order the game draws them) sits at column p of the first row up to 15, then in the
+// second row. With the Emendatus mod's new character the game draws her cell after the 31 fighters and before Random; the profile
+// sets g_d012_roster_extra_rank to her draw number and she goes to the 17th cell of the first row, right of Lightning, which is
+// where the game's own navigation puts her. The cells drawn after her move up one place.
+static void roster_grid_cell(int rank, int &row, int &col) {
+    const int extra = g_d012_roster_extra_rank;
+    int p = rank;
+    if (extra >= 0) {
+        if (rank == extra) {
+            row = 0;
+            col = 16;
+            return;
         }
+        if (rank > extra) p = rank - 1;
     }
-    row = slot < 17 ? 0 : 1;
-    col = slot - 17 * row;
+    row = p < 16 ? 0 : 1;
+    col = p - 16 * row;
 }
 static std::string debug_log_path(const char *name) {
     std::error_code ignored;
@@ -9134,7 +9133,7 @@ void VulkanRenderer::submit(const DrawCall &call, const GuestMemory &memory) {
                         if (best >= 0) {
                             const float ox = impl.roster_drawn[best][0], oy = impl.roster_drawn[best][1];
                             int row = 0, col = 0;
-                            roster_grid_cell(ox, oy, best, row, col);
+                            roster_grid_cell(best, row, col);
                             const float nx = 28.0f + 32.0f * static_cast<float>(col);
                             const float ny = 113.0f + 39.0f * static_cast<float>(row);
                             const float tile_x = 7.0f + (nx - 28.0f) * 0.65f, tile_y = 203.0f + (ny - 113.0f) * 0.65f;
@@ -9211,7 +9210,7 @@ void VulkanRenderer::submit(const DrawCall &call, const GuestMemory &memory) {
                             impl.roster_drawn_frame[impl.roster_p] = impl.frames;
                         }
                         int row = 0, col = 0;
-                        roster_grid_cell(impl.roster_origin_x, impl.roster_origin_y, impl.roster_p, row, col);
+                        roster_grid_cell(impl.roster_p, row, col);
                         const float nx = 28.0f + 32.0f * static_cast<float>(col);
                         const float ny = 113.0f + 39.0f * static_cast<float>(row);
                         for (std::size_t i = first; i < first + group; ++i) {
-- 
