From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: d012 setup <setup@localhost>
Date: Wed, 18 Nov 2026 13:00:00 +0100
Subject: [PATCH] Ad hoc: editions of a game never play each other

A profile can name editions that change the game data (the Emendatus Mod). While the edition is active, the first character of the
product code the game logs in with is replaced by the edition mark, so its players are another product to every ad hoc server and
only meet players of the same edition. The Join list leaves hosts of the other edition out and says how many.
---
diff --git a/host/profile.hpp b/host/profile.hpp
index b89696d..1e265ee 100644
--- a/host/profile.hpp
+++ b/host/profile.hpp
@@ -234,6 +234,12 @@ struct GameProfile {
     // agree on it, so it is the original release's code even when the port's
     // disc id is a different one.
     const char *adhoc_product_code;
+    // Editions of one game that must not play each other (a mod that changes the game's data). While `adhoc_edition_active()` is
+    // true, the first character of the product code the game logs in with is replaced by `adhoc_edition_mark`, so those players are
+    // another product to every ad hoc server, this port's own or any other, and only meet players of the same edition. The Join list
+    // leaves hosts of the other edition out. Both unset: no editions.
+    char adhoc_edition_mark = 0;
+    bool (*adhoc_edition_active)() = nullptr;
 
     // --- Controls ----------------------------------------------------------
     // What the triggers may press instead of L and R, for the way this game is
diff --git a/host/adhoc/session.hpp b/host/adhoc/session.hpp
index c41a0b1..f503b1c 100644
--- a/host/adhoc/session.hpp
+++ b/host/adhoc/session.hpp
@@ -18,6 +18,12 @@ void adhoc_apply_settings(bool switch_now = false);
 // pausing it then would stop it answering the other players.
 [[nodiscard]] bool adhoc_session_active();
 
+// The product code a player logs in with: the game's, with the profile's edition mark (see GameProfile::adhoc_edition_mark) when
+// the running edition has one. Players of different editions are different products to a server, so they never meet.
+[[nodiscard]] std::string adhoc_effective_product(std::string product);
+// True when a host's or player's product code is of the edition this instance runs.
+[[nodiscard]] bool adhoc_same_edition(const std::string &product);
+
 // The name other players see: the nickname setting, or the player name.
 [[nodiscard]] std::string adhoc_player_name();
 
diff --git a/host/hle/hle_adhoc.cpp b/host/hle/hle_adhoc.cpp
index fcc7fc2..0f345ca 100644
--- a/host/hle/hle_adhoc.cpp
+++ b/host/hle/hle_adhoc.cpp
@@ -242,7 +243,7 @@ void start_client() {
     identity.server = s.adhoc ? adhoc_server_address() : std::string{};
     identity.nickname = nickname();
     identity.mac = own_mac();
-    identity.product = state().product;
+    identity.product = adhoc_effective_product(state().product);
     Client::get().start(identity);
 }
 
@@ -974,11 +975,30 @@ std::string adhoc_player_name() { return nickname(); }
 
 bool adhoc_networking_on() { return state().ctl_initialized || state().adhoc_initialized; }
 
+std::string adhoc_effective_product(std::string product) {
+    const GameProfile &profile = game();
+    if (profile.adhoc_edition_mark != 0 && profile.adhoc_edition_active != nullptr && profile.adhoc_edition_active() &&
+        !product.empty())
+        product[0] = profile.adhoc_edition_mark;
+    return product;
+}
+
+bool adhoc_same_edition(const std::string &product) {
+    const GameProfile &profile = game();
+    if (profile.adhoc_edition_mark == 0) return true;
+    const bool theirs = !product.empty() && product[0] == profile.adhoc_edition_mark;
+    const bool ours = profile.adhoc_edition_active != nullptr && profile.adhoc_edition_active();
+    return theirs == ours;
+}
+
 bool adhoc_session_active() {
     const adhoc::Diagnostics d = Client::get().diagnostics();
     return adhoc_hosting() || Client::get().in_group() || d.joining.has_value() || d.rejoin_ms.has_value();
 }
 
+// This machine's virtual MAC, for sceNetAdhocMatching (hle_adhoc_matching.cpp).
+adhoc::Mac adhoc_own_mac() { return own_mac(); }
+
 void register_adhoc(HleRegistrar &hle) {
     register_net(hle);
     register_adhocctl(hle);
diff --git a/host/adhoc/host.cpp b/host/adhoc/host.cpp
index 5edd4b4..4124933 100644
--- a/host/adhoc/host.cpp
+++ b/host/adhoc/host.cpp
@@ -69,7 +70,7 @@ bool adhoc_host_start() {
         adhoc::Discovery::get().start_announcing(config.adhocctl_port, [server] {
             adhoc::Announcement info;
             info.name = adhoc_player_name();
-            info.product = portablekit::game().adhoc_product_code;
+            info.product = portablekit::adhoc_effective_product(portablekit::game().adhoc_product_code);
             info.players = static_cast<unsigned>(server->status().players.size());
             return info;
         });
diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index 4c381fe..514533b 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -1465,7 +1519,13 @@ void play_together() {
     adhoc::Discovery &discovery = adhoc::Discovery::get();
     discovery.start_listening();
     discovery.query(s.adhoc_recent);
-    const std::vector<adhoc::FoundHost> hosts = discovery.hosts();
+    // Hosts of the other edition (the Emendatus Mod on or off) are left out: the two never play each other.
+    std::vector<adhoc::FoundHost> hosts;
+    std::size_t other_edition = 0;
+    for (const adhoc::FoundHost &found : discovery.hosts()) {
+        if (adhoc_same_edition(found.info.product)) hosts.push_back(found);
+        else ++other_edition;
+    }
     const bool hosting = adhoc_hosting();
     const auto joined = [&](const std::string &address) {
         return !hosting && s.adhoc && s.adhoc_server == address;
@@ -1479,6 +1539,9 @@ void play_together() {
             adhoc_join(address);
     }
     if (hosts.empty()) info_row("On this network", "Looking for hosted sessions…");
+    if (other_edition != 0u)
+        info_row("Not listed", std::to_string(other_edition) + (other_edition == 1u ? " session" : " sessions") +
+                                   " of the other edition: the Emendatus Mod and the stock game never play each other");
     if (text_row("join_address", "Address", typed_address, 100u, true, address_character,
                  {false, {},
                   "The host's address, for a VPN without broadcast such as Tailscale: the host's screen lists it. "
-- 
