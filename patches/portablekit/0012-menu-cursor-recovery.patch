From b2c7c6487fd90ca73b26ba0c0859f2012fccddfb Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 26 Nov 2026 13:37:12 +0100
Subject: [PATCH] Menu: the cursor goes back to the last row whenever no row
 has it (a stale nav id no longer blocks it)

---
 host/ui/widgets.cpp | 1 -
 1 file changed, 1 deletion(-)

diff --git a/host/ui/widgets.cpp b/host/ui/widgets.cpp
index fe24f33..4372696 100644
--- a/host/ui/widgets.cpp
+++ b/host/ui/widgets.cpp
@@ -459,7 +459,6 @@ void begin_footer() {
     // The cursor must not stay lost: after Esc or a click on the empty space ImGui clears the focused row, and the hand would vanish with
     // the arrow keys doing nothing. When no row has it, it goes back to the last row (or to the first one, if that row is gone).
     if (game_menu && ImGui::GetFrameCount() - row_focus_frame > 0 && row_last_focused != 0 && !ImGui::GetIO().WantTextInput &&
-        ImGui::GetCurrentContext()->NavId == 0 &&  // only when nothing has the cursor: a text box or another widget keeps it, and the arrows move on from it
         !ImGui::IsPopupOpen("", ImGuiPopupFlags_AnyPopupId | ImGuiPopupFlags_AnyPopupLevel)) {
         if (++rows_unfocused_frames > 20) {
             focus_next = true;
-- 
