+
+bool TexturePack::ui_image(const std::string &name, std::vector<std::uint8_t> &rgba, std::uint32_t &width, std::uint32_t &height) const {
+    const std::vector<std::uint8_t> png = ui_file(name);
+    if (png.empty()) return false;
+    int w = 0, h = 0, channels = 0;
+    stbi_uc *pixels = stbi_load_from_memory(png.data(), static_cast<int>(png.size()), &w, &h, &channels, 4);
+    if (pixels == nullptr) return false;
+    if (w <= 0 || h <= 0 || w > kMaxImageSide || h > kMaxImageSide) {
+        stbi_image_free(pixels);
+        return false;
+    }
+    rgba.assign(pixels, pixels + static_cast<std::size_t>(w) * static_cast<std::size_t>(h) * 4u);
+    stbi_image_free(pixels);
+    width = static_cast<std::uint32_t>(w);
+    height = static_cast<std::uint32_t>(h);
+    return true;
+}
