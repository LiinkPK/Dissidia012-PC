diff --git a/host/ui/ui_sound.cpp b/host/ui/ui_sound.cpp
new file mode 100644
index 0000000..275de96
--- /dev/null
+++ b/host/ui/ui_sound.cpp
@@ -0,0 +1,85 @@
+#include "ui/ui_sound.hpp"
+
+#include <SDL3/SDL.h>
+
+#include <array>
+#include <cstdint>
+#include <iostream>
+#include <utility>
+#include <vector>
+
+namespace portablekit::ui::sound {
+namespace {
+
+struct Clip {
+    std::vector<std::uint8_t> data;
+    SDL_AudioSpec spec{};
+    SDL_AudioStream *stream = nullptr;  // opened on the first play, in the clip's own format
+    std::uint64_t last_played = 0;
+};
+
+std::array<Clip, 5> &clips() {
+    static std::array<Clip, 5> list;
+    return list;
+}
+
+bool (*g_enabled)() = nullptr;
+
+Clip &clip(Cue cue) { return clips()[static_cast<std::size_t>(cue)]; }
+
+} // namespace
+
+bool set(Cue cue, const std::filesystem::path &file) {
+    Clip &c = clip(cue);
+    if (c.stream != nullptr) {
+        SDL_DestroyAudioStream(c.stream);
+        c.stream = nullptr;
+    }
+    c.data.clear();
+    SDL_AudioSpec spec{};
+    std::uint8_t *buffer = nullptr;
+    std::uint32_t length = 0;
+    if (!SDL_LoadWAV(file.string().c_str(), &spec, &buffer, &length)) return false;
+    c.data.assign(buffer, buffer + length);
+    SDL_free(buffer);
+    c.spec = spec;
+    return !c.data.empty();
+}
+
+void load_folder(const std::filesystem::path &folder) {
+    std::error_code ec;
+    const std::filesystem::path navigate = folder / "navigate.wav", back = folder / "back.wav";
+    if (std::filesystem::exists(navigate, ec) && set(Cue::Navigate, navigate)) std::cout << "[ui] menu sound: " << navigate.string() << "\n";
+    if (std::filesystem::exists(back, ec) && set(Cue::Back, back)) std::cout << "[ui] menu sound: " << back.string() << "\n";
+    const std::filesystem::path confirm = folder / "confirm.wav";
+    if (std::filesystem::exists(confirm, ec) && set(Cue::Confirm, confirm)) std::cout << "[ui] menu sound: " << confirm.string() << std::endl;
+    const std::filesystem::path on = folder / "toggle_on.wav", off = folder / "toggle_off.wav";
+    if (std::filesystem::exists(on, ec) && set(Cue::ToggleOn, on)) std::cout << "[ui] menu sound: " << on.string() << "\n";
+    if (std::filesystem::exists(off, ec) && set(Cue::ToggleOff, off)) std::cout << "[ui] menu sound: " << off.string() << "\n";
+    if (clip(Cue::ToggleOff).data.empty() && !clip(Cue::Back).data.empty()) {  // no file of its own: the back sound
+        clip(Cue::ToggleOff).data = clip(Cue::Back).data;
+        clip(Cue::ToggleOff).spec = clip(Cue::Back).spec;
+    }
+}
+
+void set_enabled_source(bool (*enabled)()) { g_enabled = enabled; }
+
+void play(Cue cue) {
+    Clip &c = clip(cue);
+    if (c.data.empty() || (g_enabled != nullptr && !g_enabled())) return;
+    const std::uint64_t now = SDL_GetTicks();
+    if (now - c.last_played < 120u) return;
+    c.last_played = now;
+    if (c.stream == nullptr) {
+        c.stream = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &c.spec, nullptr, nullptr);
+        if (c.stream == nullptr) {
+            c.data.clear();  // no output: stay silent rather than try on every move
+            return;
+        }
+        SDL_ResumeAudioStreamDevice(c.stream);
+    }
+    SDL_ClearAudioStream(c.stream);
+    SDL_PutAudioStreamData(c.stream, c.data.data(), static_cast<int>(c.data.size()));
+}
+
+} // namespace portablekit::ui::sound
diff --git a/host/ui/ui_sound.hpp b/host/ui/ui_sound.hpp
new file mode 100644
index 0000000..5dbe0f0
--- /dev/null
+++ b/host/ui/ui_sound.hpp
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <filesystem>
+
+// The menu's own sounds: a short click when the cursor moves to another row, another when the menu is closed or a screen is left, and one each for a switch turned on and off.
+// Each is a WAV file kept in a folder beside the game's data (the port ships none: with no file, a cue is silent). They play on a stream
+// of their own on the default output, over the game's audio.
+namespace portablekit::ui::sound {
+
+enum class Cue { Navigate, Back, ToggleOn, ToggleOff, Confirm };
+
+// Reads `file` for `cue`; false when it cannot be read as a WAV (the cue stays silent).
+bool set(Cue cue, const std::filesystem::path &file);
+// Reads navigate.wav, back.wav, toggle_on.wav, toggle_off.wav and confirm.wav from `folder`, each if it is there (toggle_off falls back to back).
+// `enabled` (the settings' "menu sounds"), when given, is asked before every cue: false keeps them all silent.
+void set_enabled_source(bool (*enabled)());
+void load_folder(const std::filesystem::path &folder);
+// Plays the cue from its start. The same cue twice within 120 ms plays once, so one action asking from two places is heard once.
+void play(Cue cue);
+
+} // namespace portablekit::ui::sound
