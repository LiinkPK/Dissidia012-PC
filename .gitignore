# --- Build output --------------------------------------------------------------------------------------------------
/out/
/build/
/dist/
cmake-build-*/
b*_perf/
CMakeUserPresets.json

# Compiled files, wherever they land
*.exe
*.dll
*.lib
*.obj
*.exp
*.iobj
*.ipdb
*.res
*.tlog
*.pdb
*.ilk
*.so
*.so.*
*.dylib
*.pyc
__pycache__/

# --- The user's own game data: never published ---------------------------------------------------------------------
PSP_DATA/
SAVEDATA/
*.ELF
*.elf
*.iso
*.cso
*.bin
/original/
/profiles/*/game/
/profiles/*/analysis/
/profiles/*/progress/
/profiles/*/captures/
/tools/textures/*

# --- Local work files, logs and editor settings --------------------------------------------------------------------
*.log
*.tmp
*.generated
*.psd
.venv/
pyvenv.cfg
*.py
!/tools/mods/**/*.py
.vs/
.vscode/
.idea/
*.user
*.suo
.aider*
.claude*
.continue*
PROGRESS.json
reasoning_trace.json
discord.md
Roadmap.*
# Debug output (F10 traces, triggers, terminal captures) goes in logs/; these patterns catch strays at any level.
/logs/
logs/
*_trigger
*_trace.txt
*_quads.txt
text_trace*
live.txt
crash_report.txt
*.dmp
*.stackdump

# --- Dependencies fetched at setup, never stored here --------------------------------------------------------------
# PortableKit (TeamGDB, MIT) is cloned and patched by scripts/setup_portablekit.ps1 / .sh; only the patches live in
# patches/portablekit/.
/third_party/PortableKit-d012/

# The upstream port (VCKing101/Dissidia012-pc, MIT): only what the build uses is kept (port/host, port/decomp, port/config,
# the PortableKit patches, and its licence and notices); its docs, tools, BGM maker, examples and tests are not shipped here.
/third_party/dissidia012-pc/docs/
/third_party/dissidia012-pc/tools/
/third_party/dissidia012-pc/setup.*
/third_party/dissidia012-pc/requirements-*.txt
/third_party/dissidia012-pc/CONTRIBUTING.md
/third_party/dissidia012-pc/port/bgm_maker/
/third_party/dissidia012-pc/port/examples/
/third_party/dissidia012-pc/port/tests/
/third_party/dissidia012-pc/port/tools/
